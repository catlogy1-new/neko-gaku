{
  "name": "astro-navfolio",
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "fonts:ui": "bun scripts/fonts/subset-ui-font.ts",
    "build": "tinacms build && bun run fonts:ui && astro build && pagefind --site dist --output-subdir pagefind --root-selector main --exclude-selectors \"[data-pagefind-ignore]\"",
    "preview": "astro preview",
    "docs:dev": "NAVFOLIO_CONTENT_SOURCE=docs astro dev",
    "docs:build": "NAVFOLIO_CONTENT_SOURCE=docs bun run build",
    "docs:preview": "NAVFOLIO_CONTENT_SOURCE=docs astro preview",
    "docs:sync": "git submodule update --init --recursive",
    "astro": "astro",
    "content:new": "bun scripts/new-content.ts",
    "post:new": "bun scripts/new-content.ts post",
    "project:new": "bun scripts/new-content.ts project",
    "vibe:new": "bun scripts/new-content.ts vibe",
    "media:new": "bun scripts/new-content.ts media",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "bun run lint && prettier --check --ignore-unknown .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/node": "^11.1.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-collapsible-sections": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/biz-udpmincho": "^5.2.7",
    "@fontsource/maple-mono": "^5.3.0",
    "@navfolio/core": "github:navfolio/core",
    "@navfolio/mdx-components": "github:navfolio/mdx-components",
    "@navfolio/pages": "github:navfolio/pages",
    "@navfolio/plugin-markdown": "github:navfolio/plugin-markdown",
    "@navfolio/theme-default": "github:navfolio/theme-default",
    "@tailwindcss/vite": "^4.3.3",
    "@tinacms/astro": "^0.7.1",
    "astro": "^7.3.6",
    "astro-expressive-code": "^0.44.2",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.0",
    "lucide-astro": "^0.556.0",
    "mermaid": "^12.1.0",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.0",
    "tailwindcss": "^4.3.3",
    "tinacms": "^3.14.2"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@tinacms/cli": "^4.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "bun run format:check"
  }
}