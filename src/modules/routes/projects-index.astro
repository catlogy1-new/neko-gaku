---
import { getCollection, render } from 'astro:content';
import {
  Box,
  Code2,
  Database,
  ExternalLink,
  FileCode2,
  Github,
  Globe2,
  Layers3,
  Palette,
  Rocket,
  Sparkles,
  Terminal,
  WandSparkles,
} from 'lucide-astro';

import FormattedDate from '../../components/FormattedDate.astro';
import PortfolioGallery from '../../components/tina/PortfolioGallery.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Footer from '../../components/Footer.astro';
import BlogArticle from '../../layouts/BlogArticle.astro';
import { getSiteConfig } from '../../data/site';
import navfolioConfig from '../../../navfolio.config';
import { getPageModuleRoute } from '../../plugins/config';
import { sortBlogPostsForArchive } from '../../utils/content-dates';
import { getI18n } from '../../utils/ui-text';

const siteConfig = await getSiteConfig();
const { pages } = siteConfig;

const pageMeta = pages.projects;

const projectEntries = await getCollection('projects');

const projectIndex = projectEntries.find(
  (entry) => entry.id === 'index',
);

const projects = sortBlogPostsForArchive(
  projectEntries.filter(
    (entry) => entry.id !== 'index' && entry.id.toLowerCase() !== 'photography' && !entry.data.draft,
  ),
);

if (!projectIndex) {
  throw new Error(
    'Missing src/content/projects/index.mdx content entry.',
  );
}

const { Content, headings } = await render(projectIndex);

const projectIndexPage = {
  ...projectIndex,

  data: {
    ...projectIndex.data,

    title: 'REMAINS',
    description: `Residues of images and signs, left behind by
something we once agreed to call reality.`,
  },
};

const relatedProjects = projects;

const projectsRoute = getPageModuleRoute(
  navfolioConfig,
  'projects',
);

const i18n = getI18n(siteConfig);

const projectIcons = {
  github: Github,
  box: Box,
  'code-2': Code2,
  database: Database,
  'file-code-2': FileCode2,
  'globe-2': Globe2,
  'layers-3': Layers3,
  palette: Palette,
  rocket: Rocket,
  sparkles: Sparkles,
  terminal: Terminal,
  'wand-sparkles': WandSparkles,
};

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(href: string) {
  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}
const photographyProject = projectEntries.find(
  (project) => project.id.toLowerCase() === 'photography',
);

const photographyData = photographyProject?.data as
  | Record<string, unknown>
  | undefined;

---

<BlogArticle
  post={projectIndexPage}
  headings={headings}
  sidebar={{ enable: false, ...projectIndex.data.sidebar }}
  headerVariant="archive"
  headerKicker="PORTFOLIO / PROJECTS"
  headerNote=""
  contentFont="ui"
>
  <Content />

  <!-- =====================================================
       PORTFOLIO
       ===================================================== -->

  <TinaIsland
    name="portfolio-gallery"
    wrapper={{ tag: 'div' }}
    primary
  >
    <PortfolioGallery data={photographyData} />
  </TinaIsland>




<!-- =====================================================
       PROJECT INDEX
       ===================================================== -->

  <section
    class="project-index-section"
    aria-labelledby="project-index-title"
  >

    <header class="project-index-header">

      <div>

        <div class="project-index-kicker">
          <span aria-hidden="true"></span>
          SYSTEM / INDEX
        </div>

        <h2 id="project-index-title">
          PROJECT INDEX
        </h2>

        <p>
          Research / Systems / Experiments
        </p>

      </div>

      <span class="project-index-count">
        {String(relatedProjects.length).padStart(2, '0')} RECORDS
      </span>

    </header>


    {
      relatedProjects.length > 0 ? (

        <div
          class="project-grid"
          aria-label={i18n.t('projects.listLabel')}
        >

          {relatedProjects.map((project, index) => {

            const ProjectIcon =
              projectIcons[project.data.icon] ?? Github;

            const projectHref = withBase(
              `${projectsRoute}/${project.id}/`,
            );

            return (

              <article
                class="project-card"
                style={
                  project.data.iconColor
                    ? `--project-icon-color: ${project.data.iconColor}`
                    : undefined
                }
              >

                <span class="project-sequence">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <div class="project-card-body">

                  <div class="project-card-heading">

                    <ProjectIcon
                      class="project-icon"
                      size={18}
                      strokeWidth={1.55}
                      aria-hidden="true"
                    />

                    <h3>
                      <a href={projectHref}>
                        {project.data.title}
                      </a>
                    </h3>

                  </div>

                  <p>
                    {project.data.description}
                  </p>

                </div>


                <footer class="project-card-footer">

                  <span class="project-meta">
                    <FormattedDate date={project.data.date} />
                  </span>


                  {project.data.authors.length > 0 && (

                    <span
                      class="project-authors"
                      aria-label={i18n.t('projects.authorsLabel')}
                    >

                      {project.data.authors.map((author) =>
                        author.url ? (

                          <a href={author.url}>
                            {author.name}
                          </a>

                        ) : (

                          <span>
                            {author.name}
                          </span>

                        ),
                      )}

                    </span>

                  )}


                  {project.data.links.length > 0 && (

                    <span
                      class="project-links"
                      aria-label={i18n.t('projects.linksLabel')}
                    >

                      {project.data.links.map((link) => (

                        <a
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >

                          {link.kind === 'github' ? (

                            <Github
                              size={13}
                              strokeWidth={1.8}
                              aria-hidden="true"
                            />

                          ) : (

                            <ExternalLink
                              size={13}
                              strokeWidth={1.8}
                              aria-hidden="true"
                            />

                          )}

                          {link.label}

                        </a>

                      ))}

                    </span>

                  )}


                  {project.data.tags.length > 0 && (

                    <span
                      class="project-tags"
                      aria-label={i18n.t('projects.tagsLabel')}
                    >

                      {project.data.tags
                        .slice(0, 3)
                        .map((tag) => (

                          <small>
                            {tag}
                          </small>

                        ))}

                    </span>

                  )}

                </footer>

              </article>

            );

          })}

        </div>

      ) : (

        <div
          class="project-empty"
          aria-label={i18n.t('projects.emptyLabel')}
        >

          <span class="empty-index" aria-hidden="true">
            00
          </span>

          <div>

            <h3>
              {i18n.t('projects.emptyTitle')}
            </h3>

            <p>
              {i18n.t('projects.emptyNote')}
            </p>

          </div>

          <span class="empty-status">
            鬮ｫ・ｨ繝ｻ・ｳ驛｢譎｢・ｽ・ｻSTANDBY
          </span>

        </div>

      )
    }

  </section>

</BlogArticle>


<!-- ========================================================
     REMAINS IMAGE LIGHTBOX
     ======================================================== -->

<div
  class="remains-lightbox"
  id="remains-lightbox"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
>
  <button
    class="remains-lightbox-close"
    type="button"
    aria-label="Close image"
  >&#10005;</button>

  <div class="remains-lightbox-stage">

    <img
      class="remains-lightbox-image"
      src=""
      alt=""
      role="button"
      tabindex="0"
      aria-label="Toggle image enlargement"
      aria-pressed="false"
    />

    <div class="remains-lightbox-info">

      <span class="remains-lightbox-label">
        REMAINS / IMAGE
      </span>

      <span class="remains-lightbox-title"></span>

    </div>

  </div>
</div>


<script is:inline data-astro-rerun>
  (() => {

    /*
     * REMAINS LIGHTBOX
     *
     * Event delegation is used deliberately.
     * This keeps the lightbox working both after
     * a hard browser reload and after Astro
     * ClientRouter navigation.
     */

    if (window.__remainsLightboxController) {
      return;
    }

    window.__remainsLightboxController = true;


    function getLightbox() {
      return document.getElementById('remains-lightbox');
    }


    function setLightboxZoom(lightbox, zoomed) {
      lightbox.classList.toggle('is-zoomed', zoomed);

      const image =
        lightbox.querySelector('.remains-lightbox-image');

      if (image) {
        image.setAttribute(
          'aria-pressed',
          zoomed ? 'true' : 'false'
        );

        image.setAttribute(
          'aria-label',
          zoomed ? 'Reduce image size' : 'Enlarge image'
        );
      }
    }

    function openLightbox(trigger) {

      const lightbox = getLightbox();

      if (!lightbox) {
        return;
      }


      const image =
        lightbox.querySelector('.remains-lightbox-image');

      const title =
        lightbox.querySelector('.remains-lightbox-title');


      const full =
        trigger.dataset.full ||
        trigger.getAttribute('href');


      const workTitle =
        trigger.dataset.title || '';


      if (!full || !image) {
        return;
      }


      setLightboxZoom(lightbox, false);

      image.src = full;
      image.alt = workTitle;


      if (title) {
        title.textContent = workTitle;
      }


      lightbox.classList.add('is-open');

      lightbox.setAttribute(
        'aria-hidden',
        'false'
      );


      document.body.classList.add(
        'remains-lightbox-open'
      );
    }


    function closeLightbox() {

      const lightbox = getLightbox();

      if (!lightbox) {
        return;
      }


      const image =
        lightbox.querySelector('.remains-lightbox-image');


      setLightboxZoom(lightbox, false);
      lightbox.classList.remove('is-open');

      lightbox.setAttribute(
        'aria-hidden',
        'true'
      );


      document.body.classList.remove(
        'remains-lightbox-open'
      );


      if (image) {
        image.removeAttribute('src');
      }
    }


    document.addEventListener(
      'click',
      (event) => {

        const target = event.target;

        if (!(target instanceof Element)) {
          return;
        }


        /*
         * PHOTO CLICK
         */

        const trigger =
          target.closest('.visual-lightbox-trigger');


        if (trigger) {

          /*
           * TINA QUICK EDIT PRIORITY
           * Let TinaCMS handle registered editable fields.
           * Keep normal lightbox behavior outside quick edit.
           */
          const tinaFieldElement = target.closest(
            '[data-tina-field], [data-tina-field-overlay]'
          );

          const tinaQuickEditEnabled =
            window.parent !== window &&
            document.body.classList.contains(
              '__tina-quick-editing-enabled'
            );

          const hasTinaField =
            tinaFieldElement &&
            (
              tinaFieldElement.getAttribute('data-tina-field') ||
              tinaFieldElement.getAttribute('data-tina-field-overlay')
            );

          if (tinaQuickEditEnabled && hasTinaField) {
            event.preventDefault();
            return;
          }

          event.preventDefault();
          event.stopPropagation();

          openLightbox(trigger);

          return;
        }


        /*
         * LIGHTBOX IMAGE ZOOM
         */

        const zoomImage =
          target.closest('.remains-lightbox-image');

        if (zoomImage) {
          const lightbox = getLightbox();

          if (
            lightbox &&
            lightbox.classList.contains('is-open') &&
            lightbox.contains(zoomImage)
          ) {
            event.preventDefault();
            event.stopPropagation();

            setLightboxZoom(
              lightbox,
              !lightbox.classList.contains('is-zoomed')
            );

            return;
          }
        }

        /*
         * CLOSE BUTTON
         */

        if (
          target.closest('.remains-lightbox-close')
        ) {

          event.preventDefault();

          closeLightbox();

          return;
        }


        /*
         * CLICK BLACK BACKDROP
         */

        const lightbox = getLightbox();

        if (
          lightbox &&
          target === lightbox
        ) {

          closeLightbox();

        }

      },
      true
    );


    document.addEventListener(
      'keydown',
      (event) => {

        if (event.key === 'Escape') {
          closeLightbox();
          return;
        }

        const lightbox = getLightbox();
        const target = event.target;

        if (
          lightbox &&
          lightbox.classList.contains('is-open') &&
          target instanceof Element &&
          target.matches('.remains-lightbox-image') &&
          lightbox.contains(target) &&
          (event.key === 'Enter' || event.key === ' ')
        ) {
          event.preventDefault();

          setLightboxZoom(
            lightbox,
            !lightbox.classList.contains('is-zoomed')
          );
        }

      }
    );

  })();
</script>





<!-- PORTFOLIO TOP BLOG UI ISOLATION START -->

<style is:global>

  /* =====================================================
     PORTFOLIO TOP ONLY

     Blog article UI must never appear here.
     ===================================================== */


  body.blog-detail-page:has(.portfolio-section)
  .nexus-article-actions,

  body.blog-detail-page:has(.portfolio-section)
  .nexus-author-footer,

  body.blog-detail-page:has(.portfolio-section)
  .nexus-prevnext-divider,

  body.blog-detail-page:has(.portfolio-section)
  .nexus-prevnext-nav,

  body.blog-detail-page:has(.portfolio-section)
  .series-neighbor-nav,

  body.blog-detail-page:has(.portfolio-section)
  .related-posts,

  body.blog-detail-page:has(.portfolio-section)
  .article-after-related {

    display: none !important;

    width: 0 !important;
    height: 0 !important;
    min-height: 0 !important;

    margin: 0 !important;
    padding: 0 !important;

    border: 0 !important;

    overflow: hidden !important;
  }


  /* =====================================================
     Remove BlogArticle's bottom space on Portfolio TOP
     ===================================================== */

  body.blog-detail-page:has(.portfolio-section)
  .article-content {

    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }


  body.blog-detail-page:has(.portfolio-section)
  .article-card {

    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }


  body.blog-detail-page:has(.portfolio-section)
  .article-column {

    margin-bottom: 0 !important;
    padding-bottom: 0 !important;

    min-height: 0 !important;
  }


  body.blog-detail-page:has(.portfolio-section)
  .blog-layout {

    margin-bottom: 0 !important;
    padding-bottom: 0 !important;

    min-height: 0 !important;
  }


  /* =====================================================
     Existing site Footer
     Bring it directly up after Portfolio content
     ===================================================== */

  body.blog-detail-page:has(.portfolio-section)
  .site-footer {

    margin-top: 0 !important;
  }

</style>

<!-- PORTFOLIO TOP BLOG UI ISOLATION END -->

<Footer />


<style is:global>

/* =========================================================
   PORTFOLIO + PROJECTS
   ========================================================= */

.portfolio-section,
.project-index-section {
  font-family:
    "Host Grotesk Variable",
    "Inter Variable",
    "Helvetica Neue",
    Arial,
    sans-serif;
}


/* =========================================================
   REMAINS 鬩包ｽｯ繝ｻ・ｶ驛｢譎｢・ｽ・ｻPAGE HEADER
   Match FRAGMENTS typography
   ========================================================= */

body:has(.portfolio-section) .article-header-archive {
  display: block !important;
  margin-bottom: 40px !important;
}

body:has(.portfolio-section) .article-header-archive .archive-heading {
  width: 100% !important;
}

body:has(.portfolio-section) .article-header-archive .archive-title {
  margin: 0 !important;

  color: #e7e8e4 !important;

  font-family:
    "Host Grotesk Variable",
    "Inter Variable",
    "Helvetica Neue",
    Arial,
    sans-serif !important;

  font-size:
    clamp(2.85rem, 4.35vw, 4.7rem) !important;

  font-weight: 800 !important;

  line-height: 0.9 !important;

  letter-spacing: -0.065em !important;

  text-transform: uppercase !important;
}

body:has(.portfolio-section) .article-header-archive .archive-kicker {
  margin: 0 0 11px !important;

  color: #b7ff00 !important;

  font-family:
    "Maple Mono",
    monospace !important;

  font-size: 0.66rem !important;

  font-weight: 700 !important;

  line-height: 1.2 !important;

  letter-spacing: 0.16em !important;

  text-transform: uppercase !important;
}

/* Portfolio index is not a blog post.
   Remove date / word count / reading time. */

body:has(.portfolio-section) .article-header-archive .meta-line,
body:has(.portfolio-section) .article-header-archive .group-meta-line {
  display: none !important;
}

/* Move subtitle underneath REMAINS */

body:has(.portfolio-section) .article-header-archive .archive-copy {
  display: block !important;

  width: min(610px, 100%) !important;
  max-width: 610px !important;

  margin: 14px 0 0 !important;
  padding: 0 0 15px !important;

  text-align: left !important;

  position: relative;
}

body:has(.portfolio-section) .article-header-archive .archive-subtitle {
  width: 100% !important;

  margin: 0 !important;

  color: #858b83 !important;

  font-family:
    "Inter Variable",
    "Helvetica Neue",
    Arial,
    sans-serif !important;

  font-size: 0.82rem !important;

  font-weight: 400 !important;

  line-height: 1.52 !important;

  letter-spacing: -0.01em !important;

  text-align: left !important;
}


body:has(.portfolio-section) .article-header-archive .archive-copy::after {
  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  height: 1px;

  content: "";

  background:
    linear-gradient(
      90deg,
      rgba(255, 82, 0, 0.02) 0%,
      rgba(255, 82, 0, 0.06) 18%,
      rgba(255, 82, 0, 0.16) 42%,
      rgba(255, 82, 0, 0.40) 70%,
      rgba(255, 82, 0, 0.88) 100%
    );
}
body:has(.portfolio-section) .article-header-archive .archive-note {
  display: none !important;
}


/* =========================================================
   PORTFOLIO
   ========================================================= */

.portfolio-section {
  margin-top: 24px;

  font-family:
    "Host Grotesk Variable",
    "Inter Variable",
    "Helvetica Neue",
    Arial,
    sans-serif;
}


/* =========================================================
   SECTION HEADER
   ========================================================= */

.portfolio-section-header {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  margin-bottom: 22px;

  padding: 0 0 14px;

  border-bottom:
    1px solid rgba(255,255,255,.09);
}


.portfolio-section-kicker {
  margin: 0 0 7px;

  color: #b7ff00;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .60rem;
  font-weight: 700;

  letter-spacing: .15em;
}


.portfolio-section-header h2 {
  margin: 0;

  color: #d9dcd6;

  font-family:
    "Host Grotesk Variable",
    "Inter Variable",
    Arial,
    sans-serif;

  font-size:
    clamp(1.30rem, 2vw, 1.75rem);

  font-weight: 650;

  line-height: 1;

  letter-spacing: -.035em;
}


.portfolio-index {
  padding-bottom: 2px;

  color: #656b64;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .58rem;

  letter-spacing: .12em;
}


/* =========================================================
   VISUAL GRID
   ========================================================= */

.portfolio-grid {
  display: grid;

  grid-template-columns:
    repeat(12, minmax(0, 1fr));

  grid-auto-rows: 52px;

  gap: 14px;

  align-items: stretch;

  grid-auto-flow: dense;
}


.visual-card {
  min-width: 0;
}


.visual-card-main {
  grid-column: 1 / 9;
  grid-row: span 9;
}


.visual-card-tall {
  grid-column: 9 / 13;
  grid-row: span 12;
}


.visual-card-small {
  grid-column: 1 / 6;
  grid-row: span 6;
}


.visual-card-fragment {
  grid-column: 6 / 9;
  grid-row: span 6;
}
.visual-card-wide {
  grid-column: 1 / 8;
  grid-row: span 7;
}


.visual-card-portrait {
  grid-column: 8 / 13;
  grid-row: span 10;
}


.visual-card-extra-small {
  grid-column: 1 / 5;
  grid-row: span 6;
}


.visual-card-extra-wide {
  grid-column: 5 / 13;
  grid-row: span 6;
}


.visual-link {
  display: flex;

  flex-direction: column;

  height: 100%;

  color: inherit;

  text-decoration: none;
}


.visual-image {
  position: relative;

  flex: 1;

  min-height: 0;

  margin: 0;

  overflow: hidden;

  box-sizing: border-box;

  border:
    1px solid rgba(255,255,255,.12);

  background: #080908;

  transition:
    border-color 260ms ease,
    box-shadow 260ms ease;
}


.visual-image::after {
  position: absolute;

  inset: 0;

  content: "";

  border: 0;

  pointer-events: none;
}


.visual-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  filter:
    grayscale(100%)
    brightness(.78)
    contrast(1.08);

  transform:
    scale(1.001);

  transition:
    filter 500ms ease,
    transform 700ms cubic-bezier(.2,.7,.2,1);
}


.visual-link:hover .visual-image img {
  filter:
    grayscale(35%)
    brightness(.88)
    contrast(1.05);

  transform:
    scale(1.025);
}


.visual-link:hover .visual-image {
  outline-color:
    rgba(255,82,0,.82);

  box-shadow:
    0 0 18px rgba(255,82,0,.16);
}

.visual-card:hover .visual-image,
.visual-link:hover .visual-image,
.visual-card:focus-within .visual-image {
  border-color:
    rgba(255,82,0,.9);

  box-shadow:
    0 0 18px rgba(255,82,0,.18);
}

.visual-link:hover .visual-image::after {
  border: 0;
}
.visual-overlay {
  position: absolute;

  z-index: 2;

  right: 13px;
  bottom: 12px;

  padding: 4px 7px;

  color: #dfe2dc;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .54rem;
  font-weight: 650;

  letter-spacing: .11em;

  background:
    rgba(5,6,5,.74);

  opacity: 0;

  transform:
    translateY(5px);

  transition:
    opacity 220ms ease,
    transform 220ms ease;
}


.visual-link:hover .visual-overlay {
  opacity: 1;

  transform:
    translateY(0);
}


/* =========================================================
   IMAGE CAPTIONS
   ========================================================= */

.visual-meta {
  display: flex;

  flex: none;

  gap: 14px;

  align-items: flex-start;
  justify-content: space-between;

  min-height: 52px;

  padding: 9px 1px 0;
}


.visual-type {
  display: block;

  margin: 0 0 3px;

  color: #b7ff00;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .53rem;
  font-weight: 700;

  letter-spacing: .12em;
}


.visual-meta h3 {
  margin: 0;

  color: #d8dad5;

  font-size: .78rem;
  font-weight: 580;

  line-height: 1.25;

  letter-spacing: -.01em;
}


.visual-year {
  color: #676c66;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .55rem;
}


/* =========================================================
