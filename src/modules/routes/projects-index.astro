/* =========================================================
   REMAINS LIGHTBOX
   ========================================================= */

.remains-lightbox {
  position: fixed;

  z-index: 99999;

  inset: 0;

  display: none;

  align-items: center;
  justify-content: center;

  padding:
    clamp(20px, 4vw, 60px);

  background:
    rgba(0, 0, 0, 0.94);

  backdrop-filter:
    blur(5px);
}


.remains-lightbox.is-open {
  display: flex;
}


.remains-lightbox-stage {
  display: flex;

  flex-direction: column;

  align-items: center;

  width: 100%;
  height: 100%;
}


.remains-lightbox-image {
  display: block;

  width: auto;
  height: auto;

  max-width: min(92vw, 1280px);
  max-height: calc(100vh - 130px);

  object-fit: contain;

  border: 0;
  border-radius: 0 !important;

  box-shadow:
    0 0 50px rgba(0,0,0,.55);
}


.remains-lightbox-info {
  display: flex;

  gap: 18px;

  align-items: center;
  justify-content: space-between;

  width: min(100%, 1100px);

  margin-top: 14px;

  padding-top: 9px;

  border-top:
    1px solid rgba(255,255,255,.09);
}


.remains-lightbox-label {
  color: #b7ff00;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .80rem;
  font-weight: 700;

  letter-spacing: .14em;
}


.remains-lightbox-title {
  color: #b5bab3;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .80rem;

  letter-spacing: .08em;
}


.remains-lightbox-close {
  position: absolute;

  z-index: 3;

  top: 22px;
  right: 27px;

  display: grid;

  place-items: center;

  width: 42px;
  height: 42px;

  padding: 0;

  border:
    1px solid rgba(150,150,150,.48);

  border-radius: 50%;

  color: #d8ddd4;

  font-family:
    "Host Grotesk Variable",
    Arial,
    sans-serif;

  font-size: 1.35rem;
  font-weight: 400;

  line-height: 1;

  background:
    rgba(22,22,22,.86);

  box-shadow:
    0 0 0 1px rgba(255,255,255,.04);

  cursor: pointer;

  transition:
    color 180ms ease,
    border-color 180ms ease,
    background-color 180ms ease,
    box-shadow 180ms ease,
    transform 180ms ease;
}


.remains-lightbox-close:hover,
.remains-lightbox-close:focus-visible {
  color: #b7ff00;

  border-color:
    rgba(183,255,0,.82);

  background:
    rgba(14,18,12,.92);

  box-shadow:
    0 0 14px rgba(183,255,0,.28),
    inset 0 0 10px rgba(183,255,0,.10);

  transform:
    scale(1.04);
}


body.remains-lightbox-open {
  overflow: hidden;
}


.visual-lightbox-trigger {
  cursor: zoom-in;
}


@media (max-width: 760px) {

  .remains-lightbox {
    padding:
      58px 12px 18px;
  }


  .remains-lightbox-image {
  display: block;

  width: auto;
  height: auto;

  max-width: min(92vw, 1280px);
  max-height: calc(100vh - 130px);

  object-fit: contain;

  border: 0;
