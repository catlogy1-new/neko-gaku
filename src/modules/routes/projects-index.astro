/* REMAINS PHOTO RADIUS FINAL END */

/* =========================================================
   REMAINS HEADER 鬩包ｽｯ繝ｻ・ｶ驛｢譎｢・ｽ・ｻFINAL WIDTH / GRADIENT
   ========================================================= */

/*
 * Keep the text compact, but allow the gradient rule
 * to continue across the full header width.
 */
body:has(.portfolio-section) .article-header-archive .archive-copy {
  width: 100% !important;
  max-width: none !important;
  padding-bottom: 17px !important;
}

/*
 * Text itself is deliberately limited to two lines
 * on desktop while the parent remains full width.
 */
body:has(.portfolio-section) .article-header-archive .archive-subtitle {
  display: block !important;
  width: 100% !important;
  max-width: 560px !important;
  text-wrap: balance;
}

/*
 * Preserve the existing orange direction:
 * almost invisible on the left,
 * increasingly bright toward the right edge.
 */
body:has(.portfolio-section) .article-header-archive .archive-copy::after {
  left: 0 !important;
  right: 0 !important;
  width: 100% !important;

  background: linear-gradient(
    90deg,
    rgba(255, 82, 0, 0.02) 0%,
    rgba(255, 82, 0, 0.05) 18%,
    rgba(255, 82, 0, 0.14) 42%,
    rgba(255, 82, 0, 0.38) 68%,
    rgba(255, 82, 0, 0.72) 86%,
    rgba(255, 82, 0, 0.96) 100%
  ) !important;
}

@media (max-width: 760px) {
  body:has(.portfolio-section) .article-header-archive .archive-subtitle {
    max-width: 100% !important;
    text-wrap: pretty;
  }
}


body:has(.portfolio-section) .article-header-archive .archive-subtitle {
  width: auto !important;
  max-width: none !important;
  white-space: pre-line !important;
  text-wrap: nowrap !important;
}
/* REMAINS HEADER 鬩包ｽｯ繝ｻ・ｶ驛｢譎｢・ｽ・ｻFINAL WIDTH / GRADIENT END */


/* PORTFOLIO 鬩包ｽｯ繝ｻ・ｶ驛｢譎｢・ｽ・ｻFULL SHELL WIDTH */
body:has(.portfolio-section) .article-prose {
