/* =========================================================
   PORTFOLIO
   ========================================================= */

.portfolio-section {
  margin-top: 24px;

  font-family:
    "Host Grotesk Variable",
    "Inter Variable",
    "Helvetica Neue",
    Arial,
    sans-serif;
}


/* =========================================================
   SECTION HEADER
   ========================================================= */

.portfolio-section-header {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  margin-bottom: 22px;

  padding: 0 0 14px;

  border-bottom:
    1px solid rgba(255,255,255,.09);
}


.portfolio-section-kicker {
  margin: 0 0 7px;

  color: #b7ff00;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .60rem;
  font-weight: 700;

  letter-spacing: .15em;
}


.portfolio-section-header h2 {
  margin: 0;

  color: #d9dcd6;

  font-family:
    "Host Grotesk Variable",
    "Inter Variable",
    Arial,
    sans-serif;

  font-size:
    clamp(1.30rem, 2vw, 1.75rem);

  font-weight: 650;

  line-height: 1;

  letter-spacing: -.035em;
}


.portfolio-index {
  padding-bottom: 2px;

  color: #656b64;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .58rem;

  letter-spacing: .12em;
}


/* =========================================================
   VISUAL GRID
   ========================================================= */

.portfolio-grid {
  display: grid;

  grid-template-columns:
    repeat(12, minmax(0, 1fr));

  grid-auto-rows: 52px;

  gap: 14px;

  align-items: stretch;
}


.visual-card {
  min-width: 0;
}


.visual-card-main {
  grid-column: 1 / 9;
  grid-row: span 8;
}


.visual-card-tall {
  grid-column: 9 / 13;
  grid-row: span 12;
}


.visual-card-small {
  grid-column: 1 / 6;
  grid-row: span 6;
}


.visual-card-fragment {
  grid-column: 6 / 9;
  grid-row: span 6;
}


.visual-link {
  display: flex;

  flex-direction: column;

  height: 100%;

  color: inherit;

  text-decoration: none;
}


.visual-image {
  position: relative;

  flex: 1;

  min-height: 0;

  margin: 0;

  overflow: hidden;

  background: #080908;
}


.visual-image::after {
  position: absolute;

  inset: 0;

  content: "";

  border:
    1px solid rgba(255,255,255,.12);

  pointer-events: none;

  transition:
    border-color 260ms ease;
}


.visual-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  filter:
    grayscale(100%)
    brightness(.78)
    contrast(1.08);

  transform:
    scale(1.001);

  transition:
    filter 500ms ease,
    transform 700ms cubic-bezier(.2,.7,.2,1);
}


.visual-link:hover .visual-image img {
  filter:
    grayscale(35%)
    brightness(.88)
    contrast(1.05);

  transform:
    scale(1.025);
}


.visual-link:hover .visual-image::after {
  border-color:
    rgba(255,82,0,.82);
}


.visual-overlay {
  position: absolute;

  z-index: 2;

  right: 13px;
  bottom: 12px;

  padding: 4px 7px;

  color: #dfe2dc;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .54rem;
  font-weight: 650;

  letter-spacing: .11em;

  background:
    rgba(5,6,5,.74);

  opacity: 0;

  transform:
    translateY(5px);

  transition:
    opacity 220ms ease,
    transform 220ms ease;
}


.visual-link:hover .visual-overlay {
  opacity: 1;

  transform:
    translateY(0);
}


/* =========================================================
   IMAGE CAPTIONS
   ========================================================= */

.visual-meta {
  display: flex;

  flex: none;

  gap: 14px;

  align-items: flex-start;
  justify-content: space-between;

  min-height: 52px;

  padding: 9px 1px 0;
}


.visual-type {
  display: block;

  margin: 0 0 3px;

  color: #b7ff00;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .53rem;
  font-weight: 700;

  letter-spacing: .12em;
}


.visual-meta h3 {
  margin: 0;

  color: #d8dad5;

  font-size: .78rem;
  font-weight: 580;

  line-height: 1.25;

  letter-spacing: -.01em;
}


.visual-year {
  color: #676c66;

  font-family:
    "Maple Mono",
    monospace;

  font-size: .55rem;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 760px) {

  body:has(.portfolio-section) .article-header-archive {
