}


.remains-lightbox-stage {
  display: flex;

  flex-direction: column;

  align-items: center;

  width: 100%;
  height: 100%;
}


.remains-lightbox-image {
  display: block;

  width: auto;
  height: auto;

  max-width: 100%;
  max-height: calc(100vh - 130px);

  object-fit: contain;

  border: 0;
  border-radius: 0 !important;

  box-shadow:
    0 0 50px rgba(0,0,0,.55);
