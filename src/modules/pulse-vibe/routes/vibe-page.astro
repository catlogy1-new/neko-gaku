---
import Vibe from './vibe.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('vibe')).filter((entry) => !entry.data.draft);
  const totalPages = Math.max(1, Math.ceil(entries.length / 10));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { pageNumber: index + 2 },
  }));
}
const { pageNumber } = Astro.props;
---
<Vibe pageNumber={pageNumber} />