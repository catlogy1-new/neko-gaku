---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import FallbackImage from '../assets/figure/fail-loading-image.png';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, fonts } = await getSiteConfig();
---

<script is:inline>
  document.documentElement.setAttribute('data-font-loading', '');

  (() => {
    const reveal = () => {
      document.documentElement.removeAttribute('data-font-loading');
    };

    if (!document.fonts) {
      reveal();
      return;
    }

    Promise.race([
      document.fonts.ready,
      new Promise((resolve) => window.setTimeout(resolve, 2500)),
    ]).then(reveal, reveal);

    window.addEventListener('pageshow', () => {
      if (document.fonts.status === 'loaded') reveal();
    }, { once: true });
  })();
</script>

<style is:global>
  html[data-font-loading] body {
    visibility: hidden;
  }
</style>

<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage={FallbackImage}
  site={site}
  fonts={fonts}
/>
