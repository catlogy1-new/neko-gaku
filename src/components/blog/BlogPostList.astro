    position: fixed;
    right: 22px;
    bottom: 24px;
    z-index: 99999;

    max-width:
      min(
        360px,
        calc(100vw - 32px)
      );

    padding:
      11px 14px;

    border:
      1px solid
      rgba(183, 255, 0, 0.28);

    border-radius:
      5px;

    background:
      rgba(8, 9, 8, 0.97);

    color:
      rgba(225, 228, 221, 0.94);

    font-family:
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;

    font-size:
      0.78rem;

    font-weight:
      500;

    line-height:
      1.45;

    box-shadow:
      0 12px 34px
      rgba(0, 0, 0, 0.42);

    opacity:
      0;

    transform:
      translateY(8px);

    pointer-events:
      none;

    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .nexus-blog-pin-toast.is-visible {
    opacity:
      1;

    transform:
      translateY(0);
  }
</style>

<script is:inline>
(() => {

  if (
    window.__nexusBlogPinActionBridge
  ) {
    return;
  }

  window.__nexusBlogPinActionBridge =
    true;

  let timer = null;


  const showPending = () => {

    let toast =
      document.querySelector(
        '.nexus-blog-pin-toast'
      );

    if (!toast) {

      toast =
        document.createElement(
          'div'
        );

      toast.className =
        'nexus-blog-pin-toast';

      toast.setAttribute(
        'role',
        'status'
      );

      toast.textContent =
        'Unpinning will be enabled when TinaCMS is connected.';

      document.body.appendChild(
        toast
      );
    }

    toast.classList.add(
      'is-visible'
    );

    if (timer) {
      clearTimeout(
        timer
      );
    }

    timer =
      setTimeout(() => {

        toast.classList.remove(
          'is-visible'
        );

      }, 2200);
  };


  /*
   * window capture は、
   * 既存のdocument側pin処理より先に動く。
   */
  window.addEventListener(
    'click',
    (event) => {

      const target =
        event.target;

      if (
        !(target instanceof Element)
      ) {
        return;
      }

      const unpin =
        target.closest(
          '[data-nexus-unpin]'
        );

      if (!unpin) {
        return;
      }

      showPending();

    },
    true
  );

})();
</script>

