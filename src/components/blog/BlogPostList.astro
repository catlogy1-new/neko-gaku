    font-family:
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif !important;

    font-size: 0.78rem !important;
    font-weight: 500 !important;
    line-height: 1.25 !important;

    text-align: left !important;
    white-space: nowrap !important;

    cursor: pointer !important;
  }

  .nexus-pin-admin-menu button:hover {
    background: rgba(183, 255, 0, 0.055) !important;
    color: #b7ff00 !important;
  }
</style>

<script is:inline>
(() => {

  if (window.__nexusSafeBlogPinBound) {
    return;
  }

  window.__nexusSafeBlogPinBound = true;


  const isEditorMode = () => {

    const params =
      new URLSearchParams(
        window.location.search
      );

    if (params.get('editor') === '1') {
      return true;
    }

    try {

      if (
        window.self !== window.top &&
        document.referrer.includes('/admin')
      ) {
        return true;
      }

    } catch (_) {
      return true;
    }

    return false;
  };


  const closeMenus = () => {

    document
      .querySelectorAll(
        '.nexus-pin-admin-menu'
      )
      .forEach((menu) => {
        menu.hidden = true;
      });
  };


  const initPins = () => {

    const editorMode =
      isEditorMode();

    document.documentElement.classList.toggle(
      'nexus-blog-editor-mode',
      editorMode
    );

    document
      .querySelectorAll(
        '.nexus-journal-pin'
      )
      .forEach((pin) => {

        if (!editorMode) {

          pin.removeAttribute('role');
          pin.removeAttribute('tabindex');

          return;
        }

        pin.setAttribute(
          'role',
          'button'
        );

        pin.setAttribute(
          'tabindex',
          '0'
        );

        pin.setAttribute(
          'aria-label',
          'Pinned article'
        );

        if (
          !pin.querySelector(
            '.nexus-pin-admin-menu'
          )
        ) {

          const menu =
            document.createElement('span');

          menu.className =
            'nexus-pin-admin-menu';

          menu.hidden = true;

          const button =
            document.createElement('button');

          button.type =
            'button';

          button.textContent =
            'Unpin from profile';

          button.setAttribute(
            'data-nexus-unpin',
            ''
          );

          menu.appendChild(
            button
          );

          pin.appendChild(
            menu
          );
        }
      });
  };


  /*
    capture=true にして、
    カード全体のクリック処理より先にPINを捕まえる
  */
  document.addEventListener(
    'click',
    (event) => {

      if (!isEditorMode()) {
        return;
      }

      const target =
        event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const unpin =
        target.closest(
          '[data-nexus-unpin]'
        );

      if (unpin) {

        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        /*
          TinaCMS未接続なので今はUI確認のみ。
          実際のsticky変更は後でCMSに接続する。
        */

        return;
      }

      const pin =
        target.closest(
          '.nexus-journal-pin'
        );

      if (pin) {

        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        const menu =
          pin.querySelector(
            '.nexus-pin-admin-menu'
          );

        if (!menu) {
          return;
        }

        const opening =
          menu.hidden;

        closeMenus();

        menu.hidden =
          !opening;

        return;
      }

      closeMenus();
    },
    true
  );


  document.addEventListener(
    'keydown',
    (event) => {

      if (!isEditorMode()) {
        return;
      }

      if (
        event.key !== 'Enter' &&
        event.key !== ' '
      ) {
        return;
      }

      const target =
        event.target;

      if (
        !(target instanceof Element) ||
        !target.matches(
          '.nexus-journal-pin'
        )
      ) {
        return;
      }

      event.preventDefault();

      target.click();
    }
  );


  initPins();

  document.addEventListener(
    'astro:page-load',
    initPins
  );

})();
</script>

<!-- NEXUS SAFE CARD PIN END -->

