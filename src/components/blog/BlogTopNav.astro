---
import { ListTree, Menu } from 'lucide-astro';
import SiteSearch from './SiteSearch.astro';
import TocTree from './TocTree.astro';
import { getSiteConfig, getTopNavLinks } from '../../data/site';
import { getUiText } from '../../utils/ui-text';
import type { TocItem } from '../../utils/toc-tree';

interface Props {
  showTocIcon?: boolean;
  tocItems?: TocItem[];
}

const { showTocIcon = false, tocItems = [] } = Astro.props;
const siteConfig = await getSiteConfig();
const { site, search } = siteConfig;
const ui = getUiText(siteConfig);

const links = (await getTopNavLinks())
  .filter((link) => link.href !== '/')
  .map((link) => ({
    ...link,
    label: link.label === 'Projects' ? 'Portfolio' : link.label === 'Vibe' ? 'Pulse' : link.label,
  }));

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const currentPathname =
  basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname;

const currentPath = currentPathname.replace(/\/$/, '') || '/';

function withBase(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
    return href;
  }

  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

function isActive(href: string) {
  if (href.startsWith('http')) return false;

  const normalizedHref = href.replace(/\/$/, '') || '/';

  if (normalizedHref === '/') {
    return currentPath === '/';
  }

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}

const shouldShowTocAction = showTocIcon && tocItems.length > 0;
---

<header
  class="blog-top-nav"
  data-pagefind-ignore
  data-toc-open-label={ui.toc.open}
  data-toc-close-label={ui.toc.close}
>
  <button
    class="mobile-menu-toggle"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="mobile-nav-menu"
    data-mobile-menu-toggle
  >
    <Menu size={18} stroke-width={2} />
  </button>

  <a class="brand" href={withBase('/')} data-astro-reload aria-label={`Go to ${site.title} home`}>
    <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
    <span class="brand-title">NEXUS<span class="brand-underline" aria-hidden="true"></span></span>
  </a>

  <nav class="nav-links" aria-label="Main navigation">
    {
      links.map((link) =>
        link.disabled ? (
          <span class="nav-link nav-link-placeholder" aria-disabled="true">
            {link.label}
          </span>
        ) : (
          <a
            class:list={['nav-link', { active: isActive(link.href) }]}
            href={withBase(link.href)}
          >
            {link.label}
          </a>
        ),
      )
    }
  </nav>

  <nav
    class="mobile-menu-panel"
    id="mobile-nav-menu"
    aria-label="Mobile navigation"
    data-mobile-menu
  >
    {
      links.map((link) =>
        link.disabled ? (
          <span class="mobile-menu-link mobile-menu-placeholder" aria-disabled="true">
            {link.label}
          </span>
        ) : (
          <a
            class:list={['mobile-menu-link', { active: isActive(link.href) }]}
            href={withBase(link.href)}
            data-mobile-menu-link
          >
            {link.label}
          </a>
        ),
      )
    }
  </nav>

  <div class="nav-actions" aria-label="Page actions">
    {search.enabled && <SiteSearch search={search} />}

    {
      shouldShowTocAction && (
        <button
          class="toc-action"
          type="button"
          aria-label={ui.toc.open}
          aria-expanded="false"
          aria-controls="mobile-toc-menu"
          title={ui.toc.title}
          data-mobile-toc-trigger
        >
          <ListTree size={17} stroke-width={2} />
        </button>
      )
    }
  </div>

  {
    shouldShowTocAction && (
      <nav
        class="mobile-toc-panel"
        id="mobile-toc-menu"
        aria-label={ui.toc.title}
        data-nav-toc-menu
        data-toc-root
        data-toc-scroll
      >
        <p>{ui.toc.title}</p>
        <TocTree items={tocItems} idPrefix="nav-toc" navLink />
      </nav>
    )
  }
</header>

<script>
  let navigationSequence = 0;
  let activeNavigationId = 0;

  const clearPendingNavigation = (navigationId?: number) => {
    if (navigationId && navigationId !== activeNavigationId) {
      return;
    }

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      delete header.dataset.navPending;
      header.removeAttribute('aria-busy');

      for (const link of header.querySelectorAll<HTMLElement>('[data-nav-link-pending]')) {
        delete link.dataset.navLinkPending;
      }
    }

    activeNavigationId = 0;
  };

  const startPendingNavigation = (sourceElement?: Element) => {
    const sourceLink = sourceElement?.closest<HTMLAnchorElement>('.blog-top-nav a[href]');

    if (!sourceLink) {
      return 0;
    }

    const navigationId = ++navigationSequence;
    const pendingHref = sourceLink.href;
    activeNavigationId = navigationId;

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      header.dataset.navPending = 'true';
      header.setAttribute('aria-busy', 'true');

      for (const link of header.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        link.toggleAttribute('data-nav-link-pending', link.href === pendingHref);
      }
    }

    return navigationId;
  };

  const initMobileTopNav = () => {
    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      const toggle = header.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
      const tocTrigger = header.querySelector<HTMLButtonElement>('[data-mobile-toc-trigger]');
      const tocMenu = header.querySelector<HTMLElement>('[data-nav-toc-menu]');

      if (!header.dataset.scrollHideReady) {
        header.dataset.scrollHideReady = 'true';

        const topRevealOffset = 24;
        const hideAfterOffset = 96;
        const scrollIntentDelta = 8;
        let lastScrollY = window.scrollY;
        let scrollFrame = 0;

        const setNavHidden = (hidden: boolean) => {
          header.dataset.navHidden = hidden ? 'true' : 'false';
          header.toggleAttribute('inert', hidden);
          header.toggleAttribute('aria-hidden', hidden);
        };

        const shouldKeepVisible = () =>
          window.scrollY <= topRevealOffset ||
          header.dataset.mobileMenuOpen === 'true' ||
          header.dataset.mobileTocOpen === 'true' ||
          header.matches(':focus-within');

        const updateNavVisibility = () => {
          scrollFrame = 0;
          const currentScrollY = window.scrollY;
          const scrollDelta = currentScrollY - lastScrollY;

          if (shouldKeepVisible()) {
            setNavHidden(false);
            lastScrollY = currentScrollY;
            return;
          }

          if (Math.abs(scrollDelta) < scrollIntentDelta) {
            return;
          }

          setNavHidden(scrollDelta > 0 && currentScrollY > hideAfterOffset);
          lastScrollY = currentScrollY;
        };

        window.addEventListener(
          'scroll',
          () => {
            if (scrollFrame) return;
            scrollFrame = window.requestAnimationFrame(updateNavVisibility);
          },
          { passive: true },
        );

        window.addEventListener('resize', () => {
          if (window.scrollY <= topRevealOffset) {
            setNavHidden(false);
          }
        });

        setNavHidden(false);
      }

      if (toggle && menu && !header.dataset.mobileMenuReady) {
        header.dataset.mobileMenuReady = 'true';

        const setMenuOpen = (open: boolean) => {
          header.dataset.mobileMenuOpen = open ? 'true' : 'false';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute(
            'aria-label',
            open ? 'Close navigation menu' : 'Open navigation menu',
          );
        };

        const setTocOpen = (open: boolean) => {
          if (!tocTrigger || !tocMenu) return;

          const tocOpenLabel = header.dataset.tocOpenLabel ?? 'Open table of contents';
          const tocCloseLabel = header.dataset.tocCloseLabel ?? 'Close table of contents';

          header.dataset.mobileTocOpen = open ? 'true' : 'false';
          tocTrigger.setAttribute('aria-expanded', String(open));
          tocTrigger.setAttribute('aria-label', open ? tocCloseLabel : tocOpenLabel);
        };

        toggle.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileMenuOpen !== 'true';
          setMenuOpen(nextOpen);
          header.dataset.navHidden = 'false';

          if (nextOpen) {
            setTocOpen(false);
          }
        });

        menu.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-mobile-menu-link]')) {
            setMenuOpen(false);
          }
        });

        tocTrigger?.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileTocOpen !== 'true';
          setTocOpen(nextOpen);
          header.dataset.navHidden = 'false';

          if (nextOpen) {
            setMenuOpen(false);
          }
        });

        tocMenu?.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-nav-toc-link]')) {
            setTocOpen(false);
          }
        });

        document.addEventListener('click', (event) => {
          if (!header.contains(event.target as Node)) {
            setMenuOpen(false);
            setTocOpen(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            setMenuOpen(false);
            setTocOpen(false);
          }
        });
      }
    }
  };

  initMobileTopNav();

  document.addEventListener('astro:before-preparation', (event) => {
    const navigationId = startPendingNavigation(event.sourceElement);

    if (!navigationId) return;

    const loadPage = event.loader;

    event.loader = async () => {
      try {
        await loadPage();

        if (event.signal.aborted) {
          clearPendingNavigation(navigationId);
        }
      } catch (error) {
        clearPendingNavigation(navigationId);
        throw error;
      }
    };
  });

  document.addEventListener('astro:after-swap', () => clearPendingNavigation());
  document.addEventListener('astro:page-load', initMobileTopNav);
</script>

<style>
  .blog-top-nav {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 50;

    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 32px;
    align-items: center;

    width: min(calc(100% - 40px), 1310px);
    min-height: 68px;
    margin: 0 auto;
    padding: 0;

    border: 0;
    border-radius: 0;
    background: rgba(5, 5, 5, 0.88);
    box-shadow: none;
    backdrop-filter: blur(14px);

    opacity: 1;
    transform: translateY(0);

    transition:
      opacity 180ms ease,
      transform 220ms ease;
  }

  .blog-top-nav[data-nav-hidden='true'] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
  }

  .mobile-menu-toggle,
  .mobile-menu-panel,
  .mobile-toc-panel {
    display: none;
  }

  .brand,
  a.nav-link,
  a.mobile-menu-link,
  .mobile-toc-panel a {
    color: #f5f5f2;
    text-decoration: none;
  }

  .brand {
    transform: translateX(48px);
    display: inline-flex;
    align-items: center;
    gap: 10px;

    color: #f5f5f2;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1.18rem;
    font-weight: 600;
    letter-spacing: 0.14em;

    transition: color 220ms ease;
  }

  .brand:hover {
    color: #b7ff00;
  }

  .brand-mark {
    position: relative;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .brand-mark > span {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b7ff00;
    box-shadow:
      0 0 5px rgba(183, 255, 0, 0.72),
      0 0 12px rgba(183, 255, 0, 0.20);
    transition:
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 320ms ease;
  }

  .brand-mark > span:nth-child(1) {
    width: 7px;
    height: 7px;
    top: 0;
    left: 8px;
  }

  .brand-mark > span:nth-child(2) {
    width: 4px;
    height: 4px;
    top: 6px;
    left: 1px;
  }

  .brand-mark > span:nth-child(3) {
    width: 4px;
    height: 4px;
    top: 7px;
    left: 14px;
  }

  .brand-mark > span:nth-child(4) {
    width: 7px;
    height: 7px;
    top: 13px;
    left: 6px;
  }

  .brand:hover .brand-mark > span,
  .brand:focus-visible .brand-mark > span {
    box-shadow:
      0 0 7px rgba(183, 255, 0, 0.90),
      0 0 16px rgba(183, 255, 0, 0.32);
  }

  .brand:hover .brand-mark > span:nth-child(1),
  .brand:focus-visible .brand-mark > span:nth-child(1) {
    width: 7px;
    height: 7px;
    transform: translateY(-1px);
  }

  .brand:hover .brand-mark > span:nth-child(2),
  .brand:focus-visible .brand-mark > span:nth-child(2) {
    width: 4px;
    height: 4px;
    transform: translateX(-1px);
  }

  .brand:hover .brand-mark > span:nth-child(3),
  .brand:focus-visible .brand-mark > span:nth-child(3) {
    width: 4px;
    height: 4px;
    transform: translateX(1px);
  }

  .brand:hover .brand-mark > span:nth-child(4),
  .brand:focus-visible .brand-mark > span:nth-child(4) {
    width: 7px;
    height: 7px;
    transform: translateY(1px);
  }

  .brand-mark > span {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b7ff00;
    box-shadow:
      0 0 5px rgba(183, 255, 0, 0.72),
      0 0 12px rgba(183, 255, 0, 0.20);
    transition:
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 320ms ease;
  }

  .brand-mark > span:nth-child(1) {
    width: 7px;
    height: 7px;
    top: 0;
    left: 8px;
  }

  .brand-mark > span:nth-child(2) {
    width: 4px;
    height: 4px;
    top: 6px;
    left: 1px;
  }

  .brand-mark > span:nth-child(3) {
    width: 4px;
    height: 4px;
    top: 7px;
    left: 14px;
  }

  .brand-mark > span:nth-child(4) {
    width: 7px;
    height: 7px;
    top: 13px;
    left: 6px;
  }

  .nav-links {
    display: flex;
    justify-content: center;
    gap: 3px;
  }

  .nav-link {
    position: relative;

    display: inline-flex;
    justify-content: center;
    align-items: center;

    min-width: auto;
    padding: 22px 15px 21px;

    border-radius: 0;
    color: #969a91;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.91rem;
    font-weight: 500;
    letter-spacing: 0.12em;

    transition:
      color 220ms ease,
      background 220ms ease;
  }

  /*
   * HOVER郢晢ｽｻ郢晢ｽｻ
   * 髣包ｽｳ繝ｻ・ｭ髯樊ｻゑｽｽ・ｮ驍ｵ・ｺ繝ｻ・ｮ髣包ｽｳ・つ髴難ｽ､繝ｻ・ｹ驍ｵ・ｺ闕ｵ譎｢・ｽ闃ｽ豺ｦ繝ｻ・ｦ髯ｷ・ｿ繝ｻ・ｳ驍ｵ・ｺ繝ｻ・ｸ驛｢譎｢・ｽ・ｩ驛｢・ｧ繝ｻ・､驛｢譎｢・ｽ・ｳ驍ｵ・ｺ驕停・・ｹ諷包ｽｸ・ｺ郢晢ｽｻ
   */
  a.nav-link::before {
    position: absolute;
    bottom: 13px;
    left: 50%;

    width: calc(100% - 30px);
    height: 1px;

    background: #b7ff00;

    content: '';

    transform: translateX(-50%) scaleX(0);
    transform-origin: center;

    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  a.nav-link:hover {
    color: #f5f5f2;
  }

  a.nav-link:hover::before {
    transform: translateX(-50%) scaleX(1);
  }

  /*
   * 髴托ｽｴ繝ｻ・ｾ髯懶ｽｨ繝ｻ・ｨ驛｢譎擾ｽ｣・ｹ郢晢ｽｻ驛｢・ｧ繝ｻ・ｸ郢晢ｽｻ郢晢ｽｻ
   * 髯昴・・ｸ螂・ｽｼ繝ｻ・ｸ・ｺ繝ｻ・ｪ鬮ｯ蛹ｺ・ｦ鄙ｫ繝ｻ驛｢譎擾ｽｳ・ｨ郢晢ｽ｣驛｢譏ｴ繝ｻ
   */
  a.nav-link.active {
    color: #f5f5f2;
    background: rgba(255, 255, 255, 0.035);
    border-radius: 8px;
  }

  a.nav-link.active::after {
    position: absolute;
    bottom: 7px;
    left: 50%;

    width: 4px;
    height: 4px;

    border-radius: 50%;
    background: #b7ff00;

    box-shadow: 0 0 8px rgba(183, 255, 0, 0.7);

    content: '';
    transform: translateX(-50%);
  }

  a.nav-link[data-nav-link-pending]::after {
    position: absolute;
    bottom: 7px;
    left: 50%;

    width: 4px;
    height: 4px;

    border-radius: 50%;
    background: #b7ff00;

    content: '';
    transform: translateX(-50%);

    animation: nav-pending-pulse 620ms ease-in-out infinite alternate;
  }

  .nav-link-placeholder {
    color: #62665f;
    cursor: default;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /*
   * Search驍ｵ・ｺ繝ｻ・ｰ驍ｵ・ｺ髫ｨ・ｬ繝ｻ・ｮ闕ｵ譏ｶ繝ｻ驍ｵ・ｲ郢晢ｽｻ
   * 髯ｷ蛹ｻ縺疎vfolio驍ｵ・ｺ繝ｻ・ｮ髯樊ｻゑｽｽ・ｧ驍ｵ・ｺ鬮ｦ・ｪ遶企・・ｹ・ｧ繝ｻ・ｫ驛｢譎｢・ｽ・ｼ驛｢譎牙愛隨渉驛｢・ｧ陷ｻ蝓滂ｽ､蟶ｷ・ｸ・ｺ陋ｹ・ｻ繝ｻ迢暦ｽｸ・ｲ郢晢ｽｻ
   */
  .nav-actions :global(button),
  .nav-actions :global(a) {
    border-color: rgba(255, 255, 255, 0.08);
  }

  .mobile-menu-toggle,
  .nav-actions .toc-action {
    display: none;
  }

  @media (max-width: 720px) {
    .blog-top-nav {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 12px;

      width: calc(100% - 24px);
      min-height: 62px;

      background: rgba(5, 5, 5, 0.94);
    }

    .nav-links {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-grid;
      place-items: center;

      width: 40px;
      height: 40px;
      padding: 0;

      border: 0;
      background: transparent;
      color: #f5f5f2;
    }

    .brand {
      transform: translateX(48px);
    min-width: 0;
      font-size: 0.94rem;
    }

    .brand-title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    
      font-weight: 350;
      letter-spacing: 0.28em;

}

    .nav-actions {
      gap: 4px;
    }

    .nav-actions .toc-action {
      display: inline-grid;
    }

    .mobile-menu-panel {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;

      display: grid;

      min-width: min(280px, calc(100vw - 24px));
      gap: 4px;

      padding: 10px;

      border: 1px solid rgba(183, 255, 0, 0.12);
      border-radius: 10px;

      background: rgba(5, 5, 5, 0.97);
      backdrop-filter: blur(20px);

      opacity: 0;
      pointer-events: none;

      transform: translateY(-6px);

      transition:
        opacity 180ms ease,
        transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mobile-toc-panel {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;

      display: grid;

      width: min(300px, calc(100vw - 24px));
      max-height: min(52vh, 420px);

      gap: 8px;
      overflow: auto;
      padding: 10px;

      border: 1px solid rgba(183, 255, 0, 0.12);
      border-radius: 10px;

      background: rgba(5, 5, 5, 0.97);

      opacity: 0;
      pointer-events: none;

      transform: translateY(-6px);

      transition:
        opacity 180ms ease,
        transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .blog-top-nav[data-mobile-menu-open='true'] .mobile-menu-panel,
    .blog-top-nav[data-mobile-toc-open='true'] .mobile-toc-panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mobile-menu-link {
      display: flex;
      align-items: center;

      min-height: 44px;
      padding: 10px 12px;

      border-radius: 7px;

      color: #a8aaa4;

      font-size: 0.92rem;
      font-weight: 600;

      transition:
        color 200ms ease,
        background 200ms ease;
    }

    .mobile-menu-link:hover,
    .mobile-menu-link.active,
    .mobile-menu-link[data-nav-link-pending] {
      background: rgba(183, 255, 0, 0.07);
      color: #b7ff00;
    }

    .mobile-menu-placeholder {
      color: #62665f;
    }

    .mobile-toc-panel p {
      margin: 0;
      padding: 2px 2px 4px;

      color: #777b74;

      font-size: 0.72rem;
      font-weight: 700;

      text-transform: uppercase;
    }
  }

  @media (min-width: 721px) {
    .nav-actions .toc-action {
      display: none;
    }
  }

  @keyframes nav-pending-pulse {
    from {
      opacity: 0.35;
      transform: translateX(-50%) scale(0.8);
    }

    to {
      opacity: 1;
      transform: translateX(-50%) scale(1.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-top-nav,
    a.nav-link::before,
    .brand-mark {
    position: relative;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .brand-mark > span {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b7ff00;
    box-shadow:
      0 0 5px rgba(183, 255, 0, 0.72),
      0 0 12px rgba(183, 255, 0, 0.20);
    transition:
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 320ms ease;
  }

  .brand-mark > span:nth-child(1) {
