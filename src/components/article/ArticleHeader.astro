<style is:global>
  .nexus-editor-action-toast {
    position: fixed;
    right: 22px;
    bottom: 24px;
    z-index: 99999;

    max-width: min(360px, calc(100vw - 32px));

    padding: 11px 14px;

    border:
      1px solid
      rgba(183, 255, 0, 0.28);

    border-radius: 5px;

    background:
      rgba(8, 9, 8, 0.97);

    color:
      rgba(225, 228, 221, 0.94);

    font-family:
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;

    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.45;

    box-shadow:
      0 12px 34px
      rgba(0, 0, 0, 0.42);

    opacity: 0;

    transform:
      translateY(8px);

    pointer-events: none;

    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .nexus-editor-action-toast.is-visible {
    opacity: 1;

    transform:
      translateY(0);
  }

  .nexus-editor-action-toast.is-danger {
    border-color:
      rgba(255, 92, 92, 0.38);

    color:
      rgba(255, 135, 135, 0.96);
  }
</style>

<script is:inline>
(() => {

  if (
    window.__nexusEditorActionBridge
  ) {
    return;
  }

  window.__nexusEditorActionBridge =
    true;


  let toastTimer = null;


  const cleanPageUrl = () => {

    const url =
      new URL(
        window.location.href
      );

    /*
     * 管理確認用パラメータを
     * Copy / Share には含めない。
     */
    url.searchParams.delete(
      'editor'
    );

    return url.href;
  };


  const getToast = () => {

    let toast =
      document.querySelector(
        '.nexus-editor-action-toast'
      );

    if (toast) {
      return toast;
    }

    toast =
      document.createElement(
        'div'
      );

    toast.className =
      'nexus-editor-action-toast';

    toast.setAttribute(
      'role',
      'status'
    );

    toast.setAttribute(
      'aria-live',
      'polite'
    );

    document.body.appendChild(
      toast
    );

    return toast;
  };


  const showToast = (
    message,
    danger = false
  ) => {

    const toast =
      getToast();

    toast.textContent =
      message;

    toast.classList.toggle(
      'is-danger',
      danger
    );

    toast.classList.add(
      'is-visible'
    );

    if (toastTimer) {
      clearTimeout(
        toastTimer
      );
    }

    toastTimer =
      setTimeout(() => {

        toast.classList.remove(
          'is-visible'
        );

      }, 2200);
  };


  const copyText = async (
    text
  ) => {

    if (
      navigator.clipboard &&
      window.isSecureContext
    ) {

      await navigator.clipboard.writeText(
        text
      );

      return;
    }

    const textarea =
      document.createElement(
        'textarea'
      );

    textarea.value =
      text;

    textarea.style.position =
      'fixed';

    textarea.style.opacity =
      '0';

    document.body.appendChild(
      textarea
    );

    textarea.focus();
    textarea.select();

    document.execCommand(
      'copy'
    );

    textarea.remove();
  };


  const normaliseLabel = (
    element
  ) => {

    return (
      element?.textContent ||
      ''
    )
      .replace(
        /\s+/g,
        ' '
      )
      .trim();
  };


  /*
   * capture=true:
   * 既存メニュースクリプトより先に
   * Copy / Share / CMS待ち操作を処理する。
   */
  window.addEventListener(
    'click',
    async (event) => {

      const target =
        event.target;

      if (
        !(target instanceof Element)
      ) {
        return;
      }

      const action =
        target.closest(
          'button, a'
        );

      if (!action) {
        return;
      }

      /*
       * 記事上部の三点メニュー以外は対象外。
       */
      const inArticleMenu =
        action.closest(
          '.editorial-menu-panel, .editor-admin-menu-block, [data-editorial-menu-panel]'
        );

      if (!inArticleMenu) {
        return;
      }

      const adminAction = action.closest('[data-nexus-admin-action]');

      if (adminAction) {
        event.preventDefault();
        event.stopPropagation();

        if (!['localhost', '127.0.0.1'].includes(window.location.hostname)) return;

        const kind = adminAction.dataset.nexusAdminAction;
        const messages = {
          pin: adminAction.dataset.nexusSticky === 'true' ? 'TinaCMSで Sticky をオフにして Save を押してください。' : 'TinaCMSで Sticky をオンにして Save を押してください。',
          draft: 'TinaCMSで Draft をオンにして Save を押してください。',
          delete: 'TinaCMSの編集画面で Delete を実行してください。'
        };

        if (kind === 'delete' &&
            !window.confirm('削除操作のためTinaCMSを開きます。続けますか？')) return;

        if (messages[kind]) window.alert(messages[kind]);

        window.location.assign(adminAction.href);
        return;
      }
      const label =
        normaliseLabel(
          action
        );


      /* =====================================
         COPY LINK — 完全動作
         ===================================== */

      if (
        label === 'Copy Link'
      ) {

        event.preventDefault();
        event.stopPropagation();

        try {

          await copyText(
            cleanPageUrl()
          );

          showToast(
            'Link copied'
          );

        } catch (_) {

          showToast(
            'Could not copy link',
            true
          );

        }

        return;
      }


      /* =====================================
         SHARE — 完全動作
         ===================================== */

      if (
        label === 'Share'
      ) {

        event.preventDefault();
        event.stopPropagation();

        const shareData = {
          title:
            document.title,

          url:
            cleanPageUrl()
        };

        if (
          typeof navigator.share ===
          'function'
        ) {

          try {

            await navigator.share(
              shareData
            );

          } catch (error) {

            /*
             * ユーザー自身がShare UIを閉じた場合は
             * エラー表示しない。
             */
            if (
              error?.name !==
              'AbortError'
            ) {

              showToast(
                'Share failed',
                true
              );
            }
          }

          return;
        }

        try {

          await copyText(
            shareData.url
          );

          showToast(
            'Share link copied'
          );

        } catch (_) {

          showToast(
            'Share is unavailable',
            true
          );
        }

        return;
      }


      /* =====================================
         CMS接続後に永続化する操作
         ===================================== */

      if (
        label ===
        'Pin to profile'
      ) {

        event.preventDefault();
        event.stopPropagation();

        showToast(
          'Pinning will be enabled when TinaCMS is connected.'
        );

        return;
      }


      if (
        label ===
        'Edit'
      ) {

        event.preventDefault();
        event.stopPropagation();

        showToast(
          'Editing will be enabled when TinaCMS is connected.'
        );

        return;
      }


      if (
        label ===
        'Revert to draft'
      ) {

        event.preventDefault();
        event.stopPropagation();

        showToast(
          'Draft control will be enabled when TinaCMS is connected.'
        );

        return;
      }


      if (
        label ===
        'Delete'
      ) {

        event.preventDefault();
        event.stopPropagation();

        showToast(
          'Delete will be enabled when TinaCMS is connected.',
          true
        );

        return;
      }

    },
    true
  );

})();
</script>

<!-- NEXUS EDITOR ACTION BRIDGE END -->
