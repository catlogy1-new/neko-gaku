<script is:inline>
(() => {

  const closeMenus = () => {

    document
      .querySelectorAll('[data-editorial-menu-panel]')
      .forEach((panel) => {
        panel.hidden = true;
      });

    document
      .querySelectorAll('[data-editorial-menu-trigger]')
      .forEach((button) => {
        button.setAttribute(
          'aria-expanded',
          'false'
        );
      });

  };


  const editorMode = () => {
    return window.location.hostname === 'localhost' ||
      window.location.hostname === '127.0.0.1';
  };


  const init = () => {

    const editing =
      editorMode();

    document
      .querySelectorAll('[data-editorial-controls]')
      .forEach((root) => {

        const publicMenu =
          root.querySelector(
            '[data-editorial-public-menu]'
          );

        const editorMenu =
          root.querySelector(
            '[data-editorial-editor-menu]'
          );

        if (publicMenu) {
          publicMenu.hidden = editing;
        }

        if (editorMenu) {
          editorMenu.hidden = !editing;
        }

      });

  };


  if (!window.__nexusHeaderControlsBound) {

    window.__nexusHeaderControlsBound = true;


    document.addEventListener(
      'click',
      async (event) => {

        const target = event.target;

        if (!(target instanceof Element)) {
          return;
        }


        const trigger =
          target.closest(
            '[data-editorial-menu-trigger]'
          );

        if (trigger) {

          const root =
            trigger.closest(
              '[data-editorial-controls]'
            );

          const panel =
            root?.querySelector(
              '[data-editorial-menu-panel]'
            );

          if (!panel) return;

          const open =
            panel.hidden;

          closeMenus();

          panel.hidden = !open;

          trigger.setAttribute(
            'aria-expanded',
            open ? 'true' : 'false'
          );

          return;
        }


        const copy =
          target.closest(
            '[data-editorial-copy]'
          );

        if (copy) {

          try {

            await navigator.clipboard.writeText(
              window.location.href
            );

            copy.textContent = 'Copied';

            setTimeout(() => {
              copy.textContent = 'Copy Link';
            }, 1000);

          } catch (_) {}

          return;
        }


        const share =
          target.closest(
            '[data-editorial-share]'
          );

        if (share) {

          if (navigator.share) {

            try {

              await navigator.share({
                title: document.title,
                url: window.location.href
              });

            } catch (_) {}

          } else {

            try {

              await navigator.clipboard.writeText(
                window.location.href
              );

            } catch (_) {}

          }

          closeMenus();

          return;
        }


        const draft =
          target.closest(
            '[data-editorial-draft]'
          );

        if (draft) {

          const root =
            draft.closest(
              '[data-editorial-controls]'
            );

          const href =
            root?.dataset.editorHref;

          if (
            href &&
            confirm(
              'Open the editor to move this article to draft?'
            )
          ) {

            sessionStorage.setItem(
              'nexus-editor-intent',
              'draft'
            );

            window.location.href = href;
          }

          return;
        }


        const del =
          target.closest(
            '[data-editorial-delete]'
          );

        if (del) {

          const root =
            del.closest(
              '[data-editorial-controls]'
            );

          const href =
            root?.dataset.editorHref;

          if (
            href &&
            confirm(
              'Open the editor to delete this article?'
            )
          ) {

            sessionStorage.setItem(
              'nexus-editor-intent',
              'delete'
            );

            window.location.href = href;
          }

          return;
        }


        const languageButton = target.closest('[data-japanese-original]');
        if (languageButton) {
          const controls = languageButton.closest('[data-editorial-controls]');
          const article = controls?.closest('article');
          const heading = article?.querySelector('.editorial-heading > h1');
          const subtitle = article?.querySelector('.editorial-subtitle');
          const englishBody = article?.querySelector('#article-start');
          const japaneseBody = article?.querySelector('#article-start-ja');
          if (!heading || !englishBody || !controls) return;
          if (!japaneseBody) {
            window.alert('この記事の日本語訳はまだ登録されていません。');
            return;
          }

          if (!heading.hasAttribute('data-original-title')) {
            heading.dataset.originalTitle = heading.textContent || '';
          }
          if (subtitle && !subtitle.hasAttribute('data-original-description')) {
            subtitle.dataset.originalDescription = subtitle.textContent || '';
          }
          if (!document.documentElement.hasAttribute('data-nexus-original-lang')) {
            document.documentElement.dataset.nexusOriginalLang = document.documentElement.lang;
          }

          const showJapanese = languageButton.dataset.currentLang !== 'ja';
          heading.textContent = showJapanese
            ? (controls.dataset.jaTitle || '')
            : (heading.dataset.originalTitle || '');
          if (subtitle) {
            subtitle.textContent = showJapanese
              ? (controls.dataset.jaDescription || '')
              : (subtitle.dataset.originalDescription || '');
          }
          englishBody.hidden = showJapanese;
          japaneseBody.hidden = !showJapanese;
          const toc = article.querySelector('.mobile-article-toc');
          if (toc) toc.hidden = showJapanese;
          languageButton.dataset.currentLang = showJapanese ? 'ja' : 'en';
          languageButton.textContent = showJapanese ? 'English' : '日本語';
          languageButton.setAttribute('aria-label',
            showJapanese ? 'Show English original' : '日本語訳を表示');
          document.documentElement.lang = showJapanese
            ? 'ja'
            : (document.documentElement.dataset.nexusOriginalLang || 'en');
          heading.classList.toggle('nexus-title-japanese',
            /[\u3040-\u30ff\u3400-\u9fff]/.test(heading.textContent || ''));
          closeMenus();
          return;
        }


        if (
          !target.closest(
            '[data-editorial-menu-panel]'
          )
        ) {
          closeMenus();
        }

      }
    );


    document.addEventListener(
      'keydown',
      (event) => {

        if (event.key === 'Escape') {
          closeMenus();
        }

      }
    );


    document.addEventListener(
      'astro:page-load',
      init
    );

  }


  init();

})();
</script>

