---
import SmartImage from '../SmartImage.astro';
import PageView from '../comments/PageView.astro';
import FormattedDate from '../FormattedDate.astro';
import Icon from '../Icon.astro';
import MetadataItem from '../MetadataItem.astro';
import { getSiteConfig } from '../../data/site';
import { slugifyGroupName } from '../../utils/content-groups';
import { getUiText } from '../../utils/ui-text';

type TagLink = string | { name: string; slug: string };

interface Props {
  title: string;
  description?: string;
  date?: Date;
  wordCount: number;
  readingTime: string;
  tags?: TagLink[];
  categories?: { name: string; slug: string }[];
  series?: { name: string; slug: string; current?: number; total?: number }[];
  heroImage?: ImageMetadata | string;
  showHeroImage?: boolean;
  variant?: 'default' | 'archive';
  kicker?: string;
  note?: string;
  pathname?: string;
  showPageView?: boolean;
}

const {
  title,
  description,
  date,
  wordCount,
  readingTime,
  tags = [],
  categories = [],
  series = [],
  heroImage,
  showHeroImage = true,
  variant = 'default',
  kicker = 'Notebook entry',
  note,
  pathname = Astro.url.pathname,
  showPageView = false,
} = Astro.props;
const tagLinks = tags.map((tag) =>
  typeof tag === 'string' ? { name: tag, slug: slugifyGroupName(tag) } : tag,
);
const hasTags = tagLinks.length > 0;
const hasCategories = categories.length > 0;
const hasSeries = series.length > 0;
const hasGroups = hasCategories || hasSeries;
const isArchiveHeader = variant === 'archive';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const ui = getUiText(await getSiteConfig());
const wordCountLabel = ui.article.wordCount(wordCount);
---

<header
  class:list={[
    'article-header',
    { 'article-header-archive': isArchiveHeader, 'archive-header-shared': isArchiveHeader },
  ]}
>
  {
    isArchiveHeader ? (
      <>
        <div class="archive-heading archive-header-main">
          <p class="archive-kicker">{kicker}</p>
          <h1 class="archive-title" data-pagefind-meta="title">
            {title}
          </h1>
          <div class="meta-line" aria-label={ui.article.metadata}>
            {date && (
              <MetadataItem kind="date" separated={false}>
                <FormattedDate date={date} />
              </MetadataItem>
            )}
            <MetadataItem kind="words" separated={Boolean(date)}>
              {wordCountLabel}
            </MetadataItem>
            <MetadataItem kind="reading">{readingTime}</MetadataItem>
            {showPageView && <PageView pathname={pathname} />}
            {hasTags && (
              <MetadataItem kind="tags" class="tag-list">
                {tagLinks.map((tag) => (
                  <a class="tag" href={`${basePath}/tags/${tag.slug}/`}>
                    #{tag.name}
                  </a>
                ))}
              </MetadataItem>
            )}
          </div>
          {hasGroups && (
            <div class="group-meta-line" aria-label={ui.article.groups}>
              {hasCategories && (
                <span class="group-meta-item">
                  <Icon name="folder" size={15} />
                  <span class="group-label">{ui.groups.categories}</span>
                  <span class="group-list">
                    {categories.map((category) => (
                      <a class="group-link" href={`${basePath}/blog/categories/${category.slug}/`}>
                        {category.name}
                      </a>
                    ))}
                  </span>
                </span>
              )}
              {hasSeries && (
                <span class="group-meta-item">
                  <Icon name="layers" size={15} />
                  <span class="group-label">{ui.groups.series}</span>
                  <span class="group-list">
                    {series.map((item) => (
                      <a class="group-link" href={`${basePath}/blog/series/${item.slug}/`}>
                        {item.name}
                        {item.current && item.total ? ` ${item.current}/${item.total}` : ''}
                      </a>
                    ))}
                  </span>
                </span>
              )}
            </div>
          )}
        </div>
        {(description || note) && (
          <div class="archive-copy">
            {description && <p class="archive-subtitle">{description}</p>}
            {note && <p class="archive-note">{note}</p>}
          </div>
        )}
      </>
    ) : (
      <>
        {
          showHeroImage && heroImage && (
            <figure class="article-hero-image editorial-hero">
              <SmartImage width={1200} height={800} src={heroImage} alt="" />
            </figure>
          )
        }

        <div class="editorial-heading">
          <p class="editorial-kicker">{kicker}</p>

          <h1 data-pagefind-meta="title">{title}</h1>

          {description && (
            <p class="editorial-subtitle">{description}</p>
          )}

          <div class="editorial-author-row">
            <div class="editorial-author">
              <div class="editorial-avatar" aria-hidden="true">N</div>

              <div class="editorial-author-info">
                <span class="editorial-author-name">NEXUS</span>

                {date && (
                  <span class="editorial-published">
                    <FormattedDate date={date} />
                  </span>
                )}
              </div>
            </div>

            <button
              class="editorial-menu"
              type="button"
              aria-label="Article menu"
              title="Article menu"
            >
              <span></span>
              <span></span>
              <span></span>
            </button>
          </div>
        </div>
      </>
    )
  }
</header>

<style>
  .article-header {
    display: grid;
    gap: 14px;
    width: 100%;
