    font-family: var(--font-page-heading);
  }

  .archive-heading .meta-line {
    margin-top: 14px;
  }

  .meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 6px;
    color: var(--paper-ink-faint);
    font-family: var(--font-meta);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.5;
  }

  :global(.tag-list .metadata-content) {
    flex-wrap: wrap;
    column-gap: 8px;
    row-gap: 6px;
  }

  .tag {
    color: var(--paper-accent);
    font-family: var(--font-meta);
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .tag:hover {
    color: var(--paper-ink);
  }

  .tag:focus-visible,
  .group-link:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--paper-line-strong);
    outline-offset: 3px;
  }

  .group-meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-top: 8px;
    color: var(--paper-ink-faint);
    font-family: var(--font-meta);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .group-meta-item {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    min-height: 30px;
    padding: 4px 8px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    background: var(--paper-control);
  }

  .group-meta-item :global(.site-icon) {
    color: var(--paper-accent);
    opacity: 0.82;
  }

  .group-label {
    color: var(--paper-ink-faint);
  }

  .group-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .group-link {
    color: var(--paper-accent);
    font-family: var(--font-serif-cn);
    font-weight: 700;
    text-decoration-color: rgba(102, 125, 109, 0.25);
    text-underline-offset: 3px;
  }

  .group-link + .group-link::before {
    margin: 0 6px 0 0;
    color: var(--paper-ink-faint);
    content: '\00b7';
  }

  .article-hero-image {
    width: 100%;
    height: 84px;
    margin: 10px 0 0;
    overflow: hidden;
    border: 1px solid var(--paper-line);
    border-radius: 7px;
    background: var(--paper-surface-muted);
  }

  .article-hero-image :global(img) {
    display: block;
    width: 100%;
    height: 84px;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    filter: saturate(0.72) contrast(0.96);
  }

  @media (max-width: 640px) {
    .article-header {
      gap: 12px;
      margin-bottom: 30px;
    }

    .article-header-archive {
      margin-bottom: 34px;
    }

    h1 {
      font-size: 2.08rem;
      line-height: 1.1;
    }

    .article-hero-image,
    .article-hero-image :global(img) {
      height: 84px;
      border-radius: 6px;
    }
  }
</style>


