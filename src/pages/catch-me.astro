  </main>

  <script>
    function requireElement(id: string): HTMLElement {
      const element = document.getElementById(id);

      if (!(element instanceof HTMLElement)) {
        throw new Error(`Missing HTML element: ${id}`);
      }

      return element;
    }

    const opening = requireElement('opening');
    const en = requireElement('opening-en');
    const ja = requireElement('opening-ja');
    const stream = requireElement('stream');
    const swarm = requireElement('swarm');
    const flash = requireElement('flash');

    const lineEN =
      'Being categorized, that is synonymous with death to me.';

    const lineJA =
      'カテゴライズされること、それは僕にとって死と同義だ。';

    let index = 0;

    en.classList.add('cursor');
    ja.classList.add('cursor');

    const typing = setInterval(() => {
      index++;

      en.textContent = lineEN.slice(0, index);
      ja.textContent = lineJA.slice(0, index);

      if (index >= Math.max(lineEN.length, lineJA.length)) {
        clearInterval(typing);

        en.textContent = lineEN;
        ja.textContent = lineJA;

        en.classList.remove('cursor');
        ja.classList.remove('cursor');

        setTimeout(beginStream, 1100);
      }
    }, 92);

    let beginStream = function () {

      opening.style.transition =
        'transform 2.2s linear, opacity 1.4s ease';

      opening.style.transform =
        'translate(-50%, -170vh)';

      opening.style.opacity = '0';

      stream.classList.add('running');

      /*
        最後の「み」が流れ切る
      */
      setTimeout(() => {

        opening.style.display = 'none';
        stream.style.display = 'none';

        /*
          真っ暗な画面で一呼吸
        */
        setTimeout(() => {

          flash.classList.add('fire');

          /*
            フラッシュしたらほぼ即Google
          */
          setTimeout(() => {
            window.location.href =
              'https://www.google.com/';
          }, 160);

        }, 600);

      }, 28100);
    }

    const swarmA = [
      '言語','language','langue','Sprache','lingua','idioma',
      '语言','語言','언어','язык','لغة','שפה','भाषा','γλώσσα',
      'dil','bahasa','język','língua','parole','mot','word',
      'sign','zeichen','signe','私','僕','俺','我','I','me',
      'moi','ich','yo','ego','je','أنا','나','मैं','я',
      '名前','分類','category','identity','identité','identidad',
      'identität','存在','absence','null','意味','無意味',
      'meaning','nothing','nada','rien','нет','無','없음',
      '誰','何','どこ','when','why','syntax','voice','body',
      'death','生','死','記号','差異','difference','fragment',
      '断片','error','404','∞','∴','∵','0','silence',
      'noise','inside','outside','before','after','other',
      'autre','ailleurs','空白','境界','境界線','subject',
      'object','memory','忘却','trace','痕跡','echo','声',
      '文字','文','文法','grammar','code','破片','void'
    ];

    const swarmB = [
      'は','が','を','に','から','まで','そして','でも',
      'ではない','かもしれない','/','//','///','...',
      '?','!','::','—','≠','=','→','←','↯','×','+',
      'without','inside','outside','under','over','against',
      'sans','avec','oder','und','nicht','без','между',
      'の外','の中','以前','以後','誰でもない',
      '名前のない','分類不能','未定義','壊れた',
      'lost','unknown','undefined','unwritten','elsewhere'
    ];

    function buildFragments(total: number) {

      /*
        意味を持たない固定文字列。
        リロードしても同じ内容・同じ順番。
        読解できる自然言語はここでは完全に捨てる。
      */

      const roots = [
        'zrq','vla','qev','nrx','thæ','kru','xai','vø',
        'mzk','qra','tze','nuv','vræ','xel','ghu','zai',
        'qlø','rva','tzm','khæ','vru','xen','qzi','næl',

        'ヌァ','ヴェク','ゾル','キュァ','レヌ','グァ','ツェ','ミュ',
        'ヲァ','ネュ','ヴォ','ギェ','ルァ','ゼヌ','クェ','ヒュ',

        'ぬぇ','ゐゃ','ほぬ','ゑら','ぎゅあ','ねを','ふぇぬ','るぁ',
        'ぢょ','ゔぁ','へゅ','むぇ','をぬ','ゐろ','ぐぇ','ぬゃ',
        'ぞゑ','ひょぬ','ゔぇ','らゐ','けゅ','ぬを','しゃゑ','みぁ',
        'ゑぬ','ろゃ','びぇ','ふょ','ぬゐ','がぇ','ちゅゑ','ほゃ',
        'あゑぬ','ぬらゐ','ゐゅえ','そぬぁ','へゑろ','むゃぬ','をぇ',
        'ぬぬゑ','ゐらぬ','ほぇゃ','ゔぬゐ','ゃぬろ','ゑゑぬ'
      ];

      const fractures = [
        '::','//','_','..','///','-','≠','∴',
        '∆','⌁','⸮','⟟','∵','⋮','×','⌿',
        '゠','〻','ヽ','ヾ','々','〽','ゝ','※'
      ];

      const tails = [
        'x','q','zr','vv','kt','æ','ø','Ʌ',
        'ʒ','ŋ','χ','ɸ','ɯ','ɬ','ʀ','ʁ',
        'ヌ','ヶ','ヰ','ヱ','ゑ','ヿ','ヵ','ヽ'
      ];

      const result = [];

      for (let i = 0; i < total; i++) {

        const a =
          roots[(i * 7 + 3) % roots.length];

        const b =
          roots[(i * 13 + 11) % roots.length];

        const c =
          fractures[(i * 5 + 2) % fractures.length];

        const d =
          tails[(i * 17 + 7) % tails.length];

        const mode = i % 7;

        let value;

        if (mode === 0) {
          value = `${a}${c}${b}${d}`;
        }
        else if (mode === 1) {
          value = `${d}${a}${a}${c}${b}`;
        }
        else if (mode === 2) {
          value = `${a}${d}${c}${c}${b}`;
        }
        else if (mode === 3) {
          value = `${c}${a}${b}${d}${a}`;
        }
        else if (mode === 4) {
          value = `${a}${c}${d}${b}${c}`;
        }
        else if (mode === 5) {
          value = `${d}${c}${a}${b}${b}`;
        }
        else {
          value = `${a}${b}${c}${d}${d}${a}`;
        }

        result.push(value);
      }

      return result;
    }

    function beginSwarm() {

      swarm.classList.add('active');
      swarm.innerHTML = '';

      const fragments = buildFragments(900);

      fragments.forEach((fragment, i) => {

        const word = document.createElement('span');

        word.className = 'swarm-word';
        word.textContent = fragment;

        /*
          ランダムではなく固定計算。
          毎回ほぼ同じ崩壊画面になる。
        */

        const x = ((i * 19 + (i % 7) * 13) % 106) - 3;
        const y = ((i * 29 + (i % 11) * 17) % 104) - 2;

        word.style.left = `${x}%`;
        word.style.top  = `${y}%`;

        /*
          小さい本文文字から巨大文字まで。
        */

        const sizePattern = i % 17;

        let size;

        if (sizePattern < 8) {
          size = 12 + ((i * 7) % 19);
        }
        else if (sizePattern < 13) {
          size = 31 + ((i * 11) % 42);
        }
        else if (sizePattern < 16) {
          size = 74 + ((i * 13) % 68);
        }
        else {
          size = 165 + ((i * 17) % 120);
        }

        word.style.fontSize = `${size}px`;

        /*
          方向をバラバラにする。
        */

        const angles = [
          -78, 43, -16, 91, 7,
          -39, 67, -5, 128, -62,
          22, -104, 51, 3, 76,
          -27, 146, -48, 14
        ];

        const angle =
          angles[i % angles.length];

        /*
          縦書きもかなり混ぜる。
        */

        if (i % 5 === 0 || i % 11 === 0) {
          word.style.writingMode = 'vertical-rl';
          word.style.textOrientation = 'mixed';
        }

        /*
          一部は文字間隔まで壊す。
        */

        if (i % 9 === 0) {
          word.style.letterSpacing = '-0.22em';
        }

        if (i % 13 === 0) {
          word.style.letterSpacing = '0.7em';
        }

        word.style.fontWeight =
          i % 6 === 0 ? '700' : '400';

        word.style.lineHeight = '.78';

        word.style.whiteSpace = 'nowrap';

        word.style.zIndex =
          String(1 + (i % 12));

        word.style.opacity = '0';

        word.style.filter = 'blur(12px)';

        word.style.transform =
          `rotate(${angle}deg) scale(.05)`;

        /*
          CSS側の古い左右移動を完全停止。
        */

        word.style.animation = 'none';

        swarm.appendChild(word);

        /*
          「飛んでくる」のではなく
          その場所から発生する。

          文字同士は意図的に重なる。
        */

        const birth =
          (i * 23) % 1450;

        const duration =
          380 + ((i * 31) % 520);

        setTimeout(() => {

          word.animate(
            [
              {
                opacity: 0,
                filter: 'blur(16px)',
                transform:
                  `rotate(${angle - 35}deg) scale(.02)`
              },

              {
                opacity: .75,
                filter: 'blur(3px)',
                transform:
                  `rotate(${angle + 8}deg) scale(1.28)`,
                offset: .62
              },

              {
                opacity:
                  .38 + ((i % 7) / 10),

                filter: 'blur(0px)',

                transform:
                  `rotate(${angle}deg) scale(1)`
              }
            ],
            {
              duration,
              easing:
                'cubic-bezier(.15,.85,.18,1)',
              fill: 'forwards'
            }
          );

        }, birth);

      });

      /*
        長く見せない。
        文字が急速に湧く
        → 埋まる
        → 即フラッシュ
        → Google
      */

      setTimeout(() => {

        flash.classList.add('fire');

        setTimeout(() => {
          window.location.href =
            'https://www.google.com/';
        }, 180);

      }, 2600);
    }

    /* CATCH-ME BEGIN STREAM V3 */

    beginStream = function () {

      opening.style.transition =
        'transform 2.2s linear, opacity 1.4s ease';

      opening.style.transform =
        'translate(-50%, -170vh)';

      opening.style.opacity = '0';

      stream.classList.add('running');

      stream.addEventListener(
        'animationend',
        () => {

          /*
            この時点で「み」も完全に消えている。
          */

          opening.style.display = 'none';
          stream.style.display = 'none';

          /*
            真っ黒のまま一呼吸。
          */

          setTimeout(() => {

            flash.classList.add('fire');

            /*
              白フラッシュ直後にGoogle。
            */

            setTimeout(() => {

              window.location.href =
                'https://www.google.com/';

            }, 160);

          }, 250);

        },
        { once: true }
      );
    };
</script>
</body>
</html>