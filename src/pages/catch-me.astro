<body>
  <main id="stage">

    <section id="opening">
      <p id="opening-en"></p>
      <p id="opening-ja"></p>
    </section>

    <section id="stream">

      <!-- 写真1 -->
      <div class="panel p1">
        <span class="fragment a">言</span>
        <span class="fragment b">語</span>
        <span class="fragment c">とは</span>
        <span class="fragment d">ただ　の</span>
        <span class="fragment e">パズル</span>
      </div>

      <!-- 写真2 -->
      <div class="panel p2">
        <span class="fragment a">ゲーム</span>
        <span class="fragment b">に過ぎ</span>
        <span class="fragment c">ない</span>
        <span class="fragment d">Language</span>
        <span class="fragment e">is</span>
        <span class="fragment f">merely a</span>
      </div>

      <!-- 写真3 -->
      <div class="panel p3">
        <span class="fragment a">puzzle</span>
        <span class="fragment b">game</span>
        <span class="fragment c">&lt;僕&gt;</span>
        <span class="fragment d">など</span>
        <span class="fragment e">ないんだ</span>
        <span class="fragment f">There is</span>
      </div>

      <!-- 写真4 -->
      <div class="panel p4">
        <span class="fragment a">thing</span>
        <span class="fragment b">no such</span>
        <span class="fragment c">as a</span>
        <span class="fragment d">'me'.</span>
      </div>

      <!-- 'me'. 以降：言語の解体 -->

      <!-- まず3文字。まだ空白はそれほど大きくしない -->
      <div class="decay-pre decay-pre-1">
        <span class="fragment pre-a">※</span>
        <span class="fragment pre-b">q</span>
        <span class="fragment pre-c">ぬ</span>
      </div>

      <!-- 次は2文字。空白が増える -->
      <div class="decay-pre decay-pre-2">
        <span class="fragment pre-d">ゑ</span>
        <span class="fragment pre-e">か</span>
      </div>

      <!-- 最後：指定された並び -->
      <div class="final-decay">
        <span class="fragment final-6">み</span>
      </div>
</section>
    <section id="swarm" aria-hidden="true"></section>
