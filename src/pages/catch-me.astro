<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>You can't catch me</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #000;
      color: #f2f2ee;
    }

    body {
      font-family:
        "Courier New",
        "Noto Sans JP",
        monospace;
    }

    #stage {
      position: fixed;
      inset: 0;
      overflow: hidden;
      background: #000;
    }

    /* ========================================================
       最初の2行
       ======================================================== */

    #opening {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 16cm;
      max-width: calc(100vw - 40px);
      transform: translate(-50%, -50%);
      z-index: 10;

      font-size: clamp(18px, 1.55vw, 25px);
      line-height: 1.8;
      letter-spacing: 0.015em;
    }

    #opening p {
      margin: 0 0 14px;
      min-height: 1.8em;
    }

    #opening-ja {
      font-family:
        "Noto Sans JP",
        sans-serif;
    }

    .cursor::after {
      content: "▋";
      margin-left: 2px;
      animation: blink 0.72s steps(1) infinite;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }

    /* ========================================================
       スクロール世界
       ======================================================== */

    #stream {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translateY(100vh);
      pointer-events: none;
    }

    #stream.running {
      opacity: 1;
      animation: streamRise 28s linear forwards;
    }

    @keyframes streamRise {
      /* 最初の意味が通る4画面はゆっくり */
      0% {
        transform: translateY(100vh);
      }

      18% {
        transform: translateY(0vh);
      }

      36% {
        transform: translateY(-100vh);
      }

      54% {
        transform: translateY(-200vh);
      }

      70% {
        transform: translateY(-300vh);
      }

      /* 'me'. 以降、一気に崩壊・加速 */
      78% {
        transform: translateY(-400vh);
      }

      85% {
        transform: translateY(-500vh);
      }

      91% {
        transform: translateY(-600vh);
      }

      100% {
        transform: translateY(-720vh);
      }
    }

    .panel {
      position: relative;
      height: 100vh;
      width: 100%;
      font-size: clamp(20px, 2vw, 30px);
    }

    .fragment {
      position: absolute;
      margin: 0;
      white-space: nowrap;
    }

    /* ---------- 写真1〜4の文言 ---------- */

    .p1 .a { left: 5%;  top: 17%; }
    .p1 .b { left: 16%; top: 51%; }
    .p1 .c { right: 12%; top: 31%; }
    .p1 .d { left: 30%; top: 68%; }
    .p1 .e { right: 16%; top: 84%; }

    .p2 .a { left: 3%; top: 9%; }
    .p2 .b { left: 32%; top: 23%; }
    .p2 .c { right: 4%; top: 36%; }
    .p2 .d { left: 6%; top: 57%; }
    .p2 .e { right: 17%; top: 76%; }
    .p2 .f { left: 25%; top: 88%; }

    .p3 .a { left: 11%; top: 13%; }
    .p3 .b { right: 11%; top: 20%; }
    .p3 .c { left: 5%; top: 39%; }
    .p3 .d { left: 26%; top: 58%; }
    .p3 .e { right: 12%; top: 79%; }
    .p3 .f { left: 31%; top: 91%; }

    .p4 .a { left: 14%; top: 15%; }
    .p4 .b { left: 67%; top: 7%; }
    .p4 .c { left: 42%; top: 52%; }
    .p4 .d { right: 8%; top: 79%; }

    /* ========================================================
       me の後：崩壊
       ======================================================== */

    .collapse {
      font-size: clamp(17px, 1.8vw, 28px);
    }

    .collapse .fragment {
      white-space: normal;
    }

    .c1 .a { left: 8%; top: 8%; transform: rotate(-3deg); }
    .c1 .b { right: 19%; top: 18%; letter-spacing: .8em; }
    .c1 .c { left: 24%; top: 43%; transform: rotate(8deg); }
    .c1 .d { right: 5%; top: 58%; font-size: 3rem; }
    .c1 .e { left: 42%; top: 78%; letter-spacing: -.15em; }

    .c2 .a { left: 3%; top: 13%; font-size: .8em; }
    .c2 .b { left: 71%; top: 6%; transform: rotate(12deg); }
    .c2 .c { left: 13%; top: 49%; letter-spacing: 1.2em; }
    .c2 .d { right: 21%; top: 61%; transform: rotate(-16deg); }
    .c2 .e { left: 48%; top: 87%; font-size: 4rem; }

    .c3 .a { left: 17%; top: 11%; transform: rotate(90deg); }
    .c3 .b { right: 4%; top: 25%; font-size: 4.5rem; }
    .c3 .c { left: 4%; top: 58%; letter-spacing: -.25em; }
    .c3 .d { left: 57%; top: 70%; transform: rotate(-8deg); }
    .c3 .e { right: 13%; top: 90%; letter-spacing: 2em; }

    /* 大きな空白 */
    .void {
      height: 145vh;
    }

    .last-char {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;

      font-family: "Noto Sans JP", sans-serif;
      font-size: clamp(26px, 3vw, 44px);
    }

    /* ========================================================
       多言語 swarm
       ======================================================== */

    #swarm {
      position: absolute;
      inset: 0;
      overflow: hidden;
      opacity: 0;
      background: #000;
      z-index: 50;
      pointer-events: none;
    }

    #swarm.active {
      opacity: 1;
    }

    .swarm-word {
      position: absolute;
      white-space: nowrap;
      line-height: .88;
      color: #f4f4ef;

      opacity: 0;
      filter: blur(12px);

      will-change:
        transform,
        opacity,
        filter;
    }

    .swarm-word.vertical {
      writing-mode: vertical-rl;
      text-orientation: mixed;
    }

    .swarm-left {
      left: 0;

      transform:
        translateX(-125%)
        rotate(var(--rotate))
        scale(.08);

      animation:
        swarmLeft var(--speed)
        cubic-bezier(.12,.82,.18,1)
        forwards;
    }

    .swarm-right {
      right: 0;

      transform:
        translateX(125%)
        rotate(var(--rotate))
        scale(.08);

      animation:
        swarmRight var(--speed)
        cubic-bezier(.12,.82,.18,1)
        forwards;
    }

    @keyframes swarmLeft {
      0% {
        opacity: 0;
        filter: blur(14px);
        transform:
          translateX(-125%)
          rotate(var(--rotate))
          scale(.05);
      }

      22% {
        opacity: .35;
        filter: blur(7px);
      }

      58% {
        opacity: 1;
        filter: blur(0);
        transform:
          translateX(calc(var(--travel) * .72))
          rotate(var(--rotate))
          scale(1.18);
      }

      100% {
        opacity: var(--opacity);
        filter: blur(0);
        transform:
          translateX(var(--travel))
          rotate(var(--rotate))
          scale(1);
      }
    }

    @keyframes swarmRight {
      0% {
        opacity: 0;
        filter: blur(14px);
        transform:
          translateX(125%)
          rotate(var(--rotate))
          scale(.05);
      }

      22% {
        opacity: .35;
        filter: blur(7px);
      }

      58% {
        opacity: 1;
        filter: blur(0);
        transform:
          translateX(calc(var(--travel) * -.72))
          rotate(var(--rotate))
          scale(1.18);
      }

      100% {
        opacity: var(--opacity);
        filter: blur(0);
        transform:
          translateX(calc(var(--travel) * -1))
          rotate(var(--rotate))
          scale(1);
      }
    }

    /* ========================================================
       フラッシュ
       ======================================================== */

    #flash {
      position: fixed;
      inset: 0;
      z-index: 999;
      background: #fff;
      opacity: 0;
      pointer-events: none;
    }

    #flash.fire {
      animation: flash 430ms ease-out forwards;
    }

    @keyframes flash {
      0%   { opacity: 0; }
      8%   { opacity: 1; }
      72%  { opacity: 1; }
      100% { opacity: 1; }
    }

    @media (max-width: 700px) {
      #opening {
        width: calc(100vw - 38px);
        font-size: 17px;
      }

      .panel {
        font-size: 19px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .cursor::after {
        animation: none;
      }
    }



