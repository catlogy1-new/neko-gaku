<script is:inline>
/* ARCHIVE HUD DIRECT MOTION JS START */

(() => {

  function initArchiveHudMotion() {

    const hud = document.querySelector('.archive-left-hud');

    if (!hud) return;

    if (hud.dataset.directMotionReady === 'true') return;

    hud.dataset.directMotionReady = 'true';


    const run = () => {

      /*
       * -----------------------------------------------
       * 1. 上のセグメントバー
       * 実際の <i> を左から順番に横へ動かす
       * -----------------------------------------------
       */

      const bars =
        hud.querySelectorAll('.archive-hud-spectrum i');

      bars.forEach((bar, index) => {

        bar.getAnimations().forEach(animation => {
          animation.cancel();
        });

        bar.animate(
          [
            {
              translate: '0 0',
              opacity: 0.72
            },
            {
              translate: '9px 0',
              opacity: 1,
              offset: 0.42
            },
            {
              translate: '0 0',
              opacity: 0.82
            }
          ],
          {
            duration: 620,
            delay: index * 85,
            easing: 'cubic-bezier(.18,.72,.28,1)',
            iterations: 1
          }
        );

      });


      /*
       * -----------------------------------------------
       * 2. 中段データバー
       * 小さいバーも順番に反応
       * -----------------------------------------------
       */

      const dataBars =
        hud.querySelectorAll('.archive-hud-data span');

      dataBars.forEach((bar, index) => {

        bar.getAnimations().forEach(animation => {
          animation.cancel();
        });

        bar.animate(
          [
            {
              translate: '0 0',
              opacity: 0.45
            },
            {
              translate: '5px 0',
              opacity: 1,
              offset: 0.45
            },
            {
              translate: '0 0',
              opacity: 0.55
            }
          ],
          {
            duration: 480,
            delay: 260 + (index * 45),
            easing: 'ease-out',
            iterations: 1
          }
        );

      });


      /*
       * -----------------------------------------------
       * 3. 斜線グラフィック
       * 実要素そのものを右へ流して戻す
       * -----------------------------------------------
       */

      const diagonal =
        hud.querySelector('.archive-hud-diagonal');

      if (diagonal) {

        diagonal.getAnimations().forEach(animation => {
          animation.cancel();
        });

        diagonal.animate(
          [
            {
              translate: '0 0',
              opacity: 0.50
            },
            {
              translate: '12px 0',
              opacity: 0.95,
              offset: 0.48
            },
            {
              translate: '0 0',
              opacity: 0.50
            }
          ],
          {
            duration: 900,
            delay: 420,
            easing: 'cubic-bezier(.18,.68,.25,1)',
            iterations: 1
          }
        );

      }


      /*
       * -----------------------------------------------
       * 4. 水平ライン上をスキャナーが走る
       * 擬似要素ではなく本物のDIVをその場で生成
       * -----------------------------------------------
       */

      const line =
        hud.querySelector('.archive-hud-line');

      if (line) {

        line
          .querySelectorAll('.archive-hud-runtime-scanner')
          .forEach(el => el.remove());

        const scanner =
          document.createElement('span');

        scanner.className =
          'archive-hud-runtime-scanner';

        scanner.style.setProperty(
          'position',
          'absolute',
          'important'
        );

        scanner.style.setProperty(
          'top',
          '-2px',
          'important'
        );

        scanner.style.setProperty(
          'left',
          '-22%',
          'important'
        );

        scanner.style.setProperty(
          'width',
          '20%',
          'important'
        );

        scanner.style.setProperty(
          'height',
          '5px',
          'important'
        );

        scanner.style.setProperty(
          'pointer-events',
          'none',
          'important'
        );

        scanner.style.setProperty(
          'background',
          'linear-gradient(90deg, transparent 0%, rgba(110,235,220,.20) 20%, rgba(110,235,220,1) 50%, rgba(183,255,0,.35) 68%, transparent 100%)',
          'important'
        );

        scanner.style.setProperty(
          'box-shadow',
          '0 0 8px rgba(110,235,220,.65), 0 0 18px rgba(110,235,220,.22)',
          'important'
        );

        scanner.style.opacity = '0';

        line.style.setProperty(
          'overflow',
          'hidden',
          'important'
        );

        line.appendChild(scanner);

        const animation =
          scanner.animate(
            [
              {
                translate: '0 0',
                opacity: 0
              },
              {
                opacity: 1,
                offset: 0.12
              },
              {
                translate: '610% 0',
                opacity: 1,
                offset: 0.82
              },
              {
                translate: '650% 0',
                opacity: 0
              }
            ],
            {
              duration: 1000,
              delay: 140,
              easing: 'cubic-bezier(.18,.72,.28,1)',
              iterations: 1
            }
          );

        animation.onfinish = () => {
          scanner.remove();
        };

      }


      /*
       * -----------------------------------------------
       * 5. LIVE FEED
       * 親要素をパルスさせるので ::after も一緒に反応
       * 色は既存ライムのまま
       * -----------------------------------------------
       */

      const status =
        hud.querySelector('.archive-hud-status');

      if (status) {

        status.getAnimations().forEach(animation => {
          animation.cancel();
        });

        status.animate(
          [
            {
              opacity: 1
            },
            {
              opacity: 0.35,
              offset: 0.30
            },
            {
              opacity: 1,
              offset: 0.55
            },
            {
              opacity: 0.65,
              offset: 0.72
            },
            {
              opacity: 1
            }
          ],
          {
            duration: 620,
            delay: 920,
            easing: 'ease-out',
            iterations: 1
          }
        );

      }

    };


    hud.addEventListener(
      'mouseenter',
      run
    );

  }


  initArchiveHudMotion();

  document.addEventListener(
    'astro:page-load',
    initArchiveHudMotion
  );

})();

/* ARCHIVE HUD DIRECT MOTION JS END */
</script>

