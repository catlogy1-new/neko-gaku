<script is:inline>
(() => {

  function initYearWheel() {

    const wheel =
      document.querySelector('[data-year-wheel]');

    if (!wheel) return;


    const windowEl =
      wheel.querySelector('.year-wheel-window');

    const options = [
      ...wheel.querySelectorAll('[data-year-option]')
    ];

    if (!windowEl || options.length === 0) {
      return;
    }


    /*
      ghost buttonsはJS側で保証。
      HTMLにすでに存在していても再利用する。
    */

    let ghostNewer =
      wheel.querySelector('[data-year-ghost-newer]');

    let ghostOlder =
      wheel.querySelector('[data-year-ghost-older]');


    if (!ghostNewer) {

      ghostNewer =
        document.createElement('button');

      ghostNewer.type = 'button';

      ghostNewer.className =
        'year-wheel-ghost year-wheel-ghost-newer';

      ghostNewer.dataset.yearGhostNewer = '';

      ghostNewer.setAttribute(
        'aria-label',
        'Newer archive year'
      );

      windowEl.prepend(
        ghostNewer
      );
    }


    if (!ghostOlder) {

      ghostOlder =
        document.createElement('button');

      ghostOlder.type = 'button';

      ghostOlder.className =
        'year-wheel-ghost year-wheel-ghost-older';

      ghostOlder.dataset.yearGhostOlder = '';

      ghostOlder.setAttribute(
        'aria-label',
        'Older archive year'
      );

      windowEl.append(
        ghostOlder
      );
    }


    const up =
      document.querySelector('[data-year-up]');

    const down =
      document.querySelector('[data-year-down]');

    const activeYear =
      document.querySelector('[data-active-year]');

    const activeCount =
      document.querySelector('[data-active-count]');

    const hudYear =
      document.querySelector('[data-hud-year]');

    const hudCount =
      document.querySelector('[data-hud-count]');


    let index = 0;


    function showYear(nextIndex) {

      nextIndex =
        Math.max(
          0,
          Math.min(
            options.length - 1,
            nextIndex
          )
        );


      index =
        nextIndex;


      const selected =
        options[index];

      if (!selected) return;


      options.forEach(
        (option, optionIndex) => {

          const active =
            optionIndex === index;

          option.classList.toggle(
            'is-active',
            active
          );

          option.setAttribute(
            'aria-pressed',
            active ? 'true' : 'false'
          );
        }
      );


      const year =
        selected.dataset.yearOption ?? '';

      const count =
        selected.dataset.yearCount ?? '00';

      const numericYear =
        Number(year);


      if (activeYear) {
        activeYear.textContent =
          year;
      }


      if (activeCount) {
        activeCount.textContent =
          count;
      }

      if (hudYear) {
        hudYear.textContent = year;
      }

      if (hudCount) {
        hudCount.textContent = count;
      }


      /*
        上下年。

        記事データがない年も数字は表示。
        実在する年だけクリック可能。
      */

      const newer =
        options[index - 1];

      const older =
        options[index + 1];


      ghostNewer.textContent =
        newer?.dataset.yearOption ??
        (
          Number.isFinite(numericYear)
            ? String(numericYear + 1)
            : ''
        );


      ghostOlder.textContent =
        older?.dataset.yearOption ??
        (
          Number.isFinite(numericYear)
            ? String(numericYear - 1)
            : ''
        );


      ghostNewer.disabled =
        !newer;

      ghostOlder.disabled =
        !older;


      document
        .querySelectorAll('[data-year-panel]')
        .forEach((panel) => {

          const active =
            panel.dataset.yearPanel === year;

          panel.hidden =
            !active;

          panel.classList.remove(
            'year-entering'
          );

          if (active) {

            void panel.offsetWidth;

            panel.classList.add(
              'year-entering'
            );
          }
        });
    }


    up?.addEventListener(
      'click',
      () => showYear(index - 1)
    );


    down?.addEventListener(
      'click',
      () => showYear(index + 1)
    );


    ghostNewer.addEventListener(
      'click',
      () => {

        if (index > 0) {
          showYear(index - 1);
        }
      }
    );


    ghostOlder.addEventListener(
      'click',
      () => {

        if (index < options.length - 1) {
          showYear(index + 1);
        }
      }
    );


    wheel.addEventListener(
      'wheel',
      (event) => {

        event.preventDefault();

        if (event.deltaY > 0) {
          showYear(index + 1);
        }

        if (event.deltaY < 0) {
          showYear(index - 1);
        }
      },
      { passive: false }
    );


    wheel.addEventListener(
      'keydown',
      (event) => {

        if (event.key === 'ArrowUp') {

          event.preventDefault();

          showYear(index - 1);
        }

        if (event.key === 'ArrowDown') {

          event.preventDefault();

          showYear(index + 1);
        }
      }
    );


    showYear(0);
  }


  initYearWheel();


  document.addEventListener(
    'astro:page-load',
    initYearWheel
  );

})();
</script>


<script is:inline>
/* YEAR WHEEL FRAME LOCK JS START */

(() => {
  function initArchiveHudFrameLock() {
    const hud = document.querySelector('.archive-left-hud');
    const shell = document.querySelector('.year-wheel-shell');

    if (!hud || !shell) return;

    if (hud.dataset.frameLockReady === 'true') return;

    hud.dataset.frameLockReady = 'true';

    hud.addEventListener(
      'mouseenter',
      () => {
        shell.classList.add('is-hud-activated');
      },
      { once: true }
    );
  }

  initArchiveHudFrameLock();

  document.addEventListener(
    'astro:page-load',
    initArchiveHudFrameLock
  );
})();

/* YEAR WHEEL FRAME LOCK JS END */
</script>




