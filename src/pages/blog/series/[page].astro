---
import '../../../styles/pagination-mobile-local.css';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import BlogArchiveHeader from '../../../components/blog/BlogArchiveHeader.astro';
import BlogTopNav from '../../../components/blog/BlogTopNav.astro';
import GroupNav from '../../../components/blog/GroupNav.astro';
import SeriesCard from '../../../components/blog/SeriesCard.astro';
import '../../../styles/blog-series-card-local.css';
import '../../../styles/series-pagination-local.css';
import { getSiteConfig } from '../../../data/site';
import { getAllSeries } from '../../../utils/content-groups';
import { getUiText } from '../../../utils/ui-text';

export async function getStaticPaths() {
  const series = getAllSeries(
    await getCollection('blog', ({ data }) => !data.draft)
  );

  const totalPages = Math.ceil(series.length / 3);

  return Array.from(
    { length: Math.max(0, totalPages - 1) },
    (_, i) => ({
      params: { page: String(i + 2) },
    })
  );
}

const page = Number(Astro.params.page);
const config = await getSiteConfig();
const { site, theme, pages } = config;
const ui = getUiText(config);
const allSeries = getAllSeries(
  await getCollection('blog', ({ data }) => !data.draft)
);
const totalPages = Math.ceil(allSeries.length / 3);
const visibleSeries = allSeries.slice((page - 1) * 3, page * 3);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={ui.locale} data-palette={theme.palette}>
  <head>
    <BaseHead
      title={`${pages.blog.title} | ${site.title}`}
      description={pages.blog.note}
    />
    <style>
      main {
        width: min(100%, var(--layout-shell-width));
        max-width: none;
        padding: 118px var(--layout-page-gutter) var(--layout-page-bottom);
      }

      .series-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6px 56px;
        align-items: start;
      }

      @media (max-width: 720px) {
        main { padding-top: 34px; }
        .series-list {
          grid-template-columns: 1fr;
          gap: 0;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav />
    <main data-pagefind-body>
      <BlogArchiveHeader
        kicker="TRANSMISSION / ARCHIVE"
        title="FRAGMENTS"
        subtitle={`The pulsation and gleaming of an unsightly residual reality,
thoroughly corroded by signs.`}
      />
      <GroupNav activeView="series" />

      <section class="series-list" aria-label={ui.groups.series}>
        {visibleSeries.map((item) => (
          <SeriesCard name={item.name} slug={item.slug} posts={item.posts} />
        ))}
      </section>

            <nav class="archive-pagination" aria-label="Series pagination">
        <a
          class="pagination-link"
          href={page === 2
            ? `${basePath}/blog/series/`
            : `${basePath}/blog/series/${page - 1}/`}
        >
          Previous
        </a>

        <div class="pagination-pages pagination-pages-desktop">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((number) => (
            <a
              class:list={['pagination-number', { current: number === page }]}
              href={number === 1
                ? `${basePath}/blog/series/`
                : `${basePath}/blog/series/${number}/`}
              aria-current={number === page ? 'page' : undefined}
            >
              {number}
            </a>
          ))}
        </div>
        <div class="pagination-pages pagination-pages-mobile" aria-label="Mobile page navigation">
          {Array.from(
            { length: Math.min(3, totalPages) },
            (_, i) =>
              Math.max(
                1,
                Math.min(page - 1, Math.max(1, totalPages - 2))
              ) + i
          ).map((number) => (
            <a
              class:list={['pagination-number', { current: number === page }]}
              href={number === 1
                ? `${basePath}/blog/series/`
                : `${basePath}/blog/series/${number}/`}
              aria-current={number === page ? 'page' : undefined}
            >
              {number}
            </a>
          ))}
        </div>

        <a
          class:list={['pagination-link', { disabled: page >= totalPages }]}
          href={page < totalPages
            ? `${basePath}/blog/series/${page + 1}/`
            : undefined}
          aria-disabled={page >= totalPages}
        >
          Next
        </a>
      </nav>
    </main>
    <Footer />
  </body>
</html>