---
import '../../../styles/pagination-mobile-local.css';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import BlogArchiveHeader from '../../../components/blog/BlogArchiveHeader.astro';
import BlogTopNav from '../../../components/blog/BlogTopNav.astro';
import GroupNav from '../../../components/blog/GroupNav.astro';
import SeriesCard from '../../../components/blog/SeriesCard.astro';
import '../../../styles/blog-series-card-local.css';
import '../../../styles/series-pagination-local.css';
import { getSiteConfig } from '../../../data/site';
import { getAllSeries } from '../../../utils/content-groups';
import { getUiText } from '../../../utils/ui-text';

const siteConfig = await getSiteConfig();
const { site, theme, pages } = siteConfig;
const palette = theme.palette;
const pageMeta = pages.blog;
const series = getAllSeries(await getCollection('blog', ({ data }) => !data.draft));
const ui = getUiText(siteConfig);
const totalPages = Math.ceil(series.length / 3);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={ui.locale} data-palette={palette}>
  <head>
    <BaseHead title={`${pageMeta.title} | ${site.title}`} description={pageMeta.note} />
    <style>
      main {
        width: min(100%, var(--layout-shell-width));
        max-width: none;
        padding: 118px var(--layout-page-gutter) var(--layout-page-bottom);
      }

      .series-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6px 56px;
        align-items: start;
      }

      .series-list :global(.series-card) {
        min-width: 0;
      }
      .empty-note {
        max-width: 620px;
        margin: 0;
        color: var(--paper-ink-soft);
        font-family: var(--font-serif-cn);
        font-size: 1rem;
        line-height: 1.75;
      }

      @media (max-width: 720px) {
        main {
          padding-top: 34px;
        }

        .series-list {
          grid-template-columns: 1fr;
          gap: 0;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav />
    <main data-pagefind-body>
      <BlogArchiveHeader
        kicker="TRANSMISSION / ARCHIVE"
        title="FRAGMENTS"
        subtitle={`The pulsation and gleaming of an unsightly residual reality,
thoroughly corroded by signs.`}
      />
      <GroupNav activeView="series" />

      {
        series.length > 0 ? (
          <section class="series-list" aria-label={ui.groups.series}>
            {series.slice(0, 3).map((item) => (
              <SeriesCard name={item.name} slug={item.slug} posts={item.posts} />
            ))}
          </section>
        ) : (
          <p class="empty-note">{ui.groups.emptySeries}</p>
        )
      }
            {
        totalPages > 1 && (
          <nav class="archive-pagination" aria-label="Series pagination">
            <a class="pagination-link disabled" aria-disabled="true">
              Previous
            </a>

            <div class="pagination-pages pagination-pages-desktop">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((number) => (
                <a
                  class:list={['pagination-number', { current: number === 1 }]}
                  href={number === 1
                    ? `${basePath}/blog/series/`
                    : `${basePath}/blog/series/${number}/`}
                  aria-current={number === 1 ? 'page' : undefined}
                >
                  {number}
                </a>
              ))}
            </div>
        <div class="pagination-pages pagination-pages-mobile" aria-label="Mobile page navigation">
          {Array.from(
            { length: Math.min(3, totalPages) },
            (_, i) =>
              Math.max(
                1,
                Math.min(1 - 1, Math.max(1, totalPages - 2))
              ) + i
          ).map((number) => (
            <a
              class:list={['pagination-number', { current: number === 1 }]}
              href={number === 1
                ? `${basePath}/blog/series/`
                : `${basePath}/blog/series/${number}/`}
              aria-current={number === 1 ? 'page' : undefined}
            >
              {number}
            </a>
          ))}
        </div>

            <a class="pagination-link" href={`${basePath}/blog/series/2/`}>
              Next
            </a>
          </nav>
        )
      }
    </main>
    <Footer />
  </body>
</html>


<style>
/* SERIES HEADER SUBTITLE FIX */
.archive-subtitle {
  margin: 12px 0 0 !important;
  color: #858b83 !important;
  font-family: 'Inter Variable', 'Helvetica Neue', Arial, sans-serif !important;
  font-size: 0.82rem !important;
  font-weight: 400 !important;
  line-height: 1.5 !important;
  letter-spacing: -0.01em !important;
  text-transform: none !important;
}
</style>

