<!-- NEXUS TAG VIEW MORE V1 SCRIPT -->
<script is:inline data-astro-rerun>
  (() => {
    const setupTagViewMore = () => {
      const network = document.querySelector('.signal-network');
      if (!network) return;

      const field = network.querySelector('.network-field');
      if (!field) return;

      const nodes = Array.from(
        field.querySelectorAll('.signal-node')
      );

      const initialCount = 8;

      if (nodes.length <= initialCount) return;

      nodes.forEach((node, index) => {
        if (index >= initialCount) {
          node.dataset.tagMobileExtra = 'true';
        }
      });

      if (network.querySelector('.tag-mobile-viewmore')) {
        return;
      }

      network.dataset.tagExpanded = 'false';

      const control = document.createElement('div');
      control.className = 'tag-mobile-viewmore';

      const count = document.createElement('span');
      count.className = 'tag-mobile-viewmore-count';

      const button = document.createElement('button');
      button.className = 'tag-mobile-viewmore-button';
      button.type = 'button';
      button.setAttribute('aria-expanded', 'false');

      const label = document.createElement('span');
      const arrow = document.createElement('span');
      arrow.className = 'tag-mobile-viewmore-arrow';
      arrow.setAttribute('aria-hidden', 'true');

      button.append(label, arrow);
      control.append(count, button);

      if (!field.id) {
        field.id = 'nexus-tag-network-field';
      }

      button.setAttribute('aria-controls', field.id);

      const update = (expanded) => {
        network.dataset.tagExpanded = String(expanded);
        button.setAttribute('aria-expanded', String(expanded));

        count.textContent = expanded
          ? `SHOWING ALL ${nodes.length} NODES`
          : `SHOWING ${initialCount} OF ${nodes.length} NODES`;

        label.textContent = expanded
          ? 'SHOW LESS'
          : 'VIEW MORE';

        arrow.textContent = expanded ? '↑' : '↓';
      };

      button.addEventListener('click', () => {
        const wasExpanded =
          network.dataset.tagExpanded === 'true';

        update(!wasExpanded);

        if (wasExpanded) {
          const top =
            field.getBoundingClientRect().top +
            window.scrollY - 130;

          window.scrollTo({
            top: Math.max(0, top),
            behavior: 'smooth'
          });
        }
      });

      update(false);

      field.insertAdjacentElement('afterend', control);
    };

    if (!window.__nexusTagViewMoreReady) {
      window.__nexusTagViewMoreReady = true;

      document.addEventListener(
        'astro:page-load',
        setupTagViewMore
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        setupTagViewMore,
        { once: true }
      );
    } else {
      setupTagViewMore();
    }
  })();
</script>
