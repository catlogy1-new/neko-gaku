---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import BlogArchiveHeader from '../../../components/blog/BlogArchiveHeader.astro';
import BlogTopNav from '../../../components/blog/BlogTopNav.astro';
import GroupNav from '../../../components/blog/GroupNav.astro';
import { getSiteConfig } from '../../../data/site';
import { getAllTags } from '../../../utils/content-groups';
import { getUiText } from '../../../utils/ui-text';

/*
  Neon spectrum.
  Intentionally separate from the normal Blog palette:
  this page behaves like a signal-analysis terminal.
*/
const tagColors = [
  '#ff5a24', // orange-red
  '#b7ff00', // nexus lime
  '#00f0a8', // green-cyan
  '#ff3ebf', // magenta
  '#28d7ff', // cyan
  '#9d68ff', // violet
  '#ffb52d', // amber
  '#55ff78',
  '#5b8cff',
  '#ff616f',
  '#d7ff36',
  '#00ded2',
];

/*
  Slots intentionally leave a large exclusion zone around 50 / 50.
  The core must always read as the centre of the network.
*/
/*
  TAG SCATTER SYSTEM

  - 同じタグはリロードしても同じ位置
  - 中央の NEXUS CORE は避ける
  - 完全な等間隔にはせず、少し重なる余地を残す
  - タグ数が13を超えても同じ座標を再利用しない
*/

function seededTagValue(seed: number) {
  const value =
    Math.sin(seed * 12.9898 + 78.233) *
    43758.5453123;

  return value - Math.floor(value);
}

function createTagSlots(count: number) {
  const slots: Array<{ x: number; y: number }> = [];

  for (let index = 0; index < count; index += 1) {
    let selected:
      | { x: number; y: number }
      | undefined;

    let bestScore = -Infinity;

    /*
      NEXUS TAG SCATTER

      画面全体に候補を1024個生成し、
      既存カードと重ならない候補の中から
      最も距離が取れる場所を選ぶ。

      横方向 18%
      縦方向 12%

      の安全距離を確保する。
    */
    for (let attempt = 0; attempt < 1024; attempt += 1) {
      const seed =
        (index + 1) * 101 +
        attempt * 37;

      const x =
        10 +
        seededTagValue(seed) * 80;

      const y =
        10 +
        seededTagValue(seed + 911) * 80;


      /*
        中央 NEXUS CORE を避ける。
        少し余裕を持った楕円。
      */
      const coreX =
        (x - 50) / 18;

      const coreY =
        (y - 50) / 22;

      const insideCore =
        coreX * coreX +
        coreY * coreY <
        1.15;

      if (insideCore) {
        continue;
      }


      /*
        カード同士の重なりを禁止。
        実際のカード幅・高さを考慮して
        旧 9% / 8% より大幅に広げる。
      */
      const collision =
        slots.some((slot) => {
          const dx =
            Math.abs(slot.x - x);

          const dy =
            Math.abs(slot.y - y);

          return (
            dx < 18 &&
            dy < 12
          );
        });

      if (collision) {
        continue;
      }


      /*
        他のカードから最も離れている候補を優先。
        横と縦の比率をカード形状に合わせる。
      */
      let score = 100;

      if (slots.length > 0) {
        score = Math.min(
          ...slots.map((slot) => {
            const dx =
              (slot.x - x) / 18;

            const dy =
              (slot.y - y) / 12;

            return Math.sqrt(
              dx * dx +
              dy * dy
            );
          }),
        );
      }


      /*
        同点時にも毎回同じ結果になる程度の
        ごく小さい deterministic jitter。
      */
      score +=
        seededTagValue(seed + 1777) *
        0.02;


      if (score > bestScore) {
        bestScore = score;

        selected = {
          x: Number(x.toFixed(2)),
          y: Number(y.toFixed(2)),
        };
      }
    }


    /*
      20個程度なら通常ここには来ない。
      将来タグがかなり増えた場合だけ使うfallback。
    */
    if (!selected) {
      let fallbackScore = -Infinity;

      for (
        let attempt = 0;
        attempt < 1024;
        attempt += 1
      ) {
        const seed =
          (index + 1) * 1009 +
          attempt * 53;

        const x =
          10 +
          seededTagValue(seed) * 80;

        const y =
          10 +
          seededTagValue(seed + 911) * 80;

        const coreX =
          (x - 50) / 18;

        const coreY =
          (y - 50) / 22;

        if (
          coreX * coreX +
          coreY * coreY <
          1.15
        ) {
          continue;
        }

        const score =
          slots.length === 0
            ? 100
            : Math.min(
                ...slots.map((slot) => {
                  const dx =
                    (slot.x - x) / 18;

                  const dy =
                    (slot.y - y) / 12;

                  return Math.sqrt(
                    dx * dx +
                    dy * dy
                  );
                }),
              );

        if (score > fallbackScore) {
          fallbackScore = score;

          selected = {
            x: Number(x.toFixed(2)),
            y: Number(y.toFixed(2)),
          };
        }
      }
    }


    slots.push(
      selected ?? {
        x: 50,
        y: 10,
      },
    );
  }

  return slots;
}
const siteConfig = await getSiteConfig();
const { site, theme, pages } = siteConfig;
const palette = theme.palette;
const pageMeta = pages.blog;

const tags = getAllTags(
  await getCollection('blog', ({ data }) => !data.draft),
);

const ui = getUiText(siteConfig);

const maxCount = Math.max(1, ...tags.map((tag) => tag.count));
const minCount = Math.min(...tags.map((tag) => tag.count), maxCount);
const countRange = Math.max(1, maxCount - minCount);

const totalRecords = tags.reduce((sum, tag) => sum + tag.count, 0);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = ui.groups.tagCloud;
const pageNote = ui.groups.tagCloudNote;

function getTagWeight(count: number) {
  return (count - minCount) / countRange;
}

const tagSlots = createTagSlots(tags.length);

const renderedTags = tags.map((tag, index) => {
  const slot = tagSlots[index];

  return {
    ...tag,
    index,
    x: slot.x,
    y: slot.y,
    color: tagColors[index % tagColors.length],
    weight: getTagWeight(tag.count),
    node: String(index + 1).padStart(2, '0'),
  };
});
---

<!doctype html>

<html lang={ui.locale} data-palette={palette}>
  <head>
    <BaseHead
      title={`${pageTitle} | ${site.title}`}
      description={pageNote}
    />

    <style>
      main {
        width: min(100%, var(--layout-shell-width));
        max-width: none;
        padding:
          118px
          var(--layout-page-gutter)
          var(--layout-page-bottom);
      }


      /* =====================================================
         NETWORK SHELL
         ===================================================== */

      .signal-network {
        margin-top: 42px;

        border-top:
          1px solid rgba(255, 255, 255, 0.07);
      }


      /* =====================================================
         NETWORK HEADER
         ===================================================== */

      .network-header {
        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          auto;

        gap: 46px;
        align-items: center;

        min-height: 132px;

        padding: 22px 0;

        border-bottom:
          1px solid rgba(255, 255, 255, 0.09);
      }


      .network-heading {
        display: grid;
        gap: 8px;
      }


      .network-kicker {
        display: flex;
        gap: 11px;
        align-items: center;

        margin: 0;

        color: #b7ff00;

        font-family:
          "Maple Mono",
          monospace;

        font-size: 0.78rem;
        font-weight: 700;

        line-height: 1;

        letter-spacing: 0.16em;
        text-transform: uppercase;
      }


      .network-kicker::before {
        width: 7px;
        height: 7px;

        flex: 0 0 7px;

        border-radius: 50%;

        background: #b7ff00;

        box-shadow:
          0 0 7px #b7ff00,
          0 0 17px rgba(183, 255, 0, 0.62);

        content: "";

        animation:
          network-live 1.55s ease-in-out infinite;
      }


      .network-title {
        margin: 0;

        color: #f3f4f0;

        font-family:
          "Host Grotesk Variable",
          "Inter Variable",
          "Helvetica Neue",
          Arial,
          sans-serif;

        font-size:
          clamp(1.9rem, 3vw, 2.8rem);

        font-weight: 700;

        line-height: 0.98;

        letter-spacing: -0.055em;
      }


      /* metrics */

      .network-metrics {
        display: grid;

        grid-template-columns:
          repeat(3, minmax(110px, auto));

        align-items: stretch;
      }


      .metric {
        display: grid;
        gap: 7px;

        min-width: 116px;

        padding: 5px 28px;

        border-left:
          1px solid rgba(255, 255, 255, 0.09);
      }


      .metric-label {
        color: #777d76;

        font-family:
          "Maple Mono",
          monospace;

        font-size: 0.68rem;
        font-weight: 500;

        line-height: 1;

        letter-spacing: 0.15em;
        text-transform: uppercase;
      }


      .metric-value {
        color: #f4f5f1;

        font-family:
          "Maple Mono",
          monospace;

        font-size: 1.2rem;
        font-weight: 700;

        line-height: 1;

        letter-spacing: 0.05em;
      }


      .metric-value.live {
        display: flex;
        gap: 8px;
        align-items: center;

        color: #b7ff00;

        font-size: 0.92rem;

        text-shadow:
          0 0 8px rgba(183, 255, 0, 0.45);
      }


      .metric-value.live::before {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #b7ff00;

        box-shadow:
          0 0 7px rgba(183, 255, 0, 0.95);

        content: "";
      }


      /* =====================================================
         FIELD
         ===================================================== */

      .network-field {
        position: relative;

        min-height: 650px;

        overflow: hidden;

        border-bottom:
          1px solid rgba(255, 255, 255, 0.07);

        isolation: isolate;
      }


      /* dense terminal grid */

      .network-grid {
        position: absolute;
        inset: 0;

        z-index: -8;

        background-image:
          linear-gradient(
            rgba(183, 255, 0, 0.032) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(183, 255, 0, 0.032) 1px,
            transparent 1px
          );

        background-size:
          31px 31px;

        mask-image:
          radial-gradient(
            ellipse at center,
            black 5%,
            rgba(0, 0, 0, 0.85) 55%,
            transparent 96%
          );
      }


      .network-noise {
        position: absolute;
        inset: 0;

        z-index: -7;

        opacity: 0.16;

        background-image:
          radial-gradient(
            circle,
            rgba(183, 255, 0, 0.55) 0.7px,
            transparent 0.8px
          );

        background-size:
          17px 17px;

        mask-image:
          radial-gradient(
            ellipse at center,
            black,
            transparent 88%
          );
      }


      /* =====================================================
         SVG CONNECTION NETWORK
         ===================================================== */

      .network-links {
        position: absolute;
        inset: 0;

        z-index: -1;

        width: 100%;
        height: 100%;

        overflow: visible;

        pointer-events: none;
      }


      .network-link {
        stroke: var(--line-color);

        stroke-width: 0.85;

        opacity: 0.27;

        vector-effect:
          non-scaling-stroke;
      }


      /* =====================================================
         ORBITS
         ===================================================== */

      .orbit {
        position: absolute;

        top: 50%;
        left: 50%;

        z-index: -3;

        border-radius: 50%;

        pointer-events: none;

        transform:
          translate(-50%, -50%);
      }


      .orbit-1 {
        width: 82%;
        height: 72%;

        border:
          1px solid
          rgba(53, 211, 233, 0.20);

        transform:
          translate(-50%, -50%)
          rotate(-8deg);
      }


      .orbit-2 {
        width: 70%;
        height: 58%;

        border:
          1px solid
          rgba(183, 255, 0, 0.18);

        transform:
          translate(-50%, -50%)
          rotate(6deg);
      }


      .orbit-3 {
        width: 58%;
        height: 48%;

        border:
          1px dashed
          rgba(183, 255, 0, 0.14);

        transform:
          translate(-50%, -50%)
          rotate(-12deg);
      }


      .orbit-4 {
        width: 39%;
        height: 33%;

        border-top:
          1px solid
          rgba(255, 90, 36, 0.25);

        border-right:
          1px solid transparent;

        border-bottom:
          1px solid
          rgba(40, 215, 255, 0.11);

        border-left:
          1px solid transparent;

        transform:
          translate(-50%, -50%)
          rotate(17deg);
      }


      /* =====================================================
         NEXUS CORE
         ===================================================== */

      .nexus-core {
        position: absolute;

        top: 50%;
        left: 50%;

        z-index: 8;

        width: 168px;
        height: 168px;

        border:
          1px solid
          rgba(183, 255, 0, 0.32);

        border-radius: 50%;

        background:
          radial-gradient(
            circle,
            rgba(183, 255, 0, 0.32) 0%,
            rgba(183, 255, 0, 0.12) 10%,
            rgba(183, 255, 0, 0.025) 35%,
            rgba(2, 3, 2, 0.97) 70%
          );

        box-shadow:
          0 0 38px rgba(183, 255, 0, 0.13),
          0 0 85px rgba(183, 255, 0, 0.045);

        transform:
          translate(-50%, -50%);
      }


      .core-ring {
        position: absolute;

        top: 50%;
        left: 50%;

        border:
          1px solid
          rgba(183, 255, 0, 0.30);

        border-radius: 50%;

        transform:
          translate(-50%, -50%);
      }


      .core-ring-a {
        width: 118px;
        height: 118px;
      }


      .core-ring-b {
        width: 78px;
        height: 78px;

        border-style: dashed;

        opacity: 0.65;

        animation:
          core-spin 15s linear infinite;
      }


      .core-ring-c {
        width: 40px;
        height: 40px;

        opacity: 0.82;
      }


      .core-light {
        position: absolute;

        top: 50%;
        left: 50%;

        width: 12px;
        height: 12px;

        border-radius: 50%;

        background: #dcff68;

        box-shadow:
          0 0 8px #b7ff00,
          0 0 22px rgba(183, 255, 0, 0.88),
          0 0 54px rgba(183, 255, 0, 0.40);

        transform:
          translate(-50%, -50%);

        animation:
          core-pulse 1.75s ease-in-out infinite;
      }


      .core-label {
        position: absolute;

        top: calc(50% + 58px);
        left: 50%;

        color: #b7ff00;

        font-family:
          "Maple Mono",
          monospace;

        font-size: 0.66rem;
        font-weight: 600;

        line-height: 1;

        letter-spacing: 0.14em;

        white-space: nowrap;

        transform:
          translateX(-50%);
      }


      /* =====================================================
         TAG SIGNAL NODES
         ===================================================== */

      .signal-node {
        position: absolute;

        top: calc(var(--node-y) * 1%);
        left: calc(var(--node-x) * 1%);

        z-index: 10;

        display: grid;
        gap: 5px;

        min-width:
          calc(
            128px +
            var(--node-weight) * 36px
          );

        padding:
          11px 17px
          10px 18px;

        border:
          1px solid
          color-mix(
            in srgb,
            var(--node-color) 56%,
            transparent
          );

        border-left:
          2px solid
          var(--node-color);

        border-radius:
          2px 9px 2px 9px;

        background:
          linear-gradient(
            105deg,
            color-mix(
              in srgb,
              var(--node-color) 9%,
              #050505
            ),
            rgba(5, 5, 5, 0.91) 60%,
            rgba(5, 5, 5, 0.76)
          );

        box-shadow:
          0 0 14px
          color-mix(
            in srgb,
            var(--node-color) 11%,
            transparent
          );

        color:
          var(--node-color);

        text-decoration: none;

        transform:
          translate(-50%, -50%);

        transition:
          border-color 200ms ease,
          background-color 200ms ease,
          box-shadow 200ms ease,
          transform 200ms ease;
      }


      .signal-node::before {
        position: absolute;

        top: 50%;
        left: -7px;

        width: 8px;
        height: 8px;

        border-radius: 50%;

        background:
          var(--node-color);

        box-shadow:
          0 0 7px var(--node-color),
          0 0 18px
          color-mix(
            in srgb,
            var(--node-color) 58%,
            transparent
          );

        content: "";

        transform:
          translate(-50%, -50%);
      }


      .signal-node::after {
        position: absolute;

        right: -14px;
        bottom: -6px;

        width: 44px;
        height: 8px;

        border-top:
          1px solid
          var(--node-color);

        border-right:
          1px solid
          var(--node-color);

        content: "";

        opacity: 0.72;

        transform:
          skewX(38deg);
      }


      .signal-name {
        color:
          var(--node-color);

        font-family:
          "Maple Mono",
          monospace;

        font-size:
          calc(
            1.05rem +
            var(--node-weight) * 0.48rem
          );

        font-weight: 700;

        line-height: 1.05;

        letter-spacing: -0.035em;

        text-shadow:
          0 0 7px
          color-mix(
            in srgb,
            var(--node-color) 50%,
            transparent
          );
      }


      .signal-count {
        color:
          color-mix(
            in srgb,
            var(--node-color) 78%,
            #d3d7cf
          );

        font-family:
          "Maple Mono",
          monospace;

        font-size: 0.63rem;
        font-weight: 600;

        letter-spacing: 0.09em;

        text-transform: uppercase;
      }


      .signal-node:hover,
      .signal-node:focus-visible {
        z-index: 30;

        outline: none;

        border-color:
          var(--node-color);

        background:
          linear-gradient(
            105deg,
            color-mix(
              in srgb,
              var(--node-color) 17%,
              #050505
            ),
            #050505 66%
          );

        box-shadow:
          0 0 8px
          color-mix(
            in srgb,
            var(--node-color) 50%,
            transparent
          ),
          0 0 28px
          color-mix(
            in srgb,
            var(--node-color) 18%,
            transparent
          );

        transform:
          translate(-50%, -50%)
          scale(1.07);
      }


      .signal-node:hover .signal-name,
      .signal-node:focus-visible .signal-name {
        color: #ffffff;

        text-shadow:
          0 0 5px
          var(--node-color),
          0 0 18px
          var(--node-color);
      }


      /* =====================================================
         SIDE HUD
         ===================================================== */

      .hud-left,
      .hud-right {
        position: absolute;

        z-index: 4;

        color: #70776e;

        font-family:
          "Maple Mono",
          monospace;

        font-size: 0.57rem;
        font-weight: 500;

        line-height: 1.7;

        letter-spacing: 0.13em;

        text-transform: uppercase;

        pointer-events: none;
      }


      .hud-left {
        top: 20%;
        left: 1%;
      }


      .hud-right {
        top: 20%;
        right: 1%;

        display: grid;
        gap: 65px;

        text-align: right;
      }


      .hud-title {
        display: block;

        margin-bottom: 9px;

        color: #b7ff00;

        font-size: 0.55rem;
      }


      .hud-value {
        color: #9da49a;
      }


      .hud-live {
        color: #b7ff00;
      }


      /* =====================================================
         FOOTER STATUS BAR
         ===================================================== */

      .network-status {
        display: grid;

        grid-template-columns:
          1fr
          1fr
          1fr;

        gap: 28px;

        align-items: center;

        min-height: 54px;

        padding: 0 4px;

        border-bottom:
          1px solid
          rgba(255, 255, 255, 0.06);

        color: #737a71;

        font-family:
          "Maple Mono",
          monospace;

        font-size: 0.62rem;

        letter-spacing: 0.09em;

        text-transform: uppercase;
      }


      .network-status > span:nth-child(2) {
        text-align: center;
      }


      .network-status > span:nth-child(3) {
        text-align: right;
      }


      .network-status strong {
        color: #b7ff00;

        font-weight: 600;
      }


      .quality-bars {
        display: inline-flex;
        gap: 3px;

        margin-left: 9px;

        vertical-align: middle;
      }


      .quality-bars i {
        display: block;

        width: 5px;
        height: 10px;

        background: #b7ff00;

        box-shadow:
          0 0 4px
          rgba(183, 255, 0, 0.45);
      }


      /* =====================================================
         MOTION
         ===================================================== */

      @keyframes network-live {
        0%,
        100% {
          opacity: 0.32;
          transform: scale(0.78);
        }

        50% {
          opacity: 1;
          transform: scale(1);
        }
      }


      @keyframes core-pulse {
        0%,
        100% {
          opacity: 0.62;
          transform:
            translate(-50%, -50%)
            scale(0.86);
        }

        50% {
          opacity: 1;
          transform:
            translate(-50%, -50%)
            scale(1.08);
        }
      }


      @keyframes core-spin {
        to {
          transform:
            translate(-50%, -50%)
            rotate(360deg);
        }
      }


      /* =====================================================
         MOBILE
         ===================================================== */

      @media (max-width: 820px) {

        main {
          padding-top: 34px;
        }


        .network-header {
          grid-template-columns: 1fr;

          gap: 20px;

          min-height: 0;
        }


        .network-metrics {
          grid-template-columns:
            repeat(3, 1fr);
        }


        .metric {
          min-width: 0;

          padding:
            4px 14px;
        }


        .network-field {
          display: grid;

          grid-template-columns:
            repeat(2, minmax(0, 1fr));

          gap: 10px;

          min-height: 0;

          padding: 30px 0;
        }


        .network-grid,
        .network-noise,
        .network-links,
        .orbit,
        .nexus-core,
        .hud-left,
        .hud-right {
          display: none;
        }


        .signal-node {
          position: relative;

          top: auto;
          left: auto;

          min-width: 0;

          transform: none;
        }


        .signal-node:hover,
        .signal-node:focus-visible {
          transform:
            translateY(-2px);
        }


        .network-status {
          grid-template-columns: 1fr;

          gap: 7px;

          padding: 15px 0;
