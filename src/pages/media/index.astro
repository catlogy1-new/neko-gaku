---
import { getCollection } from 'astro:content';
import {
  BaseHead,
  BlogTopNav,
  Footer,
  getHtmlLang,
  getSiteConfig,
  getI18n,
} from 'virtual:navfolio/page-runtime';
import MediaShelf from '../../components/media/MediaShelf.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';

type MediaType = 'book' | 'film' | 'series' | 'album' | 'podcast';
type CoverAspect = 'portrait' | 'landscape' | 'square' | 'wide';
type MediaStatus = 'completed' | 'in-progress' | 'planned' | 'abandoned';
type MediaEntry = {
  id: string;
  data: {
    title: string;
    creator: string;
    type: MediaType;
    status: MediaStatus;
    completedAt?: Date;
    draft?: boolean;
    cover?: ImageMetadata | string;
    coverAspect?: CoverAspect;
    rating?: number;
    review?: boolean;
    tags?: string[];
    externalUrl?: string;
  };
  body?: string;
};

const siteConfig = await getSiteConfig();
const { site, theme, pages } = siteConfig;
const i18n = getI18n(siteConfig);
const ui = {
  media: {
    shelf: i18n.t('media.shelf'), browse: i18n.t('media.browse'), sectionsLabel: i18n.t('media.sectionsLabel'), empty: i18n.t('media.empty'), readReview: i18n.t('media.readReview'),
    sections: { books: i18n.t('media.sections.books'), booksNote: i18n.t('media.sections.booksNote'), films: i18n.t('media.sections.films'), filmsNote: i18n.t('media.sections.filmsNote'), music: i18n.t('media.sections.music'), musicNote: i18n.t('media.sections.musicNote') },
  },
};
const htmlLang = getHtmlLang(siteConfig);
const palette = theme.palette;
const configuredMedia = (pages as Record<string, unknown>).media;
const pageMeta = isPageMeta(configuredMedia)
  ? configuredMedia
  : {
      title: '书影音',
      subtitle: '读过、看过、听过的作品，以及一点当时的感受。',
      note: 'A personal shelf for books, films, and music.',
    };

const allMedia = ((await getCollection('media')) as MediaEntry[])
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => dateValue(b.data.completedAt) - dateValue(a.data.completedAt));
const mediaRoute = Astro.url.pathname.replace(/\/$/, '');

const sections = [
  { id: 'books', label: ui.media.sections.books, description: ui.media.sections.booksNote, types: ['book'] as MediaType[] },
  { id: 'films', label: ui.media.sections.films, description: ui.media.sections.filmsNote, types: ['film', 'series'] as MediaType[] },
  { id: 'music', label: ui.media.sections.music, description: ui.media.sections.musicNote, types: ['album', 'podcast'] as MediaType[] },
].map((section) => {
  const items = allMedia.filter((entry) => section.types.includes(entry.data.type));
  return {
    ...section,
    items: items.slice(0, 8),
    total: items.length,
    pageCount: Math.ceil(items.length / 8),
  };
});

function dateValue(value: Date | undefined) {
  return value?.valueOf() ?? 0;
}

function isPageMeta(value: unknown): value is { title: string; subtitle: string; note: string } {
  if (!value || typeof value !== 'object') return false;
  const candidate = value as Record<string, unknown>;
  return (
    typeof candidate.title === 'string' &&
    typeof candidate.subtitle === 'string' &&
    typeof candidate.note === 'string'
  );
}

---

<!doctype html>
<html lang={htmlLang} data-palette={palette}>
  <head>
    <BaseHead title={`ECHOES | ${site.title}`} description={pageMeta.subtitle} />
    <style>
      html { scroll-behavior: smooth; }
      main { width: min(100%, var(--layout-shell-width)); padding-top: 126px; }
      .media-layout { display: grid; grid-template-columns: minmax(0, 1fr) 156px; gap: clamp(28px, 5vw, 68px); }
      .media-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 156px;
        gap: clamp(28px, 5vw, 68px);
        width: 100%;
        margin-bottom: clamp(72px, 10vw, 132px);
        padding-bottom: 17px;
      }

      .media-hero-main {
        min-width: 0;
      }

      .media-hero-browse {
        align-self: start;
      }

      .media-hero::after {
        position: absolute;
        right: calc(-156px - clamp(28px, 5vw, 68px));
        bottom: -19px;
        left: 0;
        height: 1.5px;
        background: linear-gradient(
          90deg,
          rgba(255, 82, 0, 0.02) 0%,
          rgba(255, 82, 0, 0.05) 18%,
          rgba(255, 82, 0, 0.14) 42%,
          rgba(255, 82, 0, 0.38) 68%,
          rgba(255, 82, 0, 0.72) 86%,
          rgba(255, 82, 0, 0.96) 100%
        );
        content: '';
        pointer-events: none;
        clip-path: inset(0 var(--media-line-cut, 0px) 0 0);
        will-change: clip-path;
      }

      .media-kicker {
        margin: 0 0 11px;
        color: #b7ff00;
        font-family: "Maple Mono", monospace;
        font-size: 0.82rem;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .media-title {
        margin: 0;
        color: #e7e8e4;
        font-family:
          "Host Grotesk Variable",
          "Inter Variable",
          "Helvetica Neue",
          Arial,
          sans-serif;
        font-size: clamp(2.85rem, 4.35vw, 4.7rem);
        font-weight: 800;
        line-height: 0.94;
        letter-spacing: -0.065em;
        text-transform: uppercase;
      }

      .media-subtitle {
        width: auto;
        max-width: none;
        margin: 14px 0 17px;
        color: #858b83;
        font-family:
          "Inter Variable",
          "Helvetica Neue",
          Arial,
          sans-serif;
        font-size: 0.82rem;
        font-weight: 400;
        line-height: 1.65;
      }
      .media-count { color: var(--paper-ink-faint); font-size: 0.7rem; }
      .media-empty { margin: 0; color: var(--paper-ink-faint); font-family: var(--font-meta); font-size: 0.76rem; }
      .media-nav { align-self: start; position: static; border-left: 1px solid var(--paper-line); padding-left: 16px; }
      .media-browse-home {
        position: relative;
        display: inline-block;
        margin: 0 0 42px;
        padding: 0;
        color: #b7ff00;
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        line-height: 1;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 700ms cubic-bezier(0.22, 1, 0.36, 1);
      }


      .media-browse-home::after {
        position: absolute;
        top: calc(100% + 9px);
        left: 50%;
        width: 148px;
        height: 1px;
        content: "";
        background: linear-gradient(
          90deg,
          rgba(183, 255, 0, 0) 0%,
          rgba(183, 255, 0, 0.24) 18%,
          rgba(183, 255, 0, 0.82) 50%,
          rgba(183, 255, 0, 0.24) 82%,
          rgba(183, 255, 0, 0) 100%
        );
        transform: translateX(-50%);
      }

      .media-browse-home:hover {
        color: #ffffff;
      }

      .media-nav::after {
        position: absolute;
        top: 34px;
        left: 50%;
        width: 148px;
        content: "\2190  RETURN TO MEDIA";
        color: rgba(255, 255, 255, 0.52);
        font-size: 0.54rem;
        font-weight: 400;
        letter-spacing: 0.17em;
        text-align: right;
        white-space: nowrap;
        pointer-events: none;
        transform: translateX(-50%);
      }
      .media-nav > a:not(.media-browse-home) {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding: 8px 0 17px;
        color: var(--paper-ink-faint);
        font-size: 0.76rem;
        line-height: 1;
        text-decoration: none;
        transition: color 700ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .media-nav > a:not(.media-browse-home) > span:first-child {
        position: relative;
        display: inline-block;
      }

      .media-nav > a:not(.media-browse-home) > span:first-child::after {
        position: absolute;
        bottom: -13px;
        left: 50%;
        width: 0;
        height: 1px;
        content: "";
        background: #b7ff00;
        box-shadow: 0 0 5px rgba(183, 255, 0, 0.48);
        opacity: 0;
        transform: translateX(-50%);
        transition:
          width 700ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 700ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .media-nav > a:not(.media-browse-home):hover:not([aria-current='true']) {
        color: #ffffff;
      }

      .media-nav > a:not(.media-browse-home):hover:not([aria-current='true']) > span:first-child::after {
        width: 100%;
        opacity: 1;
      }

      .media-nav > a:not(.media-browse-home)[aria-current='true'] {
        color: #ffffff;
        font-weight: 600;
      }

      .media-nav > a:not(.media-browse-home)[aria-current='true'] > span:first-child::after {
        width: 0;
        opacity: 0;
      }

      .media-nav > a:not(.media-browse-home)[aria-current='true'] > span:first-child::before {
        position: absolute;
        bottom: -13px;
        left: 50%;
        width: 5px;
        height: 5px;
        content: "";
        background: #b7ff00;
        border-radius: 50%;
        box-shadow:
          0 0 4px rgba(183, 255, 0, 0.95),
          0 0 8px rgba(183, 255, 0, 0.55);
        transform: translate(-50%, 50%);
      }

      .media-mobile-nav { display: none; margin: 0 0 28px; border-bottom: 1px solid var(--paper-line); }
      .media-mobile-nav a { display: inline-flex; gap: 7px; padding: 8px 16px 10px 0; color: var(--paper-ink-faint); font-family: var(--font-meta); font-size: 0.72rem; text-decoration: none; }
      .media-mobile-nav a[aria-current='true'] { color: var(--paper-ink); font-weight: 600; }


      /* MEDIA STRUCTURE FIX START */

      .media-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 156px;
        grid-template-rows: auto auto;
        column-gap: clamp(28px, 5vw, 68px);
        row-gap: 0;
        align-items: start;
      }

      .media-hero {
        grid-column: 1;
        grid-row: 1;
        margin-bottom: 44px;
      }

      .media-layout > div {
        grid-column: 1;
        grid-row: 2;
        min-width: 0;
        padding-top: 38px;
      }

      .media-section {
        margin: 0 0 30px;
        padding: 0 0 42px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.10);
        scroll-margin-top: 102px;
      }

      .media-section:last-child {
        border-bottom: 0;
        margin-bottom: 0;
      }

      .media-section-heading {
        display: inline-flex;
        align-items: baseline;
        gap: 12px;
        width: fit-content;
        min-width: 280px;
        margin: 0 0 28px;
        padding: 12px 16px 13px;

        background: rgba(17, 19, 21, 0.72);

        border-top: 1px solid rgba(111, 33, 6, 0.78);
        border-right: 1px solid rgba(111, 33, 6, 0.78);
        border-bottom: 1px solid rgba(111, 33, 6, 0.78);
        border-left: 2px solid #b7ff00;

        border-radius: 8px;
        box-shadow: none;
      }

      .media-section-heading h2 {
        margin: 0;
        color: #e7e8e4;

        font-family:
          "Host Grotesk Variable",
          "Inter Variable",
          "Helvetica Neue",
          Arial,
          sans-serif;

        font-size: clamp(2.15rem, 3.25vw, 3.4rem);
        font-weight: 600;
        line-height: 0.95;
        letter-spacing: -0.045em;
      }

      .media-section-heading .media-count {
        font-family:
          "Inter Variable",
          "Helvetica Neue",
          Arial,
          sans-serif;
      }

      .media-section :global(*) {
        font-family:
          "Inter Variable",
          "Host Grotesk Variable",
          "Helvetica Neue",
          Arial,
          sans-serif !important;
      }

      .media-content-browse {
        grid-column: 2;
        grid-row: 1 / span 2;
        position: sticky;
        top: 87px;
        align-self: start;
        padding-left: 48px;
      }

      .media-content-browse::before {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 14px;
        width: 1px;
        content: "";
        background: linear-gradient(
          to bottom,
          rgba(183, 255, 0, 0) 0%,
          rgba(183, 255, 0, 0.12) 12%,
          rgba(183, 255, 0, 0.48) 27%,
          rgba(183, 255, 0, 0.88) 40%,
          rgba(183, 255, 0, 1) 46%,
          rgba(183, 255, 0, 0.70) 55%,
          rgba(183, 255, 0, 0.28) 72%,
          rgba(183, 255, 0, 0) 100%
        );
        box-shadow:
          0 0 4px rgba(183, 255, 0, 0.58),
          0 0 9px rgba(183, 255, 0, 0.26);
        pointer-events: none;
      }

      .media-content-browse .media-nav {
        position: static;
        border-left: 0;
      }

/* MEDIA STRUCTURE FIX END */
      @media (max-width: 760px) { main { padding-top: 98px; } .media-layout { display: block; } .media-nav { display: none; } .media-mobile-nav { display: block; } }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
/* MEDIA ORANGE LINE SNAP START */
      .media-hero::after {
        clip-path: inset(0 var(--media-line-cut, 0px) 0 0);
        filter: drop-shadow(
          10px 0 5px rgba(255, 82, 0, var(--media-line-trail, 0))
        );
        transition:
          clip-path 110ms cubic-bezier(0.22, 1, 0.36, 1),
          filter 260ms ease-out;
        will-change: clip-path, filter;
      }
      /* MEDIA ORANGE LINE SNAP END */

      
  /* =========================================================
     MEDIA SHELF COVER INTERACTION
     ========================================================= */

  /* 通常時：表紙にごく薄いダークグレーの枠 */
  :global(.navfolio-media-shelf__cover) {
    border: 1px solid rgba(150, 155, 150, 0.24) !important;
    box-shadow: none !important;
    transition:
      border-color 110ms ease-out,
      box-shadow 140ms ease-out !important;
  }

  /* ホバー時：細いライムが表紙だけ点灯 */
  :global(.navfolio-media-shelf__item:hover .navfolio-media-shelf__cover),
  :global(.navfolio-media-shelf__item:focus-visible .navfolio-media-shelf__cover) {
    border-color: rgba(183, 255, 42, 0.78) !important;
    box-shadow:
      0 0 3px rgba(183, 255, 42, 0.24),
      0 0 8px rgba(183, 255, 42, 0.08) !important;
  }

  /* 作品タイトル */
  :global(.navfolio-media-shelf__content strong) {
    transition:
      color 100ms ease-out,
      text-shadow 130ms ease-out !important;
  }

  :global(.navfolio-media-shelf__item:hover .navfolio-media-shelf__content strong),
  :global(.navfolio-media-shelf__item:focus-visible .navfolio-media-shelf__content strong) {
    color: #b7ff2a !important;
    text-shadow:
      0 0 4px rgba(183, 255, 42, 0.22),
      0 0 9px rgba(183, 255, 42, 0.08) !important;
  }

  /* 星：ライムとは分離して、暗めの黄色ネオン */
  :global(.navfolio-media-shelf__rating) {
    color: #d8b928 !important;
    text-shadow:
      0 0 3px rgba(216, 185, 40, 0.28),
      0 0 7px rgba(216, 185, 40, 0.10) !important;
  }


/* MEDIA MOBILE SUBTITLE FIX START */

@media (max-width: 760px) {

  main {
    padding-top: 30px !important;
  }

  .media-layout {
    display: block !important;
    width: 100% !important;
    min-width: 0 !important;
  }

  .media-hero {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
  }

  .media-hero-main {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
  }

  .media-kicker,
  .media-title {
    max-width: none !important;
  }

  .media-subtitle {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    font-size: 0.82rem !important;
    line-height: 1.65 !important;
  }

  .media-subtitle br {
    display: none !important;
  }
}

/* MEDIA MOBILE SUBTITLE FIX END */



/* NEXUS MOBILE HEADER FINE TUNE START */
@media (max-width: 760px) {
  main {
    padding-top: 38px !important;
  }

  .media-hero::after {
    bottom: 0px !important;
    right: 0 !important;
  }
}
/* NEXUS MOBILE HEADER FINE TUNE END */
/* NEXUS_MEDIA_FLOATING_MOBILE_NAV_V1 START */
@media (max-width: 760px) {
  /* Remove stacked spacing below the hero and above the first section. */
  .media-hero {
    margin-bottom: 18px !important;
  }
  .media-layout > div {
    padding-top: 0 !important;
    padding-bottom: 96px;
  }
  .media-mobile-nav {
    display: flex !important;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(15px, 5vw, 28px);
    margin: 0 0 22px !important;
    padding: 0 0 12px;
    border-bottom: 1px solid var(--paper-line);
  }
  .media-mobile-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 4px 0 !important;
    font-size: clamp(0.93rem, 3.5vw, 1.07rem) !important;
    line-height: 1.4;
    white-space: nowrap;
  }
  .media-mobile-nav a > span {
    font-size: 0.82em;
  }
  .media-section-heading {
    margin-bottom: 24px;
  }

  /* Floating switcher lives above the mobile browser toolbar. */
  .media-floating-nav {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    z-index: 80;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    max-width: 560px;
    margin: 0 auto;
    padding: 11px 10px 8px;
    background: rgba(99, 102, 102, 0.43);
    border: 1px solid rgba(255, 255, 255, 0.19);
    border-radius: 17px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.28);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
  }
  .media-floating-nav.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  .media-floating-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 41px;
    color: #d0d2ce;
    font-family: var(--font-meta);
    font-size: clamp(0.89rem, 3.6vw, 1.02rem);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .media-floating-nav a[aria-current='true'] {
    color: #fff;
  }
  .media-floating-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: transparent;
  }
  .media-floating-nav a[aria-current='true'] .media-floating-dot {
    background: #b7ff00;
    box-shadow: 0 0 5px rgba(183,255,0,.85), 0 0 11px rgba(183,255,0,.4);
  }
}
@media (min-width: 761px) {
  .media-floating-nav { display: none !important; }
}
@media (prefers-reduced-motion: reduce) {
  .media-floating-nav { transition: none !important; }
}
/* NEXUS_MEDIA_FLOATING_MOBILE_NAV_V1 END */
/* NEXUS_MEDIA_CATEGORY_PAGING_V1 */
.media-pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 16px;
  margin: 26px 0 10px;
  padding: 16px 0 0;
  border-top: 1px solid rgba(255, 255, 255, 0.13);
  font-family: var(--font-meta);
}
.media-pagination a {
  display: inline-flex;
  align-items: center;
  min-height: 40px;
  padding: 7px 14px;
  border: 1px solid rgba(183, 255, 0, 0.48);
  border-radius: 7px;
  color: #b7ff00;
  font-size: 0.81rem;
  font-weight: 650;
  letter-spacing: 0.045em;
  text-decoration: none;
  transition: border-color 150ms ease, background 150ms ease;
}
.media-pagination a:hover,
.media-pagination a:focus-visible {
  border-color: #b7ff00;
  background: rgba(183, 255, 0, 0.09);
}
.media-pagination-count {
  margin-right: auto;
  color: #92968f;
  font-size: 0.78rem;
  white-space: nowrap;
}
@media (max-width: 760px) {
  .media-pagination { gap: 10px; margin-bottom: 12px; }
  .media-pagination a { padding: 8px 12px; }
}
/* NEXUS_MEDIA_DESIGN_REFINEMENT_V1 START */
/* Pager: quiet charcoal at rest, lime feedback on interaction. */
.media-pagination a {
  position: relative;
  overflow: hidden;
  justify-content: center;
  gap: 9px;
  border: 1px solid rgba(137, 148, 139, 0.45) !important;
  background: rgba(24, 27, 25, 0.52) !important;
  color: #e1e4de !important;
  box-shadow: none !important;
  transition:
    color 220ms ease,
    background-color 220ms ease,
    border-color 220ms ease,
    box-shadow 220ms ease,
    transform 220ms ease !important;
}
.media-pagination a:hover,
.media-pagination a:focus-visible {
  color: #101410 !important;
  background: #b7ff00 !important;
  border-color: #b7ff00 !important;
  box-shadow: 0 0 8px rgba(183, 255, 0, 0.20),
              0 0 20px rgba(183, 255, 0, 0.09) !important;
  transform: translateY(-2px);
}
.media-pagination a:active {
  color: #101410 !important;
  background: #b7ff00 !important;
  border-color: #b7ff00 !important;
  transform: translateY(0) scale(0.98);
}
.media-pagination a:focus-visible {
  outline: 2px solid rgba(183, 255, 0, 0.65);
  outline-offset: 3px;
}
/* The next arrow stays lime in the resting state. */
.media-pagination a[data-media-next]::after {
  content: '\2192';
  color: #b7ff00;
  font-size: 1.13em;
  transition: transform 220ms ease, color 220ms ease;
}
.media-pagination a[data-media-next]:hover::after,
.media-pagination a[data-media-next]:focus-visible::after {
  color: #101410;
  transform: translateX(4px);
}
.media-pagination a[data-media-prev]::before {
  content: '\2190';
  color: #b7ff00;
  font-size: 1.13em;
  transition: transform 220ms ease, color 220ms ease;
}
.media-pagination a[data-media-prev]:hover::before,
.media-pagination a[data-media-prev]:focus-visible::before {
  color: #101410;
  transform: translateX(-4px);
}
/* Remove the space reserved by the old mobile shelf bottom padding. */
.media-section:last-child {
  padding-bottom: 12px !important;
}
.media-pagination {
  margin-bottom: 0 !important;
}
main {
  min-height: 0 !important;
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}
@media (max-width: 760px) {
  .media-layout > div {
    padding-bottom: 0 !important;
  }
  .media-section:last-child {
    padding-bottom: 0 !important;
  }
  .media-floating-nav {
    background: rgba(105, 109, 108, 0.27) !important;
    border-color: rgba(255, 255, 255, 0.16) !important;
    -webkit-backdrop-filter: blur(14px) saturate(110%) !important;
    backdrop-filter: blur(14px) saturate(110%) !important;
  }
}
@media (prefers-reduced-motion: reduce) {
  .media-pagination a,
  .media-pagination a::before,
  .media-pagination a::after { transition: none !important; transform: none !important; }
}
/* NEXUS_MEDIA_DESIGN_REFINEMENT_V1 END */
/* NEXUS_MEDIA_FOOTER_FLOATING_V2 */
/* Restore breathing room between pagination and the footer. */
main {
  padding-bottom: 64px !important;
}
@media (max-width: 760px) {
  main {
    padding-bottom: 68px !important;
  }
  /* Hide only at the absolute document bottom. */
  html.media-at-absolute-bottom .media-floating-nav,
  html.media-at-absolute-bottom .media-floating-nav.is-visible {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: translateY(14px) !important;
  }
}
/* NEXUS_MEDIA_FOOTER_FLOATING_V2 END */
</style>
  </head>
  <body>
    <BlogTopNav />
    <main>
      <div class="media-layout">
      <header class="media-hero">
        <div class="media-hero-main">
            <p class="media-kicker">BOOKS / FILMS / MUSIC</p>
            <h1 class="media-title">ECHOES</h1>
            <p class="media-subtitle">
              Nous vivons dans un monde où il y a de plus en plus d'information,<br />
              et de moins en moins de sens.
            </p>
                  </div>

      </header>
      
        <div>
          
          <nav class="media-mobile-nav" aria-label={ui.media.sectionsLabel} data-media-nav>
            {sections.map((section, index) => <a href={`#${section.id}`} aria-current={index === 0 ? 'true' : undefined}>{section.label} <span>{section.total}</span></a>)}
          </nav>
          {sections.map((section) => (
            <section class="media-section" id={section.id} data-media-section>
              <div class="media-section-heading">
                <h2>{section.label}</h2>
                <span class="media-count">{section.total} · {section.description}</span>
              </div>

              {section.items.length ? (
                <MediaShelf columns={4} items={[]} itemCount={section.items.length}>
                  {section.items.map((entry) => (
                    <TinaIsland
                      name="media-card"
                      params={{ path: `${entry.id}.mdx` }}
                      wrapper={{ tag: 'div' }}
                      primary
                    >
                      <MediaShelf cardOnly items={[{
                    id: `media-${entry.id}`,
                    title: entry.data.title,
                    creator: entry.data.creator,
                    type: entry.data.type,
                    cover: entry.data.cover,
                    coverAspect: entry.data.coverAspect,
                    rating: entry.data.rating,
                    href: entry.data.externalUrl,
                    reviewHref: entry.data.review ? `${mediaRoute}/${entry.id}/` : undefined,
                    reviewLabel: entry.data.review ? ui.media.readReview : undefined,
                  }]} />
                    </TinaIsland>
                  ))}
                </MediaShelf>
              ) : (
                <p class="media-empty">{ui.media.empty}</p>
              )}
              {section.pageCount > 1 && (
                <nav class="media-pagination" aria-label={`${section.label} pagination`}>
                  <span class="media-pagination-count">01 / {String(section.pageCount).padStart(2, '0')}</span>
                  <a data-media-next href={`/media/${section.id}/2/`}>NEXT</a>
                </nav>
              )}
            </section>
          ))}
        </div>

        <aside class="media-content-browse">
          <nav class="media-nav" aria-label={ui.media.sectionsLabel} data-media-nav>
            <a class="media-browse-home" href={mediaRoute}>{ui.media.browse}</a>
            {sections.map((section, index) => (
              <a href={`#${section.id}`} aria-current={index === 0 ? 'true' : undefined}>
                <span>{section.label}</span>
                <span>{section.total}</span>
              </a>
            ))}
          </nav>
        </aside>
      </div>
    </main>
    <nav class="media-floating-nav" data-media-floating-nav data-media-nav aria-label={ui.media.sectionsLabel} aria-hidden="true" inert>
      {sections.map((section, index) => (
        <a href={`#${section.id}`} aria-current={index === 0 ? 'true' : 'false'}>
          <span>{section.label}</span>
          <span class="media-floating-dot" aria-hidden="true"></span>
        </a>
      ))}
    </nav>
    <Footer />
    <script>
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>('[data-media-section]')
      );

      const navs = Array.from(
        document.querySelectorAll<HTMLElement>('[data-media-nav]')
      );

      

      let manualActiveId: string | null = null;
      let manualActiveTimer: number | undefined;

      const setActive = (id: string) => {
        navs.forEach((nav) => {
          nav.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
            link.setAttribute(
              'aria-current',
              link.getAttribute('href') === `#${id}` ? 'true' : 'false'
            );
          });
        });
      };

      const goToSection = (id: string) => {
        const section = document.getElementById(id);

        if (!section) return;

        const headerOffset = 96;
        const targetTop =
          section.getBoundingClientRect().top +
          window.scrollY -
          headerOffset;

        window.history.replaceState(null, '', `#${id}`);

        window.scrollTo({
          top: targetTop,
          behavior: 'smooth',
        });

        manualActiveId = id;
        setActive(id);

        if (manualActiveTimer !== undefined) {
          window.clearTimeout(manualActiveTimer);
        }

        manualActiveTimer = window.setTimeout(() => {
          manualActiveId = null;
        }, 800);
      };

      navs.forEach((nav) => {
        nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
          link.addEventListener('click', (event) => {
            const href = link.getAttribute('href');

            if (!href || href.length < 2) return;

            event.preventDefault();
            goToSection(href.slice(1));
          });
        });
      });

      /* Floating mobile section switcher and active-section tracking. */
      const floatingMediaNav = document.querySelector<HTMLElement>('[data-media-floating-nav]');
      const topMediaNav = document.querySelector<HTMLElement>('.media-mobile-nav');
      let mediaFloatingFrame = 0;

      const syncFloatingMediaNav = () => {
        if (!floatingMediaNav || !topMediaNav) return;
        const isMobile = window.matchMedia('(max-width: 760px)').matches;
        const show = isMobile && topMediaNav.getBoundingClientRect().bottom < 0;
        floatingMediaNav.classList.toggle('is-visible', show);
        floatingMediaNav.toggleAttribute('inert', !show);
        floatingMediaNav.setAttribute('aria-hidden', show ? 'false' : 'true');

        if (manualActiveId !== null || !sections.length) return;
        const switchLine = Math.min(window.innerHeight * 0.38, 230);
        let active = sections[0].id;
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= switchLine) {
            active = section.id;
          }
        }
        setActive(active);
      };

      const requestFloatingMediaSync = () => {
        if (mediaFloatingFrame) return;
        mediaFloatingFrame = window.requestAnimationFrame(() => {
          mediaFloatingFrame = 0;
          syncFloatingMediaNav();
        });
      };
      window.addEventListener('scroll', requestFloatingMediaSync, { passive: true });
      window.addEventListener('resize', requestFloatingMediaSync);
      window.addEventListener('pageshow', requestFloatingMediaSync);
      requestFloatingMediaSync();
      if (sections.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

            if (visible && manualActiveId === null) {
              setActive((visible.target as HTMLElement).id);
            }
          },
          {
            rootMargin: '-22% 0px -64%',
            threshold: [0, 0.1, 0.5],
          }
        );

        sections.forEach((section) => observer.observe(section));
      }
    </script>
<script is:inline>
/* NEXUS_MEDIA_FOOTER_FLOATING_V2 */
(() => {
  const mount = () => {
    if (document.documentElement.dataset.mediaBottomWatcher === '1') return;
    document.documentElement.dataset.mediaBottomWatcher = '1';
    let raf = 0;
    const check = () => {
      raf = 0;
      const doc = document.documentElement;
      const maxScroll = Math.max(0, doc.scrollHeight - window.innerHeight);
      const position = Math.max(0, window.scrollY || doc.scrollTop || 0);
      doc.classList.toggle('media-at-absolute-bottom', maxScroll > 0 && position >= maxScroll - 0.25);
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(check);
    };
    window.addEventListener('scroll', schedule, {passive: true});
    window.addEventListener('resize', schedule, {passive: true});
    window.addEventListener('pageshow', schedule);
    document.addEventListener('astro:after-swap', schedule);
    check();
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mount, {once:true});
  } else mount();
})();
</script>
</body>
</html>

<script is:inline>
  /* MEDIA ORANGE LINE SNAP MOTION */
  (() => {
    const mountMediaOrangeSnap = () => {
      const hero = document.querySelector('.media-hero');
      const browse = document.querySelector('.media-content-browse');

      if (!hero || !browse) return;
      if (hero.dataset.mediaOrangeSnapBound === 'true') return;

      hero.dataset.mediaOrangeSnapBound = 'true';

      let trailTimer;

      const setLineState = (cut) => {
        const browseWidth = browse.getBoundingClientRect().width;

        /*
         * Browse vertical lime line = 14px from its left edge.
         * Leave orange line about 8px to the left of it.
         */
        const cutWidth = Math.max(0, browseWidth - 6);

        hero.dataset.mediaLineCut = cut ? 'true' : 'false';

        hero.style.setProperty(
          '--media-line-cut',
          cut ? `${cutWidth}px` : '0px'
        );

        hero.style.setProperty('--media-line-trail', '0.46');

        window.clearTimeout(trailTimer);

        trailTimer = window.setTimeout(() => {
          hero.style.setProperty('--media-line-trail', '0');
        }, 70);
      };

      window.addEventListener(
        'wheel',
        (event) => {
          if (Math.abs(event.deltaY) < 1) return;

          if (event.deltaY > 0) {
            setLineState(true);
          } else {
            setLineState(false);
          }
        },
        { passive: true }
      );

      window.addEventListener('resize', () => {
        if (hero.dataset.mediaLineCut === 'true') {
          const browseWidth = browse.getBoundingClientRect().width;
          hero.style.setProperty(
            '--media-line-cut',
            `${Math.max(0, browseWidth - 6)}px`
          );
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        mountMediaOrangeSnap,
        { once: true }
      );
    } else {
      mountMediaOrangeSnap();
    }

    document.addEventListener(
      'astro:page-load',
      mountMediaOrangeSnap
    );
  })();
</script>
