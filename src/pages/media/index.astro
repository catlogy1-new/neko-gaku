---
import { getCollection } from 'astro:content';
import {
  BaseHead,
  BlogTopNav,
  Footer,
  getHtmlLang,
  getSiteConfig,
  getI18n,
} from 'virtual:navfolio/page-runtime';
import MediaShelf from '@navfolio/mdx-components/MediaShelf.astro';

type MediaType = 'book' | 'film' | 'series' | 'album' | 'podcast';
type CoverAspect = 'portrait' | 'landscape' | 'square' | 'wide';
type MediaStatus = 'completed' | 'in-progress' | 'planned' | 'abandoned';
type MediaEntry = {
  id: string;
  data: {
    title: string;
    creator: string;
    type: MediaType;
    status: MediaStatus;
    completedAt?: Date;
    draft?: boolean;
    cover?: ImageMetadata | string;
    coverAspect?: CoverAspect;
    rating?: number;
    review?: boolean;
    tags?: string[];
    externalUrl?: string;
  };
  body?: string;
};

const siteConfig = await getSiteConfig();
const { site, theme, pages } = siteConfig;
const i18n = getI18n(siteConfig);
const ui = {
  media: {
    shelf: i18n.t('media.shelf'), browse: i18n.t('media.browse'), sectionsLabel: i18n.t('media.sectionsLabel'), empty: i18n.t('media.empty'), readReview: i18n.t('media.readReview'),
    sections: { books: i18n.t('media.sections.books'), booksNote: i18n.t('media.sections.booksNote'), films: i18n.t('media.sections.films'), filmsNote: i18n.t('media.sections.filmsNote'), music: i18n.t('media.sections.music'), musicNote: i18n.t('media.sections.musicNote') },
  },
};
const htmlLang = getHtmlLang(siteConfig);
const palette = theme.palette;
const configuredMedia = (pages as Record<string, unknown>).media;
const pageMeta = isPageMeta(configuredMedia)
  ? configuredMedia
  : {
      title: '书影音',
      subtitle: '读过、看过、听过的作品，以及一点当时的感受。',
      note: 'A personal shelf for books, films, and music.',
    };

const allMedia = ((await getCollection('media')) as MediaEntry[])
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => dateValue(b.data.completedAt) - dateValue(a.data.completedAt));
const mediaRoute = Astro.url.pathname.replace(/\/$/, '');

const sections = [
  { id: 'books', label: ui.media.sections.books, description: ui.media.sections.booksNote, types: ['book'] as MediaType[] },
  { id: 'films', label: ui.media.sections.films, description: ui.media.sections.filmsNote, types: ['film', 'series'] as MediaType[] },
  { id: 'music', label: ui.media.sections.music, description: ui.media.sections.musicNote, types: ['album', 'podcast'] as MediaType[] },
].map((section) => ({
  ...section,
  items: allMedia.filter((entry) => section.types.includes(entry.data.type)),
}));

function dateValue(value: Date | undefined) {
  return value?.valueOf() ?? 0;
}

function isPageMeta(value: unknown): value is { title: string; subtitle: string; note: string } {
  if (!value || typeof value !== 'object') return false;
  const candidate = value as Record<string, unknown>;
  return (
    typeof candidate.title === 'string' &&
    typeof candidate.subtitle === 'string' &&
    typeof candidate.note === 'string'
  );
}

---

<!doctype html>
<html lang={htmlLang} data-palette={palette}>
  <head>
    <BaseHead title={`${pageMeta.title} | ${site.title}`} description={pageMeta.subtitle} />
    <style>
      html { scroll-behavior: smooth; }
      main { width: min(100%, var(--layout-shell-width)); padding-top: 126px; }
      .media-layout { display: grid; grid-template-columns: minmax(0, 1fr) 156px; gap: clamp(28px, 5vw, 68px); }
      .media-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 156px;
        gap: clamp(28px, 5vw, 68px);
        width: 100%;
        margin-bottom: clamp(72px, 10vw, 132px);
        padding-bottom: 17px;
      }

      .media-hero-main {
        min-width: 0;
      }

      .media-hero-browse {
        align-self: start;
      }

      .media-hero::after {
        position: absolute;
        right: calc(-156px - clamp(28px, 5vw, 68px));
        bottom: -19px;
        left: 0;
        height: 1.5px;
        background: linear-gradient(
          90deg,
          rgba(255, 82, 0, 0.02) 0%,
          rgba(255, 82, 0, 0.05) 18%,
          rgba(255, 82, 0, 0.14) 42%,
          rgba(255, 82, 0, 0.38) 68%,
          rgba(255, 82, 0, 0.72) 86%,
          rgba(255, 82, 0, 0.96) 100%
        );
        content: '';
        pointer-events: none;
        clip-path: inset(0 var(--media-line-cut, 0px) 0 0);
        will-change: clip-path;
      }

      .media-kicker {
        margin: 0 0 11px;
        color: #b7ff00;
        font-family: "Maple Mono", monospace;
        font-size: 0.82rem;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .media-title {
        margin: 0;
        color: #e7e8e4;
        font-family:
          "Host Grotesk Variable",
          "Inter Variable",
          "Helvetica Neue",
          Arial,
          sans-serif;
        font-size: clamp(2.85rem, 4.35vw, 4.7rem);
        font-weight: 800;
        line-height: 0.94;
        letter-spacing: -0.065em;
        text-transform: uppercase;
      }

      .media-subtitle {
        width: auto;
        max-width: none;
        margin: 14px 0 17px;
        color: #858b83;
        font-family:
          "Inter Variable",
          "Helvetica Neue",
          Arial,
          sans-serif;
        font-size: 0.82rem;
        font-weight: 400;
        line-height: 1.65;
      }
      .media-count { color: var(--paper-ink-faint); font-size: 0.7rem; }
      .media-empty { margin: 0; color: var(--paper-ink-faint); font-family: var(--font-meta); font-size: 0.76rem; }
      .media-nav { align-self: start; position: static; border-left: 1px solid var(--paper-line); padding-left: 16px; }
      .media-browse-home {
        position: relative;
        display: inline-block;
        margin: 0 0 42px;
        padding: 0;
        color: #b7ff00;
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        line-height: 1;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 700ms cubic-bezier(0.22, 1, 0.36, 1);
      }


      .media-browse-home::after {
        position: absolute;
        top: calc(100% + 9px);
        left: 50%;
        width: 148px;
        height: 1px;
        content: "";
        background: linear-gradient(
          90deg,
          rgba(183, 255, 0, 0) 0%,
          rgba(183, 255, 0, 0.24) 18%,
          rgba(183, 255, 0, 0.82) 50%,
          rgba(183, 255, 0, 0.24) 82%,
          rgba(183, 255, 0, 0) 100%
        );
        transform: translateX(-50%);
      }

      .media-browse-home:hover {
        color: #ffffff;
      }

      .media-nav::after {
        position: absolute;
        top: 34px;
        left: 50%;
        width: 148px;
        content: "\2190  RETURN TO MEDIA";
        color: rgba(255, 255, 255, 0.52);
        font-size: 0.54rem;
        font-weight: 400;
        letter-spacing: 0.17em;
        text-align: right;
        white-space: nowrap;
        pointer-events: none;
        transform: translateX(-50%);
      }
      .media-nav > a:not(.media-browse-home) {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding: 8px 0 17px;
        color: var(--paper-ink-faint);
        font-size: 0.76rem;
        line-height: 1;
        text-decoration: none;
        transition: color 700ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .media-nav > a:not(.media-browse-home) > span:first-child {
        position: relative;
        display: inline-block;
      }

      .media-nav > a:not(.media-browse-home) > span:first-child::after {
        position: absolute;
        bottom: -13px;
        left: 50%;
        width: 0;
        height: 1px;
        content: "";
        background: #b7ff00;
        box-shadow: 0 0 5px rgba(183, 255, 0, 0.48);
        opacity: 0;
        transform: translateX(-50%);
        transition:
          width 700ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 700ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .media-nav > a:not(.media-browse-home):hover:not([aria-current='true']) {
        color: #ffffff;
      }

      .media-nav > a:not(.media-browse-home):hover:not([aria-current='true']) > span:first-child::after {
        width: 100%;
        opacity: 1;
      }

      .media-nav > a:not(.media-browse-home)[aria-current='true'] {
        color: #ffffff;
        font-weight: 600;
      }

      .media-nav > a:not(.media-browse-home)[aria-current='true'] > span:first-child::after {
        width: 0;
        opacity: 0;
      }

      .media-nav > a:not(.media-browse-home)[aria-current='true'] > span:first-child::before {
        position: absolute;
        bottom: -13px;
        left: 50%;
        width: 5px;
        height: 5px;
        content: "";
        background: #b7ff00;
        border-radius: 50%;
        box-shadow:
          0 0 4px rgba(183, 255, 0, 0.95),
          0 0 8px rgba(183, 255, 0, 0.55);
        transform: translate(-50%, 50%);
      }

      .media-mobile-nav { display: none; margin: 0 0 28px; border-bottom: 1px solid var(--paper-line); }
      .media-mobile-nav a { display: inline-flex; gap: 7px; padding: 8px 16px 10px 0; color: var(--paper-ink-faint); font-family: var(--font-meta); font-size: 0.72rem; text-decoration: none; }
      .media-mobile-nav a[aria-current='true'] { color: var(--paper-ink); font-weight: 600; }


      /* MEDIA STRUCTURE FIX START */

      .media-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 156px;
        grid-template-rows: auto auto;
        column-gap: clamp(28px, 5vw, 68px);
        row-gap: 0;
        align-items: start;
      }

      .media-hero {
        grid-column: 1;
        grid-row: 1;
        margin-bottom: 44px;
      }

      .media-layout > div {
        grid-column: 1;
        grid-row: 2;
        min-width: 0;
        padding-top: 38px;
      }

      .media-section {
        margin: 0 0 30px;
        padding: 0 0 42px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.10);
        scroll-margin-top: 102px;
      }

      .media-section:last-child {
        border-bottom: 0;
        margin-bottom: 0;
      }

      .media-section-heading {
        display: inline-flex;
        align-items: baseline;
        gap: 12px;
        width: fit-content;
        min-width: 280px;
        margin: 0 0 28px;
        padding: 12px 16px 13px;

        background: rgba(17, 19, 21, 0.72);

        border-top: 1px solid rgba(111, 33, 6, 0.78);
        border-right: 1px solid rgba(111, 33, 6, 0.78);
        border-bottom: 1px solid rgba(111, 33, 6, 0.78);
        border-left: 2px solid #b7ff00;

        border-radius: 8px;
        box-shadow: none;
      }

      .media-section-heading h2 {
        margin: 0;
        color: #e7e8e4;

        font-family:
          "Host Grotesk Variable",
          "Inter Variable",
          "Helvetica Neue",
          Arial,
          sans-serif;

        font-size: clamp(2.15rem, 3.25vw, 3.4rem);
        font-weight: 600;
        line-height: 0.95;
        letter-spacing: -0.045em;
      }

      .media-section-heading .media-count {
        font-family:
          "Inter Variable",
          "Helvetica Neue",
          Arial,
          sans-serif;
      }

      .media-section :global(*) {
        font-family:
          "Inter Variable",
          "Host Grotesk Variable",
          "Helvetica Neue",
          Arial,
          sans-serif !important;
      }

      .media-content-browse {
        grid-column: 2;
        grid-row: 1 / span 2;
        position: sticky;
        top: 87px;
        align-self: start;
        padding-left: 48px;
      }

      .media-content-browse::before {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 14px;
        width: 1px;
        content: "";
        background: linear-gradient(
          to bottom,
          rgba(183, 255, 0, 0) 0%,
          rgba(183, 255, 0, 0.12) 12%,
          rgba(183, 255, 0, 0.48) 27%,
          rgba(183, 255, 0, 0.88) 40%,
          rgba(183, 255, 0, 1) 46%,
          rgba(183, 255, 0, 0.70) 55%,
          rgba(183, 255, 0, 0.28) 72%,
          rgba(183, 255, 0, 0) 100%
        );
        box-shadow:
          0 0 4px rgba(183, 255, 0, 0.58),
          0 0 9px rgba(183, 255, 0, 0.26);
        pointer-events: none;
      }

      .media-content-browse .media-nav {
        position: static;
        border-left: 0;
      }

/* MEDIA STRUCTURE FIX END */
      @media (max-width: 760px) { main { padding-top: 98px; } .media-layout { display: block; } .media-nav { display: none; } .media-mobile-nav { display: block; } }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
/* MEDIA ORANGE LINE SNAP START */
      .media-hero::after {
        clip-path: inset(0 var(--media-line-cut, 0px) 0 0);
        filter: drop-shadow(
          10px 0 5px rgba(255, 82, 0, var(--media-line-trail, 0))
        );
        transition:
          clip-path 110ms cubic-bezier(0.22, 1, 0.36, 1),
          filter 260ms ease-out;
        will-change: clip-path, filter;
      }
      /* MEDIA ORANGE LINE SNAP END */

      
  /* =========================================================
     MEDIA SHELF COVER INTERACTION
     ========================================================= */

  /* 通常時：表紙にごく薄いダークグレーの枠 */
  :global(.navfolio-media-shelf__cover) {
    border: 1px solid rgba(150, 155, 150, 0.24) !important;
    box-shadow: none !important;
    transition:
      border-color 110ms ease-out,
      box-shadow 140ms ease-out !important;
  }

  /* ホバー時：細いライムが表紙だけ点灯 */
  :global(.navfolio-media-shelf__item:hover .navfolio-media-shelf__cover),
  :global(.navfolio-media-shelf__item:focus-visible .navfolio-media-shelf__cover) {
    border-color: rgba(183, 255, 42, 0.78) !important;
    box-shadow:
      0 0 3px rgba(183, 255, 42, 0.24),
      0 0 8px rgba(183, 255, 42, 0.08) !important;
  }

  /* 作品タイトル */
  :global(.navfolio-media-shelf__content strong) {
    transition:
      color 100ms ease-out,
      text-shadow 130ms ease-out !important;
  }

  :global(.navfolio-media-shelf__item:hover .navfolio-media-shelf__content strong),
  :global(.navfolio-media-shelf__item:focus-visible .navfolio-media-shelf__content strong) {
    color: #b7ff2a !important;
    text-shadow:
      0 0 4px rgba(183, 255, 42, 0.22),
      0 0 9px rgba(183, 255, 42, 0.08) !important;
  }

  /* 星：ライムとは分離して、暗めの黄色ネオン */
  :global(.navfolio-media-shelf__rating) {
    color: #d8b928 !important;
    text-shadow:
      0 0 3px rgba(216, 185, 40, 0.28),
      0 0 7px rgba(216, 185, 40, 0.10) !important;
  }

</style>
  </head>
  <body>
    <BlogTopNav />
    <main>
      <div class="media-layout">
      <header class="media-hero">
        <div class="media-hero-main">
            <p class="media-kicker">BOOKS / FILMS / MUSIC</p>
            <h1 class="media-title">ECHOES</h1>
            <p class="media-subtitle">
              Nous vivons dans un monde où il y a de plus en plus d'information,<br />
              et de moins en moins de sens.
            </p>
                  </div>

      </header>
      
        <div>
          
          <nav class="media-mobile-nav" aria-label={ui.media.sectionsLabel} data-media-nav>
            {sections.map((section, index) => <a href={`#${section.id}`} aria-current={index === 0 ? 'true' : undefined}>{section.label} <span>{section.items.length}</span></a>)}
          </nav>
          {sections.map((section) => (
            <section class="media-section" id={section.id} data-media-section>
              <div class="media-section-heading">
                <h2>{section.label}</h2>
                <span class="media-count">{section.items.length} · {section.description}</span>
              </div>

              {section.items.length ? (
                <MediaShelf
                  columns={4}
                  items={section.items.map((entry) => ({
                    title: entry.data.title,
                    creator: entry.data.creator,
                    type: entry.data.type,
                    cover: entry.data.cover,
                    coverAspect: entry.data.coverAspect,
                    rating: entry.data.rating,
                    href: entry.data.externalUrl,
                    reviewHref: entry.data.review ? `${mediaRoute}/${entry.id}/` : undefined,
                    reviewLabel: entry.data.review ? ui.media.readReview : undefined,
                  }))}
                />
              ) : (
                <p class="media-empty">{ui.media.empty}</p>
              )}
            </section>
          ))}
        </div>

        <aside class="media-content-browse">
          <nav class="media-nav" aria-label={ui.media.sectionsLabel} data-media-nav>
            <a class="media-browse-home" href={mediaRoute}>{ui.media.browse}</a>
            {sections.map((section, index) => (
              <a href={`#${section.id}`} aria-current={index === 0 ? 'true' : undefined}>
                <span>{section.label}</span>
                <span>{section.items.length}</span>
              </a>
            ))}
          </nav>
        </aside>
      </div>
    </main>
    <Footer />
    <script>
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>('[data-media-section]')
      );

      const navs = Array.from(
        document.querySelectorAll<HTMLElement>('[data-media-nav]')
      );

      

      let manualActiveId: string | null = null;
      let manualActiveTimer: number | undefined;

      const setActive = (id: string) => {
        navs.forEach((nav) => {
          nav.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
            link.setAttribute(
              'aria-current',
              link.getAttribute('href') === `#${id}` ? 'true' : 'false'
            );
          });
        });
      };

      const goToSection = (id: string) => {
        const section = document.getElementById(id);

        if (!section) return;

        const headerOffset = 96;
        const targetTop =
          section.getBoundingClientRect().top +
          window.scrollY -
          headerOffset;

        window.history.replaceState(null, '', `#${id}`);

        window.scrollTo({
          top: targetTop,
          behavior: 'smooth',
        });

        manualActiveId = id;
        setActive(id);

        if (manualActiveTimer !== undefined) {
          window.clearTimeout(manualActiveTimer);
        }

        manualActiveTimer = window.setTimeout(() => {
          manualActiveId = null;
        }, 800);
      };

      navs.forEach((nav) => {
        nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
          link.addEventListener('click', (event) => {
            const href = link.getAttribute('href');

            if (!href || href.length < 2) return;

            event.preventDefault();
            goToSection(href.slice(1));
          });
        });
      });

      if (sections.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

            if (visible && manualActiveId === null) {
              setActive((visible.target as HTMLElement).id);
            }
          },
          {
            rootMargin: '-22% 0px -64%',
            threshold: [0, 0.1, 0.5],
          }
        );

        sections.forEach((section) => observer.observe(section));
      }
    </script>
  </body>
</html>

<script is:inline>
  /* MEDIA ORANGE LINE SNAP MOTION */
  (() => {
    const mountMediaOrangeSnap = () => {
      const hero = document.querySelector('.media-hero');
      const browse = document.querySelector('.media-content-browse');

      if (!hero || !browse) return;
      if (hero.dataset.mediaOrangeSnapBound === 'true') return;

      hero.dataset.mediaOrangeSnapBound = 'true';

      let trailTimer;

      const setLineState = (cut) => {
        const browseWidth = browse.getBoundingClientRect().width;

        /*
         * Browse vertical lime line = 14px from its left edge.
         * Leave orange line about 8px to the left of it.
         */
        const cutWidth = Math.max(0, browseWidth - 6);

        hero.dataset.mediaLineCut = cut ? 'true' : 'false';

        hero.style.setProperty(
          '--media-line-cut',
          cut ? `${cutWidth}px` : '0px'
        );

        hero.style.setProperty('--media-line-trail', '0.46');

        window.clearTimeout(trailTimer);

        trailTimer = window.setTimeout(() => {
          hero.style.setProperty('--media-line-trail', '0');
        }, 70);
      };

      window.addEventListener(
        'wheel',
        (event) => {
          if (Math.abs(event.deltaY) < 1) return;

          if (event.deltaY > 0) {
            setLineState(true);
          } else {
            setLineState(false);
          }
        },
        { passive: true }
      );

      window.addEventListener('resize', () => {
        if (hero.dataset.mediaLineCut === 'true') {
          const browseWidth = browse.getBoundingClientRect().width;
          hero.style.setProperty(
            '--media-line-cut',
            `${Math.max(0, browseWidth - 6)}px`
          );
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        mountMediaOrangeSnap,
        { once: true }
      );
    } else {
      mountMediaOrangeSnap();
    }

    document.addEventListener(
      'astro:page-load',
      mountMediaOrangeSnap
    );
  })();
</script>
