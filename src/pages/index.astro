</style>
<script is:inline>
(() => {
  let jpTimelineToken = 0;

  const runJapaneseFinalTimeline = () => {
    const title = document.querySelector('.jp-ghost-title');
    if (!title) return;

    const chars = [...title.querySelectorAll('.jp-ghost-text > span')];
    const line = title.querySelector('.jp-ghost-line');
    const cloud = title.querySelector('.jp-lime-cloud');

    if (!chars.length || !line || !cloud) return;

    const token = ++jpTimelineToken;

    /* 古いWAAPIを全キャンセル */
    title.querySelectorAll('*').forEach((el) => {
      el.getAnimations().forEach((animation) => animation.cancel());
    });

    /* -----------------------------------------------------
       RESET
       ----------------------------------------------------- */

    chars.forEach((char) => {
      char.style.opacity = '0';
      char.style.filter = 'blur(4px)';
      char.style.transform = 'scaleX(0.18) translateY(5px)';
    });

    line.style.opacity = '0';
    line.style.transform = 'translateX(-50%) scaleX(0)';

    cloud.style.opacity = '0';
    cloud.style.transform =
      'translate(-50%, -50%) scaleX(0.03) scaleY(0.72)';

    /* -----------------------------------------------------
       0.00s
       CLOUD + ORANGE LINE OPEN TOGETHER
       ----------------------------------------------------- */

    cloud.animate(
      [
        {
          opacity: 0,
          transform:
            'translate(-50%, -50%) scaleX(0.03) scaleY(0.72)'
        },
        {
          opacity: 0.88,
          offset: 0.42,
          transform:
            'translate(-50%, -50%) scaleX(0.62) scaleY(0.96)'
        },
        {
          opacity: 0.82,
          transform:
            'translate(-50%, -50%) scaleX(1) scaleY(1)'
        }
      ],
      {
        duration: 1650,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        fill: 'forwards'
      }
    );

    line.animate(
      [
        {
          opacity: 0,
          transform: 'translateX(-50%) scaleX(0)'
        },
        {
          opacity: 1,
          offset: 0.12
        },
        {
          opacity: 1,
          transform: 'translateX(-50%) scaleX(1)'
        }
      ],
      {
        duration: 1250,
        delay: 120,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        fill: 'forwards'
      }
    );

    /* -----------------------------------------------------
       0.30s～
       CHARACTERS FLOW INTO THE OPENING LIGHT
       ----------------------------------------------------- */

    const charStart = 300;
    const stagger = 180;
    const charDuration = 1400;

    chars.forEach((char, i) => {
      char.animate(
        [
          {
            opacity: 0,
            filter: 'blur(4px)',
            transform: 'scaleX(0.18) translateY(5px)'
          },
          {
            opacity: 0.56,
            offset: 0.36,
            filter: 'blur(1.5px)',
            transform: 'scaleX(0.52) translateY(2px)'
          },
          {
            opacity: 1,
            filter: 'blur(0)',
            transform: 'scaleX(1) translateY(0)'
          }
        ],
        {
          duration: charDuration,
          delay: charStart + (i * stagger),
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          fill: 'forwards'
        }
      );
    });

    /*
      最後の文字が完成する時刻
      300 + (10 * 180) + 1400 = 約3.5秒
    */

    const allCharsReady =
      charStart +
      ((chars.length - 1) * stagger) +
      charDuration;

    /* 全文完成後、一呼吸。
       ここを長くしたければこの値だけ変更 */
    const hold = 1450;

    const blinkStart = allCharsReady + hold;

    /* -----------------------------------------------------
       BLINK ONCE
       TEXT + ORANGE LINE
       ----------------------------------------------------- */

    setTimeout(() => {
      if (token !== jpTimelineToken) return;

      chars.forEach((char) => {
        char.animate(
          [
            { opacity: 1 },
            { opacity: 0.20, offset: 0.34 },
            { opacity: 1, offset: 0.68 },
            { opacity: 1 }
          ],
          {
            duration: 300,
            easing: 'linear',
            fill: 'forwards'
          }
        );
      });

      line.animate(
        [
          { opacity: 1 },
          { opacity: 0.18, offset: 0.34 },
          { opacity: 1, offset: 0.68 },
          { opacity: 1 }
        ],
        {
          duration: 300,
          easing: 'linear',
          fill: 'forwards'
        }
      );

    }, blinkStart);

    /* -----------------------------------------------------
       TEXT + ORANGE LINE VANISH
       ----------------------------------------------------- */

    const vanishStart = blinkStart + 340;

    setTimeout(() => {
      if (token !== jpTimelineToken) return;
      /* MOBILE JP TITLE KEEP V1
         Mobile keeps Japanese title + orange line visible. */
      if (window.matchMedia('(max-width: 820px)').matches) {
        return;
      }

      chars.forEach((char) => {
        char.animate(
          [
            {
              opacity: 1,
              filter: 'blur(0)',
              transform: 'translateY(0)'
            },
            {
              opacity: 0,
              filter: 'blur(6px)',
              transform: 'translateY(-3px)'
            }
          ],
          {
            duration: 850,
            easing: 'cubic-bezier(0.4, 0, 1, 1)',
            fill: 'forwards'
          }
        );
      });

      /* 両端から中央へ */
      line.animate(
        [
          {
            opacity: 1,
            transform: 'translateX(-50%) scaleX(1)'
          },
          {
            opacity: 1,
            offset: 0.72,
            transform: 'translateX(-50%) scaleX(0.16)'
          },
          {
            opacity: 0,
            transform: 'translateX(-50%) scaleX(0)'
          }
        ],
        {
          duration: 900,
          easing: 'cubic-bezier(0.45, 0, 0.35, 1)',
          fill: 'forwards'
        }
      );

    }, vanishStart);

    /* -----------------------------------------------------
       CLOUD RESIDUAL ACTION
       文字が消え切る少し前から開始
       ----------------------------------------------------- */

    const cloudCloseStart = vanishStart + 620;

    setTimeout(() => {
      if (token !== jpTimelineToken) return;

      cloud.animate(
        [
          {
            opacity: 0.82,
            transform:
              'translate(-50%, -50%) scaleX(1) scaleY(1)'
          },
          {
            opacity: 0.84,
            offset: 0.34,
            transform:
              'translate(-50%, -50%) scaleX(0.68) scaleY(0.98)'
          },
          {
            opacity: 0.76,
            offset: 0.67,
            transform:
              'translate(-50%, -50%) scaleX(0.34) scaleY(0.94)'
          },
          {
            opacity: 0.48,
            offset: 0.88,
            transform:
              'translate(-50%, -50%) scaleX(0.12) scaleY(0.90)'
          },

          /* 点にはしない。細い雲の残像のまま消える */
          {
            opacity: 0,
            transform:
              'translate(-50%, -50%) scaleX(0.035) scaleY(0.88)'
          }
        ],
        {
          duration: 1750,
          easing: 'cubic-bezier(0.45, 0, 0.35, 1)',
          fill: 'forwards'
        }
      );

    }, cloudCloseStart);
  };

  /*
    Full reload と Astro client navigation の両方で
    必ず同じタイムラインを起動する。
  */

  const scheduleJapaneseTimeline = () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(runJapaneseFinalTimeline);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      scheduleJapaneseTimeline,
      { once: true }
    );
  } else {
    scheduleJapaneseTimeline();
  }

  document.addEventListener(
    'astro:page-load',
    scheduleJapaneseTimeline
  );
})();
</script>



