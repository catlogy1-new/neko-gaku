<!-- MOBILE BACK CACHE REFRESH START -->
<script is:inline>
(() => {
  const MOBILE_QUERY = '(max-width: 820px)';

  if (!window.matchMedia(MOBILE_QUERY).matches) {
    return;
  }

  window.addEventListener('pageshow', (event) => {

    const navigation =
      performance.getEntriesByType('navigation')[0];

    const isBackForward =
      event.persisted === true ||
      navigation?.type === 'back_forward';

    if (!isBackForward) {
      return;
    }

    /*
      Browser-back restoration is the only state
      where the catch-me position becomes inconsistent.

      Reload once so the page takes the same path as
      a normal refresh / NEXUS navigation.
    */

    const key = 'nekogaku-home-back-refresh';

    if (sessionStorage.getItem(key) === '1') {
      sessionStorage.removeItem(key);
      return;
    }

    sessionStorage.setItem(key, '1');

    window.location.reload();
  });
})();
</script>
<!-- MOBILE BACK CACHE REFRESH END -->


