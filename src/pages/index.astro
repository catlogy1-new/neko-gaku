---
import { getCollection } from 'astro:content';
import { getSiteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const { site } = await getSiteConfig();

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const projectPosts = await getCollection('projects', ({ data }) => !data.draft);
const vibePosts = (await getCollection('vibe', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const mediaPosts = (await getCollection('media', ({ data }) => !data.draft))
  .sort((a, b) =>
    (b.data.completedAt?.valueOf() ?? 0) -
    (a.data.completedAt?.valueOf() ?? 0)
  );

const MATRIX_DAYS = 84;

const toDateKey = (date: Date) => {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

const today = new Date();
today.setHours(0, 0, 0, 0);

const matrixStart = new Date(today);
const mondayOffset = (matrixStart.getDay() + 6) % 7;
matrixStart.setDate(matrixStart.getDate() - mondayOffset - 11 * 7);

const blogByDate = new Map();
const blogHrefByDate = new Map();
const projectsByDate = new Map();
const projectHrefByDate = new Map();
const vibeByDate = new Map();
const vibeHrefByDate = new Map();
const mediaByDate = new Map();
const mediaHrefByDate = new Map();

for (const post of blogPosts) {
  const key = toDateKey(post.data.date);
  blogByDate.set(key, (blogByDate.get(key) ?? 0) + 1);
  if (!blogHrefByDate.has(key)) {
    blogHrefByDate.set(key, `/blog/${post.id}/`);
  }
}

for (const project of projectPosts) {
  const key = toDateKey(project.data.date);
  projectsByDate.set(key, (projectsByDate.get(key) ?? 0) + 1);
  if (!projectHrefByDate.has(key)) projectHrefByDate.set(key, `/projects/${project.id}/`);
}


const pulsePageSize = 10;
const pulseBaseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/vibe`;

for (const [index, vibe] of vibePosts.entries()) {
  const key = toDateKey(vibe.data.date);
  vibeByDate.set(key, (vibeByDate.get(key) ?? 0) + 1);

  if (!vibeHrefByDate.has(key)) {
    const pageNumber = Math.floor(index / pulsePageSize) + 1;
    const pageUrl = pageNumber === 1
      ? `${pulseBaseUrl}/`
      : `${pulseBaseUrl}/page/${pageNumber}/`;

    const anchor = encodeURIComponent(`pulse-${vibe.id}`);
    vibeHrefByDate.set(key, `${pageUrl}#${anchor}`);
  }
}

const mediaPageSize = 8;
const mediaBaseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/media`;

const mediaCategoryByType = {
  book: 'books',
  film: 'films',
  series: 'films',
  album: 'music',
  podcast: 'music',
} as const;

const mediaCategoryPositions = {
  books: 0,
  films: 0,
  music: 0,
};

for (const media of mediaPosts) {
  const category = mediaCategoryByType[media.data.type];
  const position = mediaCategoryPositions[category]++;

  if (!media.data.completedAt) continue;

  const key = toDateKey(media.data.completedAt);
  mediaByDate.set(key, (mediaByDate.get(key) ?? 0) + 1);

  if (!mediaHrefByDate.has(key)) {
    const pageNumber = Math.floor(position / mediaPageSize) + 1;

    const pageUrl = pageNumber === 1
      ? `${mediaBaseUrl}/`
      : `${mediaBaseUrl}/${category}/${pageNumber}/`;

    const anchor = encodeURIComponent(`media-${media.id}`);

    mediaHrefByDate.set(key, `${pageUrl}#${anchor}`);
  }
}


const matrixDays = Array.from({ length: MATRIX_DAYS }, (_, index) => {
  const date = new Date(matrixStart);
  date.setDate(matrixStart.getDate() + index);

  const key = toDateKey(date);

  return {
    date: key,
    blogCount: blogByDate.get(key) ?? 0,
    blogHref: blogHrefByDate.get(key),
    projectCount: projectsByDate.get(key) ?? 0,
    projectHref: projectHrefByDate.get(key),
    vibeCount: vibeByDate.get(key) ?? 0,
    vibeHref: vibeHrefByDate.get(key),
    mediaCount: mediaByDate.get(key) ?? 0,
    mediaHref: mediaHrefByDate.get(key),
  };
});

const dotLinks = [
  { label: 'BLOG', href: '/blog', className: 'dot-blog' },
  { label: 'PORTFOLIO', href: '/projects', className: 'dot-portfolio' },
  { label: 'VIBE', href: '/vibe', className: 'dot-vibe' },
  { label: 'MEDIA', href: '/media', className: 'dot-media' },
];
---
<BaseLayout title={site.pageTitle} description={site.pageDescription}>
  <main class="hero">
    <div class="hero-grid">
      <section class="hero-copy">
        <div class="eyebrow-mask">
          <p class="eyebrow hero-motion motion-1">
            TRANSMISSION / 2026
          </p>
        </div>
        <h1 class="hero-title">
          <span class="title-mask">
            <span class="title-line hero-motion motion-2">
              POUR EN FINIR
            </span>
          </span>
          <span class="title-mask">
            <span class="title-line title-outline hero-motion motion-3">
              AVEC LE JUGEMENT
            </span>
          </span>
          <span class="title-mask">
            <span class="title-line title-lime hero-motion motion-4">
              DE DIEU
            </span>
          </span>
        </h1>
        <div class="description-mask">
          <p class="hero-description hero-motion motion-5">
            Writing, projects, media and fragments from one digital space.
          </p>
        </div>
      </section>
      <section class="dot-visual" aria-label="Content navigation">
        <div class="dot-stage hero-motion motion-5">
          <div class="matrix-heading">
            <span class="matrix-kicker">NAVIGATION MATRIX</span>
            <span class="matrix-subtitle">LIVE CONTENT SYSTEM</span>
          </div>
          <div class="matrix-days" aria-hidden="true">
            <span>MON</span>
            <span></span>
            <span>WED</span>
            <span></span>
            <span>FRI</span>
            <span></span>
            <span>SUN</span>
          </div>

          <div class="matrix-date-axis" aria-hidden="true">
            {
              matrixDays
                .filter((_, index) => index % 7 === 0)
                .map((day) => {
                  const [, month, date] = day.date.split('-');

                  return (
                    <span>
                      {date === '01' ? `${month}/${date}` : date}
                    </span>
                  );
                })
            }
          </div>

          <div class="dot-grid" aria-hidden="true">
            {
              matrixDays.map((day) => (
                <div
                  class:list={[
                    'grid-dot',
                    {
                      bright: day.blogCount > 0,
                      orange: day.projectCount > 0,
                      both: day.blogCount > 0 && day.projectCount > 0,
                      vibe: day.vibeCount > 0,
                      media: day.mediaCount > 0,
                    },
                  ]}
                  data-date={day.date}
                  data-blog={day.blogCount}
                  data-portfolio={day.projectCount}
                  data-vibe={day.vibeCount}
                  data-media={day.mediaCount}
                  data-blog-href={day.blogHref ?? ''}
                  data-portfolio-href={day.projectHref ?? ''}
                  data-vibe-href={day.vibeHref ?? ''}
                  data-media-href={day.mediaHref ?? ''}
                >
                  <span class="grid-dot-copy">
                    <strong></strong>
                    <span class="grid-dot-actions"></span>
                  </span>
                </div>
              ))
            }
          </div>
          <div class="matrix-hover-info" aria-hidden="true">
            <span class="matrix-hover-date"></span>
            <span class="matrix-hover-kind"></span>
          </div>

          <div class="signal">
            <span class="signal-light"></span>
            LIVE SIGNAL
          </div>
        </div>
      </section>
    </div>
  </main>
  <div class="catch-me-stage">
    <a href="/catch-me/" class="catch-me-text">You can't catch me</a>
  </div>
  <Footer />
</BaseLayout>


<style>
  .hero {
    min-height: 100svh;
    overflow: visible;
    background: #050505;
    color: #f5f5f2;
    font-family: 'Inter Variable', Arial, sans-serif;
  }

  .hero-grid {
    width: min(calc(100% - 32px), 1480px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(292px, 26.5vw, 350px);
    gap: 46px;
    align-items: start;
    padding-top: 170px;
    padding-bottom: 56px;
    transform: translateY(-105px);
  }

  .hero-copy {
    min-width: 0;
    position: relative;
    left: 0;
    transform: translateY(-3mm);
  }

  .eyebrow-mask,
  .title-mask,
  .description-mask {
    display: block;
    overflow: hidden;
  }

  .eyebrow-mask {
    overflow: visible;
  }

  .eyebrow {
    margin: 0 0 22px;
    color: #b7ff00;
    font-family: 'Maple Mono', monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.19em;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 2mm;
    width: 100%;
    margin: 0;
    font-family: 'Host Grotesk Variable', Arial, sans-serif;
    font-size: clamp(3.4rem, 5.4vw, 6.2rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .title-mask {
    display: block;
    padding: 0.055em 0 0.085em;
    overflow: visible;
  }

  .title-line {
    display: block;
    overflow: visible;
    white-space: nowrap;
  }

  .title-line.motion-2 {
    color: #f3f3f3;
    -webkit-text-fill-color: currentColor;
  }

  .title-outline {
    color: transparent;
    -webkit-text-stroke: 1.6px #b7ff00;
  }

  .title-lime {
    color: #b7ff00;
  }

  .hero-description {
    max-width: 520px;
    margin: 30px 0 0;
    color: #92958f;
    font-family: 'Inter Variable', Arial, sans-serif;
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.02em;
  }

  .dot-visual {
    position: relative;
    top: -30px;
    left: 12mm;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    min-width: 0;
    width: 100%;
    max-width: 350px;
    justify-self: end;
  }

  .dot-stage {
    position: relative;
    width: 100%;
    max-width: 350px;
    aspect-ratio: 0.96;
    overflow: hidden;
    border: 1.5px solid rgba(255, 92, 32, 0.28);
    border-radius: 20px;
    background:
      radial-gradient(
        circle at 50% 48%,
        rgba(183, 255, 0, 0.055),
        transparent 52%
      ),
      #070807;
    box-shadow: 0 0 5px rgba(255, 92, 32, 0.13), 0 0 12px rgba(255, 92, 32, 0.05);
  }

  .matrix-heading {
    position: absolute;
    top: 25px;
    left: 27px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-family: 'Maple Mono', monospace;
  }

  .matrix-kicker {
    color: #b7ff00;
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: 0.17em;
  }

  .matrix-subtitle {
    color: #8f948c;
    font-size: 0.80rem;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .dot-grid,
  .dot-links {
    position: absolute;
    inset: 120px 38px 68px;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(7, 1fr);
    grid-auto-flow: column;
    place-items: center;
    gap: clamp(8px, 1vw, 13px);
    align-content: center;
  }

  .dot-grid {
    opacity: 0.72;
  }

  .grid-dot {
    display: block;
    width: 5px;
    height: 5px;
    justify-self: center;
    border-radius: 50%;
    background: rgba(183, 255, 0, 0.36);
    box-shadow: 0 0 5px rgba(183, 255, 0, 0.10);
  
    position: relative;
  }

  .grid-dot.bright {
    width: 10px;
    height: 10px;
    border: 1px solid #b7ff00;
    background: #050505;
    box-shadow:
      0 0 8px rgba(183, 255, 0, 0.52),
      0 0 18px rgba(183, 255, 0, 0.18);
  }

  .grid-dot.orange {
    background: #ff4d00;
    box-shadow:
      0 0 8px rgba(255, 77, 0, 0.7),
      0 0 20px rgba(255, 77, 0, 0.25);
  }

  .grid-dot.both:not(.vibe):not(.media) {
    background: #f5f5f2;
    box-shadow:
      0 0 8px rgba(245, 245, 242, 0.72),
      0 0 20px rgba(183, 255, 0, 0.30),
      0 0 24px rgba(255, 77, 0, 0.18);
  }

  .dot-links {
    pointer-events: none;
  }

  .dot-link {
    position: relative;
    display: block;
    width: 10px;
    height: 10px;
    color: #f5f5f2;
    font-family: 'Maple Mono', monospace;
    text-decoration: none;
    pointer-events: auto;
  }

  .nav-dot {
    display: block;
    width: 10px;
    height: 10px;
    border: 1px solid #b7ff00;
    border-radius: 50%;
    background: #050505;
    transition:
      background 300ms ease,
      transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 300ms ease;
  }

  .dot-blog {
    display: none;
    grid-column: 1;
    grid-row: 1;
  }

  .dot-portfolio {
    grid-column: 8;
    grid-row: 3;
  }

  .dot-vibe {
    grid-column: 9;
    grid-row: 7;
  }

  .dot-media {
    grid-column: 2;
    grid-row: 7;
  }

  .dot-link-copy {
    position: absolute;
    top: 50%;
    left: 22px;
    display: grid;
    width: max-content;
    gap: 3px;
    opacity: 0;
    transform: translate(-8px, -50%);
    transition:
      opacity 250ms ease,
      transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dot-link-copy strong {
    font-size: 0.80rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .dot-link-copy small {
    color: #777b74;
    font-size: 0.64rem;
    letter-spacing: 0.12em;
  }

  .dot-link:hover .nav-dot {
    background: #b7ff00;
    transform: scale(1.35);
    box-shadow:
      0 0 10px rgba(183, 255, 0, 0.85),
      0 0 28px rgba(183, 255, 0, 0.3);
  }

  .dot-link:hover .dot-link-copy {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .dot-link:nth-child(2) .nav-dot {
    border-color: #ff4d00;
  }

  .dot-link:nth-child(2):hover .nav-dot {
    background: #ff4d00;
    box-shadow:
      0 0 10px rgba(255, 77, 0, 0.8),
      0 0 28px rgba(255, 77, 0, 0.3);
  }


  /* VIBE navigation dot = white ring */
  .dot-vibe .nav-dot {
    border-color: rgba(245, 245, 242, 0.82);
    background: #050505;
    box-shadow: 0 0 5px rgba(245, 245, 242, 0.10);
  }

  .dot-vibe:hover .nav-dot {
    background: #050505;
    border-color: #f5f5f2;
    transform: scale(1.35);
    box-shadow:
      0 0 8px rgba(245, 245, 242, 0.55),
      0 0 18px rgba(245, 245, 242, 0.18);
  }

  /* MEDIA navigation dot = small white center point */
  .dot-media .nav-dot {
    width: 4px;
    height: 4px;

    margin: 3px;

    border: 0;
    background: #f5f5f2;

    box-shadow:
      0 0 5px rgba(245, 245, 242, 0.55);
  }

  .dot-media:hover .nav-dot {
    background: #f5f5f2;
    transform: scale(1.55);

    box-shadow:
      0 0 7px rgba(245, 245, 242, 0.85),
      0 0 16px rgba(245, 245, 242, 0.24);
  }

  .signal {
    position: absolute;
    right: 24px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 7px;
    color: #8f948c;
    font-family: 'Maple Mono', monospace;
    font-size: 0.80rem;
    letter-spacing: 0.14em;
  }

  .signal-light {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b7ff00;
    box-shadow:
      0 0 8px rgba(183, 255, 0, 0.72),
      0 0 16px rgba(183, 255, 0, 0.22);
    animation: signal-pulse 1.8s ease-in-out infinite;
  }

  .hero-motion {
    opacity: 0;
    transform: translateY(105%);
    will-change: transform, opacity;
    animation: hero-line-up 2.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .motion-1 { animation-delay: 0.05s; }
  .motion-2 { animation-delay: 0.15s; }
  .motion-3 { animation-delay: 0.25s; }
  .motion-4 { animation-delay: 0.4s; }
  .motion-5 { animation-delay: 1.05s; }

  @keyframes hero-line-up {
    from {
      opacity: 0;
      transform: translateY(105%);
    }
    to {
      opacity: 1;
      transform: translateY(-3mm);
    }
  }

  @keyframes signal-pulse {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 1100px) and (min-width: 821px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
      gap: 40px;
    }


    .hero-title {
      font-size: clamp(3.1rem, 5.1vw, 5.4rem);
    }
  }

  @media (max-width: 820px) {
    .hero {
      overflow: visible;
    }

    .hero-grid {
      width: calc(100% - 32px);
      grid-template-columns: 1fr;
      gap: 54px;
      padding-top: 120px;
      padding-bottom: 54px;
      transform: translateY(-88px);
    }

    .hero-copy {
      left: 0;
    }
    

    .hero-title {
      font-size: clamp(2.7rem, 9.7vw, 4.8rem);
      line-height: 0.88;
    }

    .dot-visual {
      left: 0;
      width: 100%;
      justify-self: center;
      justify-content: center;
    }

    .dot-stage {
      width: min(100%, 460px);
      max-width: 460px;
      margin: 0 auto;
    }

    .dot-links {
      pointer-events: auto;
    }
  }

  @media (max-width: 520px) {
    .hero-grid {
      width: calc(100% - 28px);
    }

    .eyebrow {
      margin-bottom: 18px;
      font-size: 0.6rem;
    }

    .hero-title {
      font-size: clamp(2rem, 9.2vw, 3.2rem);
      line-height: 0.9;
      letter-spacing: -0.05em;
    }

    .title-outline {
      -webkit-text-stroke-width: 1.2px;
    }

    .hero-description {
      margin-top: 25px;
      font-size: 0.95rem;
    }

    .dot-stage {
      border-radius: 14px;
    }

    .dot-grid,
    .dot-links {
      inset: 96px 28px 78px;
      gap: 8px;
    }

    .dot-link-copy {
      opacity: 1;
      transform: translate(0, -50%);
    }

    .matrix-heading {
      top: 21px;
      left: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jp-ghost-title.jp-run .jp-ghost-text::before {
      animation: none;
      opacity: 0;
    }
  }
</style>






























<!-- =========================================================
     JAPANESE GHOST TITLE
     ========================================================= -->
<div class="jp-ghost-title" aria-hidden="true">
  <div class="jp-ghost-text">
    <span style="--i:0; --x:-7px; --y:8px; --r:-2deg;">神</span>
    <span style="--i:1; --x:4px;  --y:-6px; --r:1deg;">の</span>
    <span style="--i:2; --x:-3px; --y:10px; --r:-1deg;">裁</span>
    <span style="--i:3; --x:6px;  --y:-8px; --r:2deg;">き</span>
    <span style="--i:4; --x:-5px; --y:5px; --r:-1deg;">と</span>
    <span style="--i:5; --x:3px;  --y:-9px; --r:1deg;">訣</span>
    <span style="--i:6; --x:-6px; --y:7px; --r:-2deg;">別</span>
    <span style="--i:7; --x:5px;  --y:-5px; --r:1deg;">す</span>
    <span style="--i:8; --x:-4px; --y:9px; --r:-1deg;">る</span>
    <span style="--i:9; --x:6px;  --y:-7px; --r:2deg;">た</span>
    <span style="--i:10;--x:-3px; --y:6px; --r:-1deg;">め</span>
  </div>

  <span class="jp-lime-cloud" aria-hidden="true"></span>
  <span class="jp-ghost-line"></span>
</div>

<style>
  /* =========================================================
     JAPANESE GHOST TITLE
     Hero finishes at approx. 4.55s
     ========================================================= */

  .jp-ghost-title {
    position: fixed;
    top: 108px;
    left: 50%;
    z-index: 20;

    width: max-content;

    pointer-events: none;

    transform: translateX(-50%);
  }

  .jp-ghost-text {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #f5f5f2;

    font-family:
      'BIZ UDPMincho', 'Yu Mincho', 'YuMincho', serif;

    font-size: clamp(1.40rem, 1.95vw, 2.10rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.38em;

    white-space: nowrap;
  }

  .jp-ghost-text > span {
    display: inline-block;

    opacity: 0;

    filter: blur(7px);

    transform:
      translate(var(--x), var(--y))
      rotate(var(--r));

    animation:
      jp-character-lock 1400ms
      cubic-bezier(0.16, 1, 0.3, 1)
      forwards,

      jp-character-vanish 650ms
      cubic-bezier(0.4, 0, 1, 1)
      forwards;

    animation-delay:
      calc(0.45s + (var(--i) * 180ms)),
      3.35s;
  }

  .jp-ghost-title.jp-run .jp-ghost-line {
    position: absolute;

    left: 50%;
    bottom: -13px;

    width: calc(100% - 4px);
    height: 1px;

    opacity: 0;

    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 92, 32, 0.05) 15%,
      rgba(255, 92, 32, 0.42) 50%,
      rgba(255, 92, 32, 0.05) 85%,
      transparent 100%
    );

    box-shadow:
