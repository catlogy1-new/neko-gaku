<script is:inline>
  const startHeroSequence = () => {
    const jp = document.querySelector('.jp-ghost-title');
    const matrix = document.querySelector('.dot-stage');

    if (jp) {
      jp.classList.remove('jp-run');
      void jp.offsetWidth;
      jp.classList.add('jp-run');
    }

    if (matrix) {
      matrix.classList.remove('matrix-run');
      void matrix.offsetWidth;

      setTimeout(() => {
        matrix.classList.add('matrix-run');
      }, 500);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startHeroSequence, { once: true });
  } else {
    startHeroSequence();
  }

  document.addEventListener('astro:page-load', startHeroSequence);
</script>


