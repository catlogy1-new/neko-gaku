<script is:inline>
  (() => {
    const MOBILE_QUERY = '(max-width: 820px)';

    const findExactText = (text) => {
      const candidates = Array.from(
        document.querySelectorAll('a, h1, h2, h3, h4, p, div, span')
      );

      return candidates.find((el) => {
        const value = (el.textContent || '').replace(/\s+/g, ' ').trim();
        return value === text;
      }) || null;
    };

    const findMatrixBlock = () => {
      const heading = findExactText('NAVIGATION MATRIX');
      if (!heading) return null;

      return (
        heading.closest('section') ||
        heading.closest('article') ||
        heading.closest('[class*="matrix"]') ||
        heading.closest('[class*="nav"]') ||
        heading.closest('[class*="card"]') ||
        heading.parentElement
      );
    };

    const applyMobileHomeTextTune = () => {
      if (!window.matchMedia(MOBILE_QUERY).matches) {
        return;
      }

      const pour = findExactText('POUR EN FINIR');
      if (pour) {
        pour.setAttribute('data-mobile-pour-en-finir', 'true');
      }

      const hiddenTitle = findExactText("You can't catch me");
      const matrixBlock = findMatrixBlock();

      if (hiddenTitle) {
        hiddenTitle.setAttribute('data-mobile-hidden-page-title', 'true');
      }

      if (hiddenTitle) {
        const footer = document.querySelector('.site-footer');

        if (footer && footer.parentNode) {
          footer.parentNode.insertBefore(hiddenTitle, footer);
        }

        const oldStage = document.querySelector('.catch-me-stage');

        if (oldStage && oldStage.children.length === 0) {
          oldStage.style.display = 'none';
        }
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        applyMobileHomeTextTune,
        { once: true }
      );
    } else {
      applyMobileHomeTextTune();
    }

    document.addEventListener(
      'astro:page-load',
      applyMobileHomeTextTune
    );
  })();
</script>
