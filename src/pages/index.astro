<style>
/* =========================================================
   JP FINAL TIMELINE OVERRIDE
   CSS animation conflicts disabled.
   Timeline is controlled by JS.
   ========================================================= */

/* 古い疑似要素のライム雲は完全停止 */
.jp-ghost-title .jp-ghost-text::before,
.jp-ghost-title.jp-run .jp-ghost-text::before {
  content: none !important;
  display: none !important;
  animation: none !important;
}

/* 古い文字animationを停止 */
.jp-ghost-title .jp-ghost-text > span,
.jp-ghost-title.jp-run .jp-ghost-text > span {
  animation: none !important;
}

/* 古い下線animationを停止 */
.jp-ghost-title .jp-ghost-line,
.jp-ghost-title.jp-run .jp-ghost-line {
  animation: none !important;
}

/* 実ライム雲 */
.jp-lime-cloud {
  position: absolute;

  top: 50%;
  left: 50%;
  z-index: -1;

  width: 110%;
  height: 120%;

  opacity: 0;

  pointer-events: none;

  background:
    radial-gradient(
      ellipse at center,
      rgba(183, 255, 0, 0.78) 0%,
      rgba(183, 255, 0, 0.52) 18%,
      rgba(183, 255, 0, 0.30) 38%,
      rgba(183, 255, 0, 0.14) 62%,
      transparent 82%
    );

  filter: blur(9px);

  transform:
    translate(-50%, -50%)
    scaleX(0.03)
    scaleY(0.72);

  transform-origin: center center;
}

/* 初期状態 */
.jp-ghost-text > span {
  opacity: 0;
}

.jp-ghost-line {
  opacity: 0;

  transform:
    translateX(-50%)
    scaleX(0);

  transform-origin: center center;
