<script is:inline>
(() => {
  const initUnifiedMatrix = () => {
    const root = document.querySelector('.dot-stage');
    if (!root) return;

    /* Safe on reload / Astro navigation: rebuild once per current DOM. */
    if (root.dataset.unifiedMatrixReady === '1') return;
    root.dataset.unifiedMatrixReady = '1';

    const info = root.querySelector('.matrix-hover-info');
    const dateEl = root.querySelector('.matrix-hover-date');
    const kindEl = root.querySelector('.matrix-hover-kind');

    const dots = [...root.querySelectorAll('.grid-dot')];

    dots.forEach((dot, index) => {
      const entries = [];

      if (Number(dot.dataset.blog) > 0 && dot.dataset.blogHref) {
        entries.push(['BLOG', dot.dataset.blogHref]);
      }
      if (Number(dot.dataset.portfolio) > 0 && dot.dataset.portfolioHref) {
        entries.push(['PORTFOLIO', dot.dataset.portfolioHref]);
      }
      if (Number(dot.dataset.vibe) > 0 && dot.dataset.vibeHref) {
        entries.push(['PULSE', dot.dataset.vibeHref]);
      }
      if (Number(dot.dataset.media) > 0 && dot.dataset.mediaHref) {
        entries.push(['MEDIA', dot.dataset.mediaHref]);
      }

      if (!entries.length) return;

      dot.classList.add('has-content');

      /* Last 4 columns open labels to the left so text never gets cut off. */
      const column = Math.floor(index / 7);
      if (column >= 7) dot.classList.add('copy-left');

      const labels = entries.map(([label]) => label);
      const copy = dot.querySelector('.grid-dot-copy strong');
      const actions = dot.querySelector('.grid-dot-actions');

      if (copy) copy.textContent = labels.join(' / ');

      if (actions) {
        actions.replaceChildren();

        entries.forEach(([label, href]) => {
          const link = document.createElement('a');
          link.href = href;
          link.textContent = entries.length === 1 ? 'ENTER ↗' : `${label} ↗`;
          link.setAttribute('aria-label', `Open ${label}`);

          link.style.cssText = `
            display:inline-flex;
            align-items:center;
            justify-content:center;
            min-height:20px;
            padding:3px 8px 4px;
            border:1px solid rgba(245,245,242,.10);
            border-radius:4px;
            background:rgba(150,154,148,.14);
            color:rgba(245,245,242,.74);
            font-size:.66rem;
            font-weight:600;
            line-height:1;
            letter-spacing:.06em;
            text-decoration:none;
            background-image:none;
            box-shadow:none;
          `;

          actions.append(link);
        });
      }

      let hideTimer = 0;

      const cancelHide = () => {
        if (hideTimer) {
          window.clearTimeout(hideTimer);
          hideTimer = 0;
        }
      };

      const showInfo = () => {
        cancelHide();
        if (dateEl) dateEl.textContent = (dot.dataset.date || '').replaceAll('-', '.');
        if (kindEl) kindEl.textContent = labels.join(' / ');
        info?.classList.add('is-visible');
        dot.classList.add('is-popup-open');
      };

      const hideInfo = () => {
        cancelHide();
        hideTimer = window.setTimeout(() => {
          info?.classList.remove('is-visible');
          dot.classList.remove('is-popup-open');
          hideTimer = 0;
        }, 520);
      };

      const popup = dot.querySelector('.grid-dot-copy');

      dot.addEventListener('mouseenter', showInfo);
      dot.addEventListener('focusin', showInfo);
      dot.addEventListener('mouseleave', hideInfo);

      popup?.addEventListener('mouseenter', showInfo);
      popup?.addEventListener('mouseleave', hideInfo);

      dot.addEventListener('focusout', (event) => {
        if (!dot.contains(event.relatedTarget)) hideInfo();
      });

      /* One category: clicking the dot itself opens it.
         Multiple categories: choose the visible BLOG/PULSE/MEDIA/etc link. */
      if (entries.length === 1) {
        dot.tabIndex = 0;
        dot.setAttribute('role', 'link');

        dot.addEventListener('click', (event) => {
          if (event.target.closest?.('.grid-dot-actions a')) return;
          window.location.href = entries[0][1];
        });

        dot.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            window.location.href = entries[0][1];
          }
        });
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUnifiedMatrix, { once: true });
  } else {
    initUnifiedMatrix();
  }

  document.addEventListener('astro:page-load', initUnifiedMatrix);
})();
</script>



