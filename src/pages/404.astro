---
import BaseLayout from '../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(href: string) {
  if (href === '/') return `${basePath}/` || '/';
  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}
---

<BaseLayout
  title="404 — Page Not Found"
  description="The page you are looking for could not be found."
>
  <main class="nexus-404" aria-labelledby="error-title">
    <section class="error-content">
      <p class="error-code">ERROR <span>404</span></p>

      <div class="error-rule" aria-hidden="true"></div>

      <h1 id="error-title">
        PAGE NOT<br />
        <span>FOUND<span class="error-dot">.</span></span>
      </h1>

      <p class="error-description">
        This page no longer exists, or the link may have changed.
        Find your way back to NEXUS.
      </p>

      <nav class="error-actions" aria-label="Navigation">
        <a class="error-primary" href={withBase('/')}>
          BACK TO HOME <span aria-hidden="true">↗</span>
        </a>
        <a class="error-secondary" href={withBase('/blog')}>
          EXPLORE BLOG <span aria-hidden="true">↗</span>
        </a>
      </nav>

      <p class="error-footer">NEXUS <span>—</span> LOST IN THE ARCHIVE</p>
    </section>
  </main>
</BaseLayout>

<style>
  .nexus-404 {
    box-sizing: border-box;
    min-height: calc(100svh - 100px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 72px 28px 96px;
    background: #050505;
    color: #f5f5f5;
  }

  .error-content {
    width: min(100%, 800px);
    margin-inline: auto;
  }

  .error-code {
    margin: 0;
    color: #a8ff21;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .24em;
  }

  .error-code span {
    color: #f5f5f5;
  }

  .error-rule {
    height: 1px;
    margin: 22px 0 34px;
    background: linear-gradient(90deg, #a8ff21, #303030 45%, #303030);
  }

  h1 {
    margin: 0;
    max-width: none;
    color: #f5f5f5;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(52px, 9vw, 110px);
    font-weight: 800;
    line-height: .98;
    letter-spacing: -.065em;
  }

  .error-dot {
    color: #a8ff21;
  }

  .error-description {
    max-width: 440px;
    margin: 32px 0 0;
    color: #a0a0a0;
    font-size: clamp(14px, 1.5vw, 16px);
    line-height: 1.8;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .error-actions a {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-height: 48px;
    padding: 12px 18px;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    line-height: 1.3;
    text-decoration: none;
    transition: border-color .2s, background .2s, color .2s;
  }

  .error-actions .error-primary {
    background: #a8ff21;
    border-color: #a8ff21;
    color: #090909;
  }

  .error-actions .error-secondary {
    background: #111;
    border-color: #383838;
    color: #f5f5f5;
  }

  .error-actions .error-primary:hover {
    background: #c1ff69;
  }

  .error-actions .error-secondary:hover {
    border-color: #a8ff21;
    color: #a8ff21;
  }

  .error-actions a:focus-visible {
    outline: 2px solid #a8ff21;
    outline-offset: 4px;
  }

  .error-footer {
    margin: 72px 0 0;
    color: #686868;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 10px;
    letter-spacing: .15em;
  }

  .error-footer span {
    color: #a8ff21;
  }

  @media (max-width: 720px) {
    .nexus-404 {
      min-height: calc(100svh - 90px);
      align-items: center;
      padding: 72px 24px 88px;
    }

    .error-rule {
      margin: 18px 0 28px;
    }

    h1 {
      font-size: clamp(45px, 11vw, 72px);
      letter-spacing: -.06em;
    }

    .error-description {
      margin-top: 26px;
      max-width: 320px;
      font-size: 14px;
      line-height: 1.75;
    }

    .error-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 30px;
    }

    .error-actions a {
      width: 100%;
      min-height: 50px;
    }

    .error-footer {
      margin-top: 58px;
      font-size: 9px;
      line-height: 1.8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-actions a {
      transition: none;
    }
  }
</style>