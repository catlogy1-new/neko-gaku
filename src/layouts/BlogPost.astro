---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ScrollToTopButton from '../components/ScrollToTopButton.astro';
import SmartImage from '../components/SmartImage.astro';
import BlogTopNav from '../components/blog/BlogTopNav.astro';
import MermaidRenderer from '@navfolio/mdx-components/MermaidRenderer.astro';
import { getSiteConfig } from '../data/site';
import { getHtmlLang } from '../utils/ui-text';

type Props = CollectionEntry<'blog'>['data'];

const {
  title,
  description,
  date,
  heroImage,
} = Astro.props;

const siteConfig = await getSiteConfig();
const palette = siteConfig.theme.palette;
const htmlLang = getHtmlLang(siteConfig);
---

<!doctype html>

<html lang={htmlLang} data-palette={palette}>
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <BlogTopNav />

    <main data-pagefind-body>
      <article class="article-shell">
        <div class="article-prose">
          <header class="article-header">
            <p class="article-kicker">
              TRANSMISSION / ENTRY
            </p>

            <div class="article-date">
              <span class="date-signal" aria-hidden="true"></span>
              <FormattedDate date={date} />
            </div>

            <h1>{title}</h1>

            <div class="article-rule" aria-hidden="true"></div>
          </header>

          {
            heroImage && (
              <div class="hero-image">
                <SmartImage
                  width={1020}
                  height={510}
                  src={heroImage}
                  alt=""
                />
              </div>
            )
          }

          <div class="article-content">
            <slot />
          </div>
        </div>
      </article>
    </main>

    <ScrollToTopButton />
    <Footer />
    <MermaidRenderer />
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    background: #050505;
  }

  :global(body) {
    margin: 0;
    color: #e7e8e4;
  }

  main {
    width: min(100%, var(--layout-shell-width));
    max-width: none;
    margin: 0 auto;
    padding:
      138px
      var(--layout-page-gutter)
      var(--layout-page-bottom);
  }

  .article-shell {
    width: 100%;
  }

  .article-prose {
    width: min(100%, 860px);
    margin: 0 auto;
    color: #a5aaa2;
  }

  .article-header {
    position: relative;
    margin: 0 0 46px;
    padding: 0 0 34px;
  }

  .article-kicker {
    margin: 0 0 20px;
    color: #b7ff00;
    font-family: 'Maple Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .article-date {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    color: #777c74;
    font-family: 'Maple Mono', monospace;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .date-signal {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #ff6734;
    box-shadow:
      0 0 6px rgba(255, 103, 52, 0.36),
      0 0 13px rgba(255, 103, 52, 0.12);
  }

  .article-header h1 {
    max-width: 900px;
    margin: 0;
    color: #e7e8e4;
    font-family:
      'Inter Variable',
      'Helvetica Neue',
      Arial,
      sans-serif;
    font-size: clamp(3rem, 6vw, 6.4rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.065em;
    text-transform: uppercase;
  }

  .article-rule {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        rgba(255, 103, 52, 0.34),
        rgba(255, 103, 52, 0.1) 55%,
        transparent
      );
  }

  .article-rule::after {
    position: absolute;
    right: 0;
    top: 0;
    width: 44px;
    height: 1px;
    background: #ff6734;
    box-shadow:
      0 0 7px rgba(255, 103, 52, 0.16);
    content: '';
  }

  .hero-image {
    width: 100%;
    margin: 0 0 46px;
  }

  .hero-image :global(img) {
    display: block;
    width: 100%;
    margin: 0 auto;
    border: 1px solid rgba(183, 255, 0, 0.12);
    border-radius: 8px;
    filter:
      saturate(0.82)
      contrast(1.02);
    box-shadow:
      0 18px 50px rgba(0, 0, 0, 0.32);
  }

  .article-content {
    color: #a4a9a1;
    font-family:
      'Inter Variable',
      'Helvetica Neue',
      Arial,
      sans-serif;
    font-size: 1.05rem;
    font-weight: 420;
    line-height: 1.85;
    letter-spacing: -0.008em;
  }

  .article-content :global(p) {
    margin: 0 0 1.55em;
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    color: #e7e8e4;
    font-family:
      'Inter Variable',
      'Helvetica Neue',
      Arial,
      sans-serif;
    font-weight: 720;
    letter-spacing: -0.04em;
  }

  .article-content :global(h2) {
    position: relative;
    margin: 2.2em 0 0.8em;
    padding-left: 18px;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    line-height: 1.08;
  }

  .article-content :global(h2)::before {
    position: absolute;
    top: 0.18em;
    bottom: 0.16em;
    left: 0;
    width: 2px;
    background: #b7ff00;
    box-shadow:
      0 0 8px rgba(183, 255, 0, 0.14);
    content: '';
  }

  .article-content :global(h3) {
    margin: 1.9em 0 0.65em;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.18;
  }

  .article-content :global(h4) {
    margin: 1.6em 0 0.6em;
    font-size: 1.12rem;
  }

  .article-content :global(a) {
    color: #b7ff00;
    text-decoration-color: rgba(183, 255, 0, 0.34);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition:
      color 200ms ease,
      text-decoration-color 200ms ease,
      text-shadow 220ms ease;
  }

  .article-content :global(a:hover) {
    color: #d1ff63;
    text-decoration-color: #b7ff00;
    text-shadow:
      0 0 7px rgba(183, 255, 0, 0.13);
  }

  .article-content :global(strong) {
    color: #d9dbd7;
    font-weight: 650;
  }

  .article-content :global(em) {
    color: #b2b7af;
  }

  .article-content :global(blockquote) {
    margin: 2em 0;
    padding: 4px 0 4px 20px;
    border-left: 1px solid #ff6734;
    color: #8f958c;
    font-style: normal;
  }

  .article-content :global(:not(pre) > code) {
    padding: 0.15em 0.4em;
    border: 1px solid rgba(183, 255, 0, 0.13);
    border-radius: 4px;
    background: rgba(183, 255, 0, 0.035);
    color: #c8ff45;
    font-family:
      'Maple Mono',
      monospace;
    font-size: 0.88em;
  }

  .article-content :global(pre) {
    overflow-x: auto;
    margin: 2em 0;
    padding: 20px;
    border: 1px solid rgba(183, 255, 0, 0.12);
    border-radius: 7px;
    background: #090a09;
    color: #d5d8d2;
    box-shadow:
      inset 0 0 30px rgba(183, 255, 0, 0.012);
  }

  .article-content :global(pre code) {
    font-family:
      'Maple Mono',
      monospace;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 1.4em 0 1.7em;
    padding-left: 1.5em;
  }

  .article-content :global(li) {
    margin: 0.45em 0;
  }

  .article-content :global(li::marker) {
    color: #b7ff00;
  }

  .article-content :global(hr) {
    height: 1px;
    margin: 2.5em 0;
    border: 0;
    background:
      linear-gradient(
        90deg,
        rgba(255, 103, 52, 0.28),
        rgba(255, 103, 52, 0.05),
        transparent
      );
  }

  .article-content :global(img) {
    max-width: 100%;
    border-radius: 7px;
    border: 1px solid rgba(183, 255, 0, 0.09);
  }

  .article-content :global(.mermaid-diagram) {
    overflow-x: auto;
    margin: 30px 0 34px;
    padding: 22px;
    border: 1px solid rgba(183, 255, 0, 0.12);
    border-radius: 8px;
    background: #090a09;
  }

  .article-content :global(.mermaid-diagram .mermaid) {
    min-width: max-content;
    margin: 0;
    padding: 0;
    background: transparent;
    color: #d7dad4;
    font-family: 'Maple Mono', monospace;
    font-size: 0.9rem;
    text-align: center;
  }

  .article-content :global(.mermaid-diagram svg) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  @media (max-width: 720px) {
    main {
      padding:
        104px
        18px
        42px;
    }

    .article-prose {
      width: 100%;
    }

    .article-header {
      margin-bottom: 34px;
      padding-bottom: 26px;
    }

    .article-kicker {
      margin-bottom: 15px;
      font-size: 0.65rem;
    }

    .article-header h1 {
      font-size: clamp(2.5rem, 12vw, 4.4rem);
      line-height: 0.92;
    }

    .article-content {
      font-size: 1rem;
      line-height: 1.78;
    }
  }
  /* =========================================================
     ARTICLE TITLE 窶・FORCE TYPOGRAPHY
     ========================================================= */

  .article-header h1 {
    font-family:
      Arial,
      "Helvetica Neue",
      Helvetica,
      sans-serif !important;

    font-size: clamp(3.2rem, 6vw, 6.4rem) !important;
    font-weight: 800 !important;
    line-height: 0.9 !important;
    letter-spacing: -0.065em !important;

    color: #e7e8e4 !important;

    text-transform: uppercase !important;
  }


  /* =========================================================
     BLOG TYPOGRAPHY — FINAL
     ========================================================= */

  .article-content {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "Noto Sans JP",
      sans-serif !important;

    font-size: 18px;
    font-weight: 400;
    line-height: 1.9;
    letter-spacing: -0.006em;
  }

  .article-header h1,
  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    font-family:
      "Host Grotesk Variable",
      "Host Grotesk",
      "Segoe UI",
      "Noto Sans JP",
      sans-serif !important;
  }

  @media (max-width: 720px) {
    .article-content {
      font-size: 17px;
      line-height: 1.86;
    }
  }
</style>
