<script is:inline>
(() => {
  const createAuthorFooter = () => {
    const author = document.createElement('section');
    author.className = 'nexus-author-footer';
    author.dataset.nexusAuthorFooter = '';

    author.innerHTML = `
      <div class="nexus-author-footer__avatar">
        <img src="/images/about/cat-icon.gif" alt="迪ｫ蟄ｦ" />
      </div>

      <div class="nexus-author-footer__body">
        <div class="nexus-author-footer__head">
          <span class="nexus-author-footer__written">Written by</span>
          <span class="nexus-author-footer__name">猫学</span>

          <span class="nexus-author-footer__socials">
            <a
              class="nexus-author-footer__social"
              href="https://x.com/catology110"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M18.901 2H22l-6.77 7.736L23.2 22h-6.247l-4.894-6.989L5.94 22H2.84l7.24-8.274L.8 2h6.406l4.424 6.322L18.901 2Zm-1.096 18h1.717L6.273 3.894H4.43L17.805 20Z"/>
              </svg>
            </a>

            <a
              class="nexus-author-footer__social"
              href="https://www.youtube.com/@nekogaku"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M23.498 6.186a2.986 2.986 0 0 0-2.102-2.112C19.533 3.5 12 3.5 12 3.5s-7.533 0-9.396.574A2.986 2.986 0 0 0 .502 6.186 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .502 5.814 2.986 2.986 0 0 0 2.102 2.112C4.467 20.5 12 20.5 12 20.5s7.533 0 9.396-.574a2.986 2.986 0 0 0 2.102-2.112A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/>
              </svg>
            </a>
          </span>
        </div>

        <div class="nexus-author-footer__quote">
          No bird can fly higher than imagination.
        </div>
      </div>
    `;

    return author;
  };

  const mountAuthorFooter = () => {
    document
      .querySelectorAll('[data-nexus-author-footer]')
      .forEach((element) => element.remove());

    const actions = document.querySelector('.article-card .nexus-article-actions');
    if (!actions) return;

    actions.insertAdjacentElement('afterend', createAuthorFooter());
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountAuthorFooter, { once: true });
  } else {
    mountAuthorFooter();
  }

  document.addEventListener('astro:page-load', mountAuthorFooter);
})();
</script>

