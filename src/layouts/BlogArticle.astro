---
import { type CollectionEntry, getCollection } from 'astro:content';
import ArticleHeader from '../components/article/ArticleHeader.astro';
import ArticleActions from '../components/article/ArticleActions.astro';
import ArticleActionMenus from '../components/article/ArticleActionMenus.astro';
import BlogTopNav from '../components/blog/BlogTopNav.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import ScrollToTopButton from '../components/ScrollToTopButton.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import CommentSection from '../components/comments/CommentSection.astro';
import MermaidRenderer from '@navfolio/mdx-components/MermaidRenderer.astro';
import ZoomableImage from '@navfolio/mdx-components/ZoomableImage.astro';
import { getThemePalette, getSiteConfig } from '../data/site';
import { resolveCommentsConfig, supportsCommentSection } from '../utils/comments';
import { sortByDateDesc } from '../utils/content-dates';
import { getSeriesContext, slugifyGroupName } from '../utils/content-groups';
import { buildTocTree, countTocItems } from '../utils/toc-tree';
import { getUiText } from '../utils/ui-text';
import '@navfolio/theme-default/styles/blog-article.css';
import '../styles/blog-article-nexus.css';

const siteConfig = await getSiteConfig();
const { comments: rawComments } = siteConfig;
const comments = resolveCommentsConfig(rawComments);
const ui = getUiText(siteConfig);

type SidebarConfig = {
  enable?: boolean;
  toc?: boolean;
  relatedPosts?: boolean;
};

interface Props {
  post?: {
    id: string;
    collection?: string;
    body?: string;
    data: {
      title: string;
      description: string;
      japaneseTitle?: string;
      japaneseDescription?: string;
      japaneseBody?: string;
      date: Date;
      heroImage?: ImageMetadata | string;
      showHeroImage?: boolean;
      tags?: string[];
      categories?: string[];
      series?: string[];
      comments?: boolean;
      draft?: boolean;
      sticky?: boolean | number;
      sidebar?: SidebarConfig;
    };
  };
  headings?: { depth: number; slug: string; text: string }[];
  sidebar?: SidebarConfig;
  headerVariant?: 'default' | 'archive';
  headerKicker?: string;
  headerNote?: string;
  title?: string;
  description?: string;
  date?: Date;
  heroImage?: ImageMetadata | string;
  showHeroImage?: boolean;
  tags?: string[];
  categories?: string[];
  series?: string[];
  contentFont?: 'article' | 'ui';
}

const props = Astro.props;
const palette = await getThemePalette();
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const headings = props.headings ?? [];
const post = props.post ?? {
  id: 'standalone',
  collection: 'standalone',
  body: props.description ?? '',
  data: {
    title: props.title ?? 'Untitled',
    description: props.description ?? '',
    date: props.date ?? new Date(),
    heroImage: props.heroImage,
    showHeroImage: props.showHeroImage ?? true,
    tags: props.tags ?? [],
    categories: props.categories ?? [],
    series: props.series ?? [],
    draft: false,
    sidebar: { enable: true, toc: true, relatedPosts: true },
  },
};
const isBlogPost = post.collection === 'blog';
const shouldMountCommentSection = supportsCommentSection(post.collection);
const { title, description, date, heroImage, showHeroImage = true } = post.data;
const japaneseTitle = (post.data.japaneseTitle ?? '').trim();
const japaneseDescription = (post.data.japaneseDescription ?? '').trim();
const japaneseBody = (post.data.japaneseBody ?? '').trim();
const hasJapaneseTranslation = isBlogPost && Boolean(japaneseTitle && japaneseDescription && japaneseBody);
const japaneseParagraphs = hasJapaneseTranslation
  ? japaneseBody.split(/\n\s*\n/).filter(Boolean)
  : [];
const contentFont = props.contentFont ?? 'article';
const bodyText = 'body' in post && typeof post.body === 'string' ? post.body : description;
const englishWords = bodyText.match(/[A-Za-z0-9]+(?:['遯ｶ繝ｻ][A-Za-z0-9]+)*/g) ?? [];
const cjkChars =
  bodyText.match(/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/gu) ?? [];
const wordCount = englishWords.length + cjkChars.length;
const readingMinutes = Math.max(1, Math.ceil(englishWords.length / 220 + cjkChars.length / 500));
const readingTime = ui.article.readingTime(readingMinutes);
const tags = post.data.tags ?? [];
const tagLinks = tags.map((name) => ({
  name,
  slug: slugifyGroupName(name),
}));
const categoryLinks = (post.data.categories ?? []).map((name) => ({
  name,
  slug: slugifyGroupName(name),
}));
const rawSeries = post.data.series ?? [];
const tocItems = buildTocTree(headings);
const tocItemCount = countTocItems(tocItems);
const sidebarConfig = {
  enable: true,
  toc: true,
  relatedPosts: true,
  ...post.data.sidebar,
  ...props.sidebar,
};
const shouldRenderSidebar = sidebarConfig.enable ?? true;
const shouldRenderToc = sidebarConfig.toc ?? true;
const hasToc = shouldRenderToc && tocItemCount >= 2;

const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const currentBlogPost = isBlogPost ? (post as CollectionEntry<'blog'>) : undefined;
const seriesContext = isBlogPost
  ? getSeriesContext(currentBlogPost!, allBlogPosts, rawSeries[0])
  : undefined;
const seriesLinks = rawSeries.map((name) => {
  const isPrimarySeries = seriesContext?.name === name;

  return {
    name,
    slug: slugifyGroupName(name),
    current: isPrimarySeries ? seriesContext.current : undefined,
    total: isPrimarySeries ? seriesContext.total : undefined,
  };
});

/* NEXUS ARTICLE NEIGHBORS START */

const chronologicalBlogPosts = isBlogPost
  ? [...allBlogPosts].sort((a, b) => {
      const dateDifference =
        a.data.date.getTime() - b.data.date.getTime();

      if (dateDifference !== 0) {
        return dateDifference;
      }

      return a.id.localeCompare(b.id);
    })
  : [];

const chronologicalIndex =
  chronologicalBlogPosts.findIndex(
    ({ id }) => id === post.id
  );

const previousBlogPost =
  chronologicalIndex > 0
    ? chronologicalBlogPosts[
        chronologicalIndex - 1
      ]
    : undefined;

const nextBlogPost =
  chronologicalIndex >= 0 &&
  chronologicalIndex <
    chronologicalBlogPosts.length - 1
    ? chronologicalBlogPosts[
        chronologicalIndex + 1
      ]
    : undefined;

/* NEXUS ARTICLE NEIGHBORS END */

const relatedPosts = sortByDateDesc(allBlogPosts.filter(({ id }) => id !== post.id)).slice(0, 4);
const hasRelatedPosts =
  shouldRenderSidebar && (sidebarConfig.relatedPosts ?? true) && relatedPosts.length > 0;
const hasSidebar = false;
---

<!doctype html>
<html lang={ui.locale} data-palette={palette}>
  <head>
    <BaseHead title={title} description={description} />
    {
      comments.provider === 'waline' && comments.enabled && (
        <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
      )
    }
  </head>
  <body class:list={['blog-detail-page', { 'blog-content-ui': contentFont === 'ui' }]}>
    <BlogTopNav showTocIcon={false} tocItems={[]} />
    <div class="blog-background" aria-hidden="true"></div>

    <main class:list={['blog-layout', { 'blog-layout-centered': !hasSidebar }]} data-pagefind-body>
      <div class="article-column">
        <article class="article-card">
          <ArticleHeader
            title={title}
            description={description}
            japaneseTitle={japaneseTitle}
            japaneseDescription={japaneseDescription}
            hasJapaneseTranslation={hasJapaneseTranslation}
            sticky={'sticky' in post.data ? Boolean(post.data.sticky) : false}
            date={date}
            wordCount={wordCount}
            readingTime={readingTime}
            tags={tagLinks}
            categories={categoryLinks}
            series={seriesLinks}
            heroImage={heroImage}
            showHeroImage={showHeroImage}
            variant={props.headerVariant}
            kicker={props.headerKicker}
            note={props.headerNote}
            pathname={Astro.url.pathname}
            showPageView={isBlogPost}
          />

          {
            hasToc && (
              <section class="mobile-article-toc" aria-label={ui.toc.title}>
                <TableOfContents items={tocItems} compact collapsible font={contentFont} />
              </section>
            )
          }

          <section
            id="article-start"
            class:list={['article-content', { 'article-content-ui': contentFont === 'ui' }]}
          >
            <slot />
          </section>

          {hasJapaneseTranslation && (
            <section
              id="article-start-ja"
              class:list={['article-content', 'nexus-japanese-body', { 'article-content-ui': contentFont === 'ui' }]}
              lang="ja"
              aria-label="日本語訳"
              data-pagefind-ignore
              hidden
            >
              {japaneseParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          )}

          <ArticleActions tags={tagLinks} />
          <ArticleActionMenus />

          {
            seriesContext && (seriesContext.prev || seriesContext.next) && (
              <nav
                class="series-neighbor-nav"
                aria-label={ui.article.moreInSeries(seriesContext.name)}
              >
                {seriesContext.prev ? (
                  <a href={`${basePath}/blog/${seriesContext.prev.id}/`}>
                    <small>{ui.article.previousInSeries(seriesContext.name)}</small>
                    <span>{seriesContext.prev.data.title}</span>
                  </a>
                ) : (
                  <span />
                )}
                {seriesContext.next ? (
                  <a href={`${basePath}/blog/${seriesContext.next.id}/`} class="next">
                    <small>{ui.article.nextInSeries(seriesContext.name)}</small>
                    <span>{seriesContext.next.data.title}</span>
                  </a>
                ) : (
                  <span />
                )}
              </nav>
            )
          }

<!-- NEXUS PREV NEXT FINAL START -->

<style is:global>

/* =========================================================
   NEXUS PREVIOUS / NEXT
   BLACK / SQUARE / QUIET ORANGE HOVER
   ========================================================= */

.blog-detail-page .nexus-author-footer {
  margin-bottom: 0 !important;
}

.blog-detail-page .series-neighbor-nav {
  display: none !important;
}


/* divider */
.blog-detail-page .nexus-prevnext-divider {
  display: block;

  width: 100%;
  max-width: 665px;

  height: 0;

  margin:
    0
    auto
    0;

  border: 0;

  border-top:
    1px solid
    rgba(255,255,255,0.13);
}


/* two columns */
.blog-detail-page .nexus-prevnext-nav {
  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(0,1fr);

  gap: 14px;

  width: 100%;
  max-width: 665px;

  margin:
    38px
    auto
    0;
}


/* card */
.blog-detail-page .nexus-prevnext-card {
  position: relative;

  box-sizing: border-box;

  display: block;

  height: 94px;
  min-width: 0;

  padding:
    35px
    15px
    12px;

  overflow: hidden;

  background:
    #050505 !important;

  border:
    1px solid
    rgba(150,154,148,0.22) !important;

  border-radius:
    0 !important;

  box-shadow:
    none !important;

  color: inherit;

  text-decoration:
    none !important;

  transition:
    border-color 180ms ease,
    background-color 180ms ease;
}


/* =========================================================
   HOVER
   actual quiet orange used by existing card system
   ========================================================= */

.blog-detail-page .nexus-prevnext-card:hover,
.blog-detail-page .nexus-prevnext-card:focus-visible {
  background:
    #050505 !important;

  border-color:
    rgba(255,90,0,0.72) !important;

  box-shadow:
    none !important;

  outline:
    none !important;
}


/* label */
.blog-detail-page .nexus-prevnext-label {
  position: absolute;

  top: 12px;

  display: inline-flex;
  align-items: center;

  gap: 6px;

  margin: 0;

  color:
    #b7ff00 !important;

  font-family:
    "Inter Variable",
    "Helvetica Neue",
    Arial,
    sans-serif;

  font-size:
    0.67rem;

  font-weight:
    650;

  line-height:
    1;

  letter-spacing:
    0.105em;

  text-transform:
    uppercase;
}

.blog-detail-page
.nexus-prevnext-card.is-prev
.nexus-prevnext-label {
  left: 15px;
}

.blog-detail-page
.nexus-prevnext-card.is-next
.nexus-prevnext-label {
  right: 15px;
}

.blog-detail-page .nexus-prevnext-arrow {
  color:
    #b7ff00 !important;

  font-size:
    0.76rem;

  font-weight:
    700;

  line-height:
    1;
}


/* title */
.blog-detail-page .nexus-prevnext-title {
  display:
    -webkit-box;

  width:
    100%;

  overflow:
    hidden;

  -webkit-box-orient:
    vertical;

  -webkit-line-clamp:
    2;

  line-clamp:
    2;

  color:
    #c7cac4 !important;

  font-family:
    "Host Grotesk Variable",
    "Inter Variable",
    "Helvetica Neue",
    Arial,
    sans-serif;

  font-size:
    0.88rem;

  font-weight:
    600;

  line-height:
    1.34;

  letter-spacing:
    -0.012em;

  text-overflow:
    ellipsis;

  transition:
    transform
    180ms
    cubic-bezier(0.16,1,0.3,1);
}


.blog-detail-page
.nexus-prevnext-card.is-prev
.nexus-prevnext-title {
  text-align:
    left;

  transform:
    translateX(0);
}

.blog-detail-page
.nexus-prevnext-card.is-next
.nexus-prevnext-title {
  text-align:
    right;

  transform:
    translateX(0);
}


/* hover = movement only */
.blog-detail-page
.nexus-prevnext-card.is-prev:hover
.nexus-prevnext-title,

.blog-detail-page
.nexus-prevnext-card.is-prev:focus-visible
.nexus-prevnext-title {
  color:
    #c7cac4 !important;

  transform:
    translateX(3px);
}


.blog-detail-page
.nexus-prevnext-card.is-next:hover
.nexus-prevnext-title,

.blog-detail-page
.nexus-prevnext-card.is-next:focus-visible
.nexus-prevnext-title {
  color:
    #c7cac4 !important;

  transform:
    translateX(-3px);
}


/* labels never change */
.blog-detail-page
.nexus-prevnext-card:hover
.nexus-prevnext-label,

.blog-detail-page
.nexus-prevnext-card:focus-visible
.nexus-prevnext-label,

.blog-detail-page
.nexus-prevnext-card:hover
.nexus-prevnext-arrow,

.blog-detail-page
.nexus-prevnext-card:focus-visible
.nexus-prevnext-arrow {
  color:
    #b7ff00 !important;
}


@media (max-width: 700px) {

  .blog-detail-page .nexus-prevnext-divider,
  .blog-detail-page .nexus-prevnext-nav {
    max-width:
      100%;
  }

  .blog-detail-page .nexus-prevnext-nav {
    grid-template-columns:
      1fr;

    gap:
      10px;
  }

  .blog-detail-page .nexus-prevnext-card {
    height:
      88px;

    padding:
      33px
      14px
      11px;
  }

  .blog-detail-page .nexus-prevnext-title {
    font-size:
      0.84rem;
  }

}

</style>


<div
  class="nexus-prevnext-divider"
  aria-hidden="true"
></div>


<nav
  class="nexus-prevnext-nav"
  aria-label="Previous and next articles"
>

  {
    previousBlogPost ? (

      <a
        class="nexus-prevnext-card is-prev"
        href={`/blog/${previousBlogPost.id}/`}
      >

        <div class="nexus-prevnext-label">
          <span class="nexus-prevnext-arrow">&lt;</span>
          <span>Previous</span>
        </div>

        <div class="nexus-prevnext-title">
          {previousBlogPost.data.title}
        </div>

      </a>

    ) : (

      <span
        class="nexus-prevnext-card is-prev"
        aria-hidden="true"
        style="visibility:hidden; pointer-events:none;"
      ></span>

    )
  }


  {
    nextBlogPost ? (

      <a
        class="nexus-prevnext-card is-next"
        href={`/blog/${nextBlogPost.id}/`}
      >

        <div class="nexus-prevnext-label">
          <span>Next</span>
          <span class="nexus-prevnext-arrow">&gt;</span>
        </div>

        <div class="nexus-prevnext-title">
          {nextBlogPost.data.title}
        </div>

      </a>

    ) : (

      <span
        class="nexus-prevnext-card is-next"
        aria-hidden="true"
        style="visibility:hidden; pointer-events:none;"
      ></span>

    )
  }

</nav>

<!-- NEXUS PREV NEXT FINAL END -->

</article>
        {hasRelatedPosts && <RelatedPosts posts={relatedPosts} class="article-after-related" />}

<!-- NEXUS COMMENTS PREVIEW START -->
<section class="nexus-comments-preview" aria-label="Comments">
  <h2 class="nexus-comments-heading">
    <span class="nexus-comments-dot" aria-hidden="true"></span>
    <span>Comments</span>
    <span class="nexus-comments-count">(0)</span>
  </h2>
<!-- NEXUS COMMENTS CAT START -->
<div class="nexus-comments-avatar" aria-hidden="true">
  <img src="/images/about/cat-icon.gif" alt="" />
</div>
<!-- NEXUS COMMENTS CAT END -->
<!-- NEXUS COMMENT MOCK BOX START -->

<div
  class="nexus-comments-mockbox"
  data-nexus-comment-box
>
  <div
    class="nexus-comments-editor"
    contenteditable="true"
    role="textbox"
    aria-multiline="true"
    data-placeholder="What are your thoughts?"
  ></div>

  <div class="nexus-comments-toolbar">

    <div class="nexus-comments-format">

      <button
        type="button"
        class="nexus-comments-format-button"
        data-comment-command="bold"
        aria-label="Bold"
        title="Bold"
      >
        <strong>B</strong>
      </button>

      <button
        type="button"
        class="nexus-comments-format-button"
        data-comment-command="italic"
        aria-label="Italic"
        title="Italic"
      >
        <em>I</em>
      </button>

      <button
        type="button"
        class="nexus-comments-format-button"
        data-comment-link
        aria-label="Add link"
        title="Add link"
      >
        竊・      </button>

    </div>

    <div class="nexus-comments-actions">

      <button
        type="button"
        class="nexus-comments-cancel"
        data-comment-cancel
      >
        Cancel
      </button>

      <button
        type="button"
        class="nexus-comments-respond"
        data-comment-respond
        disabled
      >
        Respond
      </button>

    </div>

  </div>
</div>


<div
  class="nexus-comments-list"
  data-nexus-comments-list
  aria-live="polite"
></div>


<script is:inline>
(() => {

  const OWNER_NAME = '\u732B\u5B66';


  const initNexusComments = () => {

    document
      .querySelectorAll('[data-nexus-comment-box]')
      .forEach((box) => {

        if (box.dataset.nexusReady === 'true') {
          return;
        }

        box.dataset.nexusReady = 'true';


        const editor =
          box.querySelector('.nexus-comments-editor');

        const cancel =
          box.querySelector('[data-comment-cancel]');

        const respond =
          box.querySelector('[data-comment-respond]');

        const commandButtons =
          box.querySelectorAll('[data-comment-command]');

        const linkButton =
          box.querySelector('[data-comment-link]');

        const list =
          box.parentElement.querySelector(
            '[data-nexus-comments-list]'
          );


        /* =================================================
           BASIC EDITOR
           ================================================= */

        const hasText = () =>
          editor.innerText.trim().length > 0;


        const updateRespond = () => {

          const active = hasText();

          respond.disabled = !active;

          respond.classList.toggle(
            'is-active',
            active
          );
        };


        const expand = () => {
          box.classList.add('is-expanded');
        };


        const collapse = () => {

          box.classList.remove('is-expanded');

          editor.innerHTML = '';

          editor.blur();

          updateRespond();
        };


        /* =================================================
           SANITIZE
           B / I / LINKS ONLY
           ================================================= */

        const sanitize = (source) => {

          const template =
            document.createElement('template');

          template.innerHTML = source;


          const allowed =
            new Set([
              'B',
              'STRONG',
              'I',
              'EM',
              'A',
              'BR',
              'P',
              'DIV'
            ]);


          const clean = (node) => {

            if (node.nodeType === Node.TEXT_NODE) {

              return document.createTextNode(
                node.textContent || ''
              );
            }


            if (node.nodeType !== Node.ELEMENT_NODE) {

              return document.createDocumentFragment();
            }


            const tag =
              node.tagName.toUpperCase();


            if (!allowed.has(tag)) {

              const fragment =
                document.createDocumentFragment();

              Array
                .from(node.childNodes)
                .forEach((child) => {

                  fragment.appendChild(
                    clean(child)
                  );
                });

              return fragment;
            }


            const el =
              document.createElement(
                tag.toLowerCase()
              );


            if (tag === 'A') {

              const href =
                node.getAttribute('href') || '';

              try {

                const url =
                  new URL(
                    href,
                    window.location.origin
                  );

                if (
                  url.protocol === 'http:' ||
                  url.protocol === 'https:'
                ) {

                  el.href = url.href;
                  el.target = '_blank';
                  el.rel =
                    'noopener noreferrer';
                }

              }
              catch {}
            }


            Array
              .from(node.childNodes)
              .forEach((child) => {

                el.appendChild(
                  clean(child)
                );
              });


            return el;
          };


          const fragment =
            document.createDocumentFragment();


          Array
            .from(template.content.childNodes)
            .forEach((child) => {

              fragment.appendChild(
                clean(child)
              );
            });


          return fragment;
        };


        const setSanitizedHTML = (
          element,
          html
        ) => {

          element.replaceChildren(
            sanitize(html)
          );
        };


        /* =================================================
           AVATAR

           owner = CAT / lime
           guest = CSS anonymous / orange
           both = 34px
           ================================================= */

        const createAvatar = (type) => {

          const avatar =
            document.createElement('div');

          avatar.className =
            'nexus-comment-avatar';


          if (type === 'owner') {

            avatar.classList.add(
              'nexus-comment-avatar--owner'
            );

            const img =
              document.createElement('img');

            img.src =
              '/images/about/cat-icon.gif';

            img.alt = OWNER_NAME;

            avatar.appendChild(img);

          }
          else {

            avatar.classList.add(
              'nexus-comment-avatar--guest'
            );

            const mark =
              document.createElement('span');

            mark.className =
              'nexus-comment-avatar__mark';

            avatar.appendChild(mark);
          }


          return avatar;
        };


        /* =================================================
           COMMENTS COUNT
           top-level only
           ================================================= */

        const updateCount = () => {

          const count =
            list.querySelectorAll(
              ':scope > .nexus-comment-item'
            ).length;


          const counter =
            document.querySelector(
              '.nexus-comments-count'
            );


          if (counter) {

            counter.textContent =
              `(${count})`;
          }
        };


        /* =================================================
           LONG COMMENT / MORE
           ================================================= */

        const setupMore = (
          body,
          moreButton
        ) => {

          body.classList.remove(
            'is-collapsed'
          );

          moreButton.hidden = true;

          moreButton.textContent =
            'More';


          requestAnimationFrame(() => {

            if (body.scrollHeight <= 155) {
              return;
            }


            body.classList.add(
              'is-collapsed'
            );

            moreButton.hidden = false;
          });
        };


        /* =================================================
           EDIT
           ================================================= */

        const startEdit = (
          item,
          body,
          moreButton,
          replyButton
        ) => {

          if (
            item.querySelector(
              '.nexus-comment-edit-actions'
            )
          ) {
            return;
          }


          const original =
            body.innerHTML;


          body.classList.remove(
            'is-collapsed'
          );

          moreButton.hidden = true;

          replyButton.hidden = true;

          body.contentEditable = 'true';

          body.classList.add(
            'is-editing'
          );

          body.focus();


          const actions =
            document.createElement('div');

          actions.className =
            'nexus-comment-edit-actions';


          const cancelEdit =
            document.createElement('button');

          cancelEdit.type = 'button';

          cancelEdit.textContent =
            'Cancel';


          const save =
            document.createElement('button');

          save.type = 'button';

          save.textContent =
            'Save';

          save.className =
            'is-save';


          actions.append(
            cancelEdit,
            save
          );


          body.insertAdjacentElement(
            'afterend',
            actions
          );


          cancelEdit.addEventListener(
            'click',
            () => {

              body.innerHTML =
                original;

              body.contentEditable =
                'false';

              body.classList.remove(
                'is-editing'
              );

              actions.remove();

              replyButton.hidden =
                false;

              setupMore(
                body,
                moreButton
              );
            }
          );


          save.addEventListener(
            'click',
            () => {

              if (
                body.innerText.trim()
                  .length === 0
              ) {
                return;
              }


              const edited =
                body.innerHTML;


              body.replaceChildren();

              body.appendChild(
                sanitize(edited)
              );


              body.contentEditable =
                'false';

              body.classList.remove(
                'is-editing'
              );

              actions.remove();

              replyButton.hidden =
                false;


              setupMore(
                body,
                moreButton
              );
            }
          );
        };


        /* =================================================
           REPLY COMPOSER
           current user = OWNER
           ================================================= */

        const openReplyComposer = (
          item,
          repliesContainer
        ) => {

          const existing =
            item.querySelector(
              ':scope > .nexus-comment-item__content > .nexus-reply-composer'
            );


          if (existing) {

            existing.remove();

            return;
          }


          const composer =
            document.createElement('div');

          composer.className =
            'nexus-reply-composer';


          const replyEditor =
            document.createElement('div');

          replyEditor.className =
            'nexus-reply-editor';

          replyEditor.contentEditable =
            'true';

          replyEditor.setAttribute(
            'role',
            'textbox'
          );

          replyEditor.setAttribute(
            'data-placeholder',
            'Write a reply...'
          );


          const replyActions =
            document.createElement('div');

          replyActions.className =
            'nexus-reply-actions';


          const replyCancel =
            document.createElement('button');

          replyCancel.type = 'button';

          replyCancel.textContent =
            'Cancel';


          const replySubmit =
            document.createElement('button');

          replySubmit.type = 'button';

          replySubmit.textContent =
            'Reply';

          replySubmit.disabled = true;

          replySubmit.className =
            'nexus-reply-submit';


          replyActions.append(
            replyCancel,
            replySubmit
          );


          composer.append(
            replyEditor,
            replyActions
          );


          const content =
            item.querySelector(
              ':scope > .nexus-comment-item__content'
            );


          const replies =
            content.querySelector(
              ':scope > .nexus-comment-replies'
            );


          content.insertBefore(
            composer,
            replies
          );


          replyEditor.focus();


          replyEditor.addEventListener(
            'input',
            () => {

              const active =
                replyEditor.innerText
                  .trim()
                  .length > 0;

              replySubmit.disabled =
                !active;

              replySubmit.classList.toggle(
                'is-active',
                active
              );
            }
          );


          replyCancel.addEventListener(
            'click',
            () => {

              composer.remove();
            }
          );


          replySubmit.addEventListener(
            'click',
            () => {

              if (
                replyEditor.innerText
                  .trim()
                  .length === 0
              ) {
                return;
              }


              appendComment(
                replyEditor.innerHTML,
                'owner',
                repliesContainer,
                true
              );


              composer.remove();
            }
          );
        };


        /* =================================================
           CREATE COMMENT
           ================================================= */

        const appendComment = (
          html,
          type = 'owner',
          targetList = list,
          isReply = false
        ) => {

          const item =
            document.createElement(
              'article'
            );

          item.className =
            'nexus-comment-item';


          if (isReply) {

            item.classList.add(
              'is-reply'
            );
          }


          const avatar =
            createAvatar(type);


          const content =
            document.createElement('div');

          content.className =
            'nexus-comment-item__content';


          /* ---------- HEADER ---------- */

          const header =
            document.createElement('div');

          header.className =
            'nexus-comment-item__header';


          const meta =
            document.createElement('div');

          meta.className =
            'nexus-comment-item__meta';


          const name =
            document.createElement('span');

          name.className =
            'nexus-comment-item__name';

          name.textContent =
            type === 'owner'
              ? OWNER_NAME
              : 'Guest';


          meta.appendChild(name);


          if (type === 'owner') {

            const badge =
              document.createElement('span');

            badge.className =
              'nexus-comment-item__author';

            badge.textContent =
              'Author';

            meta.appendChild(badge);
          }


          const time =
            document.createElement('span');

          time.className =
            'nexus-comment-item__time';

          time.textContent =
            'Just now';

          meta.appendChild(time);


          header.appendChild(meta);


          /* ---------- OWNER MENU ---------- */

          let menuPanel = null;


          if (type === 'owner') {

            const menu =
              document.createElement('div');

            menu.className =
              'nexus-comment-menu';


            const menuButton =
              document.createElement('button');

            menuButton.type = 'button';

            menuButton.className =
              'nexus-comment-menu__trigger';

            menuButton.textContent =
              '\u2026';

            menuButton.setAttribute(
              'aria-label',
              'Comment options'
            );


            menuPanel =
              document.createElement('div');

            menuPanel.className =
              'nexus-comment-menu__panel';

            menuPanel.hidden = true;


            const edit =
              document.createElement('button');

            edit.type = 'button';

            edit.textContent =
              'Edit response';


            const remove =
              document.createElement('button');

            remove.type = 'button';

            remove.textContent =
              'Delete response';

            remove.className =
              'is-delete';


            menuPanel.append(
              edit,
              remove
            );

            menu.append(
              menuButton,
              menuPanel
            );

            header.appendChild(menu);


            menuButton.addEventListener(
              'click',
              (event) => {

                event.stopPropagation();

                document
                  .querySelectorAll(
                    '.nexus-comment-menu__panel'
                  )
                  .forEach((panel) => {

                    if (
                      panel !== menuPanel
                    ) {
                      panel.hidden = true;
                    }
                  });


                menuPanel.hidden =
                  !menuPanel.hidden;
              }
            );


            edit.addEventListener(
              'click',
              () => {

                menuPanel.hidden = true;

                startEdit(
                  item,
                  body,
                  more,
                  replyButton
                );
              }
            );


            remove.addEventListener(
              'click',
              () => {

                menuPanel.hidden = true;


                const confirmed =
                  window.confirm(
                    'Delete this response?'
                  );


                if (!confirmed) {
                  return;
                }


                item.remove();

                updateCount();
              }
            );
          }


          /* ---------- BODY ---------- */

          const body =
            document.createElement('div');

          body.className =
            'nexus-comment-item__body';


          setSanitizedHTML(
            body,
            html
          );


          const more =
            document.createElement('button');

          more.type = 'button';

          more.className =
            'nexus-comment-more';

          more.textContent =
            'More';

          more.hidden = true;


          more.addEventListener(
            'click',
            () => {

              const collapsed =
                body.classList.toggle(
                  'is-collapsed'
                );

              more.textContent =
                collapsed
                  ? 'More'
                  : 'Less';
            }
          );


          /* ---------- FOOTER ---------- */

          const footer =
            document.createElement('div');

          footer.className =
            'nexus-comment-item__footer';


          const replyButton =
            document.createElement('button');

          replyButton.type = 'button';

          replyButton.className =
            'nexus-comment-reply-button';

          replyButton.textContent =
            'Reply';


          footer.appendChild(
            replyButton
          );


          /* ---------- REPLIES ---------- */

          const repliesContainer =
            document.createElement('div');

          repliesContainer.className =
            'nexus-comment-replies';


          replyButton.addEventListener(
            'click',
            () => {

              openReplyComposer(
                item,
                repliesContainer
              );
            }
          );


          content.append(
            header,
            body,
            more,
            footer,
            repliesContainer
          );


          item.append(
            avatar,
            content
          );


          targetList.appendChild(item);


          setupMore(
            body,
            more
          );


          updateCount();
        };


        /* =================================================
           ROOT EDITOR EVENTS
           ================================================= */

        box.addEventListener(
          'click',
          (event) => {

            if (
              event.target.closest('button')
            ) {
              return;
            }

            expand();

            editor.focus();
          }
        );


        editor.addEventListener(
          'focus',
          expand
        );


        editor.addEventListener(
          'input',
          updateRespond
        );


        commandButtons.forEach(
          (button) => {

            button.addEventListener(
              'mousedown',
              (event) => {

                event.preventDefault();

                editor.focus();

                document.execCommand(
                  button.dataset.commentCommand,
                  false,
                  null
                );

                updateRespond();
              }
            );
          }
        );


        linkButton.addEventListener(
          'mousedown',
          (event) => {

            event.preventDefault();


            const selection =
              window.getSelection();


            if (
              !selection ||
              selection.rangeCount === 0 ||
              selection.isCollapsed
            ) {
              return;
            }


            const href =
              window.prompt('Link URL');


            if (!href) {
              return;
            }


            editor.focus();


            document.execCommand(
              'createLink',
              false,
              href
            );


            updateRespond();
          }
        );


        cancel.addEventListener(
          'click',
          (event) => {

            event.stopPropagation();

            collapse();
          }
        );


        respond.addEventListener(
          'click',
          (event) => {

            event.stopPropagation();


            if (!hasText()) {
              return;
            }


            /*
             * CURRENT LOCAL AUTHOR COMPOSER
             *
             * 縺薙％縺九ｉ謚慕ｨｿ縺励◆繧ｳ繝｡繝ｳ繝医・
             * 迪ｫ蟄ｦ / Author 縺ｨ縺励※陦ｨ遉ｺ縲・             */
            appendComment(
              editor.innerHTML,
              'owner',
              list,
              false
            );

            /* NEXUS DIRECT COMMENT MAIL START */
            const nexusCommentText =
              editor.innerText.trim();

            fetch(
              'https://nexus-contact.catlogy110.workers.dev/blog-comment',
              {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  name: 'NEXUS Visitor',
                  comment: nexusCommentText,
                  articleTitle:
                    document.title || 'NEXUS',
                  articleUrl:
                    window.location.href,
                  pageType: 'blog'
                })
              }
            ).catch((error) => {
              console.error(
                'NEXUS comment mail failed:',
                error
              );
            });
            /* NEXUS DIRECT COMMENT MAIL END */


            collapse();
          }
        );


        /* menu outside click */

        document.addEventListener(
          'click',
          (event) => {

            if (
              event.target.closest(
                '.nexus-comment-menu'
              )
            ) {
              return;
            }


            document
              .querySelectorAll(
                '.nexus-comment-menu__panel'
              )
              .forEach((panel) => {

                panel.hidden = true;
              });
          }
        );


        updateRespond();
        updateCount();

      });
  };


  initNexusComments();


  document.addEventListener(
    'astro:page-load',
    initNexusComments
  );

})();
</script>

<!-- NEXUS COMMENT MOCK BOX END -->
