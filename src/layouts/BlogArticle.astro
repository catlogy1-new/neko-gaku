<!-- NEXUS COMMENT TOOL ICONS V2 START -->

<style is:global>
  [data-nexus-comment-box] button[data-nexus-format-icon] {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 28px !important;
    height: 28px !important;

    padding: 0 !important;

    color: #a8aaa8 !important;

    line-height: 1 !important;
  }

  [data-nexus-comment-box] button[data-nexus-format-icon="bold"]
    .nexus-comment-tool-glyph {
    font-family: Georgia, "Times New Roman", serif !important;
    font-size: 20px !important;
    font-weight: 700 !important;
    font-style: normal !important;
    line-height: 1 !important;
  }

  [data-nexus-comment-box] button[data-nexus-format-icon="italic"]
    .nexus-comment-tool-glyph {
    font-family: Georgia, "Times New Roman", serif !important;
    font-size: 21px !important;
    font-weight: 400 !important;
    font-style: italic !important;
    line-height: 1 !important;
  }

  [data-nexus-comment-box] button[data-nexus-format-icon="link"] svg {
    width: 18px !important;
    height: 18px !important;

    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 2 !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
  }
</style>

<script is:inline>
(() => {
  const applyCommentToolIcons = () => {
    document
      .querySelectorAll('[data-nexus-comment-box]')
      .forEach((root) => {

        root
          .querySelectorAll('button')
          .forEach((button) => {

            const command =
              (button.dataset.commentCommand || '')
                .toLowerCase();

            const label =
              (
                button.getAttribute('aria-label') ||
                button.getAttribute('title') ||
                ''
              ).toLowerCase();

            const text =
              (button.textContent || '').trim();

            let type = '';

            if (
              command === 'bold' ||
              label.includes('bold') ||
              text === 'B'
            ) {
              type = 'bold';
            }
            else if (
              command === 'italic' ||
              label.includes('italic') ||
              text === '/'
            ) {
              type = 'italic';
            }
            else if (
              button.hasAttribute('data-comment-link') ||
              label.includes('link') ||
              text === '↗'
            ) {
              type = 'link';
            }

            if (!type) {
              return;
            }

            button.dataset.nexusFormatIcon = type;

            if (type === 'bold') {
              button.innerHTML =
                '<span class="nexus-comment-tool-glyph" aria-hidden="true">B</span>';

              button.setAttribute(
                'aria-label',
                'Bold'
              );

              button.setAttribute(
                'title',
                'Bold'
              );
            }

            if (type === 'italic') {
              button.innerHTML =
                '<span class="nexus-comment-tool-glyph" aria-hidden="true">i</span>';

              button.setAttribute(
                'aria-label',
                'Italic'
              );

              button.setAttribute(
                'title',
                'Italic'
              );
            }

            if (type === 'link') {
              button.innerHTML = `
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                  ></path>
                  <path
                    d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                  ></path>
                </svg>
              `;

              button.setAttribute(
                'aria-label',
                'Insert link'
              );

              button.setAttribute(
                'title',
                'Insert link'
              );
            }
          });
      });
  };

  const scheduleCommentToolIcons = () => {
    applyCommentToolIcons();

    requestAnimationFrame(
      applyCommentToolIcons
    );

    window.setTimeout(
      applyCommentToolIcons,
      100
    );
  };

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      scheduleCommentToolIcons,
      { once: true }
    );
  }
  else {
    scheduleCommentToolIcons();
  }

  document.addEventListener(
    'astro:page-load',
    scheduleCommentToolIcons
  );
})();
</script>

