<script is:inline>
(() => {

  const initEndTagAlignment = () => {

    const article =
      document.querySelector('.article-card');

    if (!article) return;


    /*
     * 險倅ｺ区忰蟆ｾ縺ｮ View More / View Less 繧呈爾縺吶・     */
    const toggle =
      [...article.querySelectorAll('button, a')]
      .find((el) => {

        const label =
          (el.textContent || '')
            .replace(/\s+/g, ' ')
            .trim()
            .toLowerCase();

        return (
          label === 'view more' ||
          label === 'view less'
        );

      });

    if (!toggle) return;


    /*
     * toggle 縺九ｉ隕ｪ縺ｸ荳翫′繧翫・     * 螳滄圀縺ｮ繧ｿ繧ｰ繝ｪ繝ｳ繧ｯ繧定､・焚謖√▽譛蟆剰ｦ∫ｴ繧呈治逕ｨ縲・     */
    let node = toggle.parentElement;
    let tagRegion = null;

    while (
      node &&
      node !== article
    ) {

      const tagCount =
        node.querySelectorAll(
          'a[href*="/tags/"]'
        ).length;

      if (tagCount >= 2) {
        tagRegion = node;
        break;
      }

      node = node.parentElement;
    }


    if (!tagRegion) return;


    tagRegion.classList.add(
      'nexus-end-tags-aligned'
    );

  };


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initEndTagAlignment,
      { once: true }
    );

  } else {

    initEndTagAlignment();

  }


  document.addEventListener(
    'astro:page-load',
    initEndTagAlignment
  );

})();
</script>

<!-- NEXUS END TAG ALIGN END -->

