  <!-- NEXUS TAG COLLAPSE V2 START -->
  <script is:inline>
    (() => {
      const initNexusTagCollapse = () => {
        document.querySelectorAll('.article-card').forEach((card) => {
          const tags = Array.from(card.querySelectorAll('.nexus-tag'));
          const actions = card.querySelector('.nexus-article-actions');

          /*
           * 譌ｧ繧ｿ繧ｰUI縺ｮ譌･譛ｬ隱槭ヨ繧ｰ繝ｫ繧貞炎髯､縲・           * 迴ｾ蝨ｨ縺ｯ View More / View Less 縺ｮ縺ｿ菴ｿ逕ｨ縺吶ｋ縲・           */
          card
            .querySelectorAll('button, a, [role="button"]')
            .forEach((element) => {
              const label =
                element.textContent
                  ?.replace(/\s+/g, ' ')
                  .trim();

              if (
                label === '縺吶∋縺ｦ縺ｮ繧ｿ繧ｰ繧定｡ｨ遉ｺ' ||
                label === '蜈ｨ縺ｦ縺ｮ繧ｿ繧ｰ繧定｡ｨ遉ｺ'
              ) {
                element.remove();
              }
            });

          card.classList.remove('nexus-has-tags', 'nexus-no-tags');

          const oldToggle = card.querySelector('[data-nexus-tag-toggle]');
          if (oldToggle) oldToggle.remove();

          if (!tags.length) {
            card.classList.add('nexus-no-tags');
            return;
          }

          card.classList.add('nexus-has-tags');

          const tagRow = tags[0].parentElement;
          if (!tagRow) return;

          tagRow.setAttribute('data-nexus-tags', '');
          tagRow.classList.remove('is-collapsed', 'is-expanded');
          tagRow.style.removeProperty('--nexus-tags-collapsed-height');

          /*
           * 荳蠎ｦ閾ｪ辟ｶ縺ｪ蜈ｨ鬮倥↓謌ｻ縺励※縺九ｉ縲・           * 螳滄圀縺ｮ繧ｿ繧ｰ菴咲ｽｮ繧呈ｸｬ螳壹☆繧九・           *
           * 繧ｿ繧ｰ謨ｰ縺ｧ縺ｯ縺ｪ縺上悟ｮ滄圀縺ｫ菴戊｡後≠繧九°縲阪〒蛻､螳壹・           */
          const rowRect = tagRow.getBoundingClientRect();

          const measured = tags.map((tag) => {
            const rect = tag.getBoundingClientRect();

            return {
              element: tag,
              top: rect.top - rowRect.top,
              bottom: rect.bottom - rowRect.top
            };
          });

          const rowTops = [];

          measured.forEach((item) => {
            const exists = rowTops.some(
              (top) => Math.abs(top - item.top) < 3
            );

            if (!exists) {
              rowTops.push(item.top);
            }
          });

          rowTops.sort((a, b) => a - b);

          /* 1縲・陦後↑繧鰻iew More荳崎ｦ・*/
          if (rowTops.length <= 2) {
            return;
          }

          const secondRowTop = rowTops[1];

          const secondRowBottom = Math.max(
            ...measured
              .filter(
                (item) =>
                  item.top <= secondRowTop + 3
              )
              .map((item) => item.bottom)
          );

          tagRow.style.setProperty(
            '--nexus-tags-collapsed-height',
            `${Math.ceil(secondRowBottom)}px`
          );

          tagRow.classList.add('is-collapsed');

          const button = document.createElement('button');

          button.type = 'button';
          button.className = 'nexus-tag-toggle';
          button.dataset.nexusTagToggle = '';
          button.textContent = 'View More';
          button.setAttribute('aria-expanded', 'false');

          tagRow.insertAdjacentElement(
            'afterend',
            button
          );

          button.addEventListener('click', () => {
            const expanded =
              tagRow.classList.contains('is-expanded');

            if (expanded) {
              tagRow.classList.remove('is-expanded');
              tagRow.classList.add('is-collapsed');

              button.textContent = 'View More';
              button.setAttribute(
                'aria-expanded',
                'false'
              );
            } else {
              tagRow.classList.remove('is-collapsed');
              tagRow.classList.add('is-expanded');

              button.textContent = 'View Less';
              button.setAttribute(
                'aria-expanded',
                'true'
              );
            }
          });
        });
      };

      const scheduleInit = () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(
            initNexusTagCollapse
          );
        });
      };

      scheduleInit();

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(scheduleInit);
      }

      if (!document.documentElement.dataset.nexusTagCollapseBound) {
        document.documentElement.dataset.nexusTagCollapseBound = 'true';

        document.addEventListener(
          'astro:page-load',
          scheduleInit
        );

        let resizeTimer;

        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);

          resizeTimer = setTimeout(
            scheduleInit,
            120
          );
        });
      }
    })();
  </script>
